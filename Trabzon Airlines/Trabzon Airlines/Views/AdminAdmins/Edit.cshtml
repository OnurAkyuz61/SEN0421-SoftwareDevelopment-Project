@* Model tanımı - Admin modeli *@
@* Model definition - Admin model *@
@model Trabzon_Airlines.Models.Admin

@* Sayfa başlığı - ViewBag.Title ayarı *@
@* Page title - ViewBag.Title setting *@
@{
    // Admin düzenleme sayfası - Mevcut admin bilgilerini düzenler
    // Admin edit page - Edits existing admin information
    ViewBag.Title = "Admin Düzenle";
    ViewBag.TitleEn = "Edit Admin";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

@* Admin Formu CSS *@
@* Admin Form CSS *@
@section styles {
    @* Uçuş formu CSS dosyası - Form grid ve genel form stilleri için *@
    @* Flight form CSS file - For form grid and general form styles *@
    <link rel="stylesheet" href="~/Content/css/admin-flight-form.css?v=@DateTime.Now.Ticks">
    @* Ayarlar CSS dosyası - Form section ve detaylı form stilleri için *@
    @* Settings CSS file - For form section and detailed form styles *@
    <link rel="stylesheet" href="~/Content/css/admin-settings.css?v=@DateTime.Now.Ticks">
}

@* Sayfa Başlığı *@
@* Page Header *@
<div class="admin-page-header">
    <div class="page-header-content">
        <h1 class="page-title">
            <i class="fa-solid fa-user-edit"></i>
            <span data-tr="Admin Düzenle" data-en="Edit Admin">Admin Düzenle</span>
        </h1>
        <a href="@Url.Action("Index", "AdminAdmins")" class="btn-secondary-action">
            <i class="fa-solid fa-arrow-left"></i>
            <span data-tr="Listeye Dön" data-en="Back to List">Listeye Dön</span>
        </a>
    </div>
</div>

@* Hata Mesajları *@
@* Error Messages *@
@if (TempData["AdminErrorKey"] != null)
{
    <div class="alert alert-error">
        <i class="fa-solid fa-circle-exclamation"></i>
        <span>
            @if (TempData["AdminError_tr"] != null)
            {
                @TempData["AdminError_tr"]
            }
            else if (TempData["AdminError_en"] != null)
            {
                @TempData["AdminError_en"]
            }
        </span>
    </div>
}

@* Admin Düzenleme Formu *@
@* Admin Edit Form *@
<div class="admin-card">
    <div class="admin-card-header">
        <h2 class="admin-card-title">
            <i class="fa-solid fa-user-shield"></i>
            <span data-tr="Admin Bilgileri" data-en="Admin Information">Admin Bilgileri</span>
        </h2>
    </div>
    <div class="admin-card-body">
        @using (Html.BeginForm("Edit", "AdminAdmins", FormMethod.Post, new { @class = "admin-form" }))
        {
            @Html.AntiForgeryToken() @* CSRF koruması *@
            @Html.HiddenFor(m => m.AdminId) @* Admin ID'sini gizli alan olarak gönder *@
            
            @* Hata Mesajları *@
            @* Error Messages *@
            @Html.ValidationSummary(true, "", new { @class = "alert alert-error" })

            @* Form Grid *@
            @* Form Grid *@
            <div class="form-grid">
                @* Ad Soyad Alanı *@
                @* Full Name Field *@
                <div class="form-group">
                    @* Form etiketi *@
                    @* Form label *@
                    <label for="FullName" class="form-label">
                        @* Kullanıcı ikonu *@
                        @* User icon *@
                        <i class="fa-solid fa-user"></i>
                        @* Etiket metni - Çeviri desteği ile *@
                        @* Label text - With translation support *@
                        <span data-tr="Ad Soyad *" data-en="Full Name *">Ad Soyad *</span>
                    </label>
                    @* Ad Soyad input alanı *@
                    @* Full Name input field *@
                    @Html.TextBoxFor(m => m.FullName, new { @class = "form-control", placeholder = "Örn: Ahmet Yılmaz", required = "required" })
                    @* Validasyon mesajı *@
                    @* Validation message *@
                    @Html.ValidationMessageFor(m => m.FullName, "", new { @class = "validation-error" })
                </div>

                @* E-posta Alanı *@
                @* Email Field *@
                <div class="form-group">
                    @* Form etiketi *@
                    @* Form label *@
                    <label for="Email" class="form-label">
                        @* E-posta ikonu *@
                        @* Email icon *@
                        <i class="fa-solid fa-envelope"></i>
                        @* Etiket metni - Çeviri desteği ile *@
                        @* Label text - With translation support *@
                        <span data-tr="E-posta *" data-en="Email *">E-posta *</span>
                    </label>
                    @* E-posta input alanı *@
                    @* Email input field *@
                    @Html.TextBoxFor(m => m.Email, new { @class = "form-control", type = "email", placeholder = "Örn: admin@trabzonairlines.com", required = "required" })
                    @* Validasyon mesajı *@
                    @* Validation message *@
                    @Html.ValidationMessageFor(m => m.Email, "", new { @class = "validation-error" })
                </div>

                @* Şifre Değiştirme Bölümü *@
                @* Password Change Section *@
                @* Form grubu - Tüm sütunları kapla *@
                @* Form group - Span all columns *@
                <div class="form-group" style="grid-column: 1 / -1;">
                    @* Form bölümü - Şifre değiştirme açıklaması *@
                    @* Form section - Password change description *@
                    <div class="form-section">
                        @* Bölüm başlığı - Çeviri desteği ile *@
                        @* Section title - With translation support *@
                        <h3 class="form-section-title" data-tr="Şifre Değiştir (Opsiyonel)" data-en="Change Password (Optional)">Şifre Değiştir (Opsiyonel)</h3>
                        @* Bölüm açıklaması - Çeviri desteği ile *@
                        @* Section description - With translation support *@
                        <p class="form-section-description" data-tr="Şifreyi değiştirmek istemiyorsanız bu alanı boş bırakın." data-en="Leave this field empty if you don't want to change the password.">Şifreyi değiştirmek istemiyorsanız bu alanı boş bırakın.</p>
                    </div>
                </div>

                @* Yeni Şifre Alanı *@
                @* New Password Field *@
                <div class="form-group">
                    @* Form etiketi *@
                    @* Form label *@
                    <label for="password" class="form-label">
                        @* Şifre ikonu *@
                        @* Password icon *@
                        <i class="fa-solid fa-key"></i>
                        @* Etiket metni - Çeviri desteği ile *@
                        @* Label text - With translation support *@
                        <span data-tr="Yeni Şifre" data-en="New Password">Yeni Şifre</span>
                    </label>
                    @* Şifre input alanı *@
                    @* Password input field *@
                    <input type="password" id="password" name="password" class="form-control" placeholder="En az 6 karakter" minlength="6">
                    @* Yardımcı metin - Çeviri desteği ile *@
                    @* Helper text - With translation support *@
                    <small class="form-text" data-tr="Şifre en az 6 karakter olmalıdır." data-en="Password must be at least 6 characters.">Şifre en az 6 karakter olmalıdır.</small>
                </div>
            </div>

            @* Form Butonları *@
            @* Form Buttons *@
            <div class="form-actions">
                <button type="submit" class="btn-primary-action">
                    <i class="fa-solid fa-save"></i>
                    <span data-tr="Kaydet" data-en="Save">Kaydet</span>
                </button>
                <a href="@Url.Action("Index", "AdminAdmins")" class="btn-secondary-action">
                    <i class="fa-solid fa-times"></i>
                    <span data-tr="İptal" data-en="Cancel">İptal</span>
                </a>
            </div>
        }
    </div>
</div>

@* Admin Formu JavaScript *@
@* Admin Form JavaScript *@
@section scripts {
    @* Form validasyonu JavaScript kodu *@
    @* Form validation JavaScript code *@
    <script>
        @* Sayfa yüklendiğinde çalışacak fonksiyon *@
        @* Function to run when page loads *@
        $(document).ready(function () {
            @* Form submit olayı *@
            @* Form submit event *@
            $('form').on('submit', function (e) {
                @* Şifre alanı değerini al *@
                @* Get password field value *@
                var password = $('#password').val();
                @* Şifre girilmişse ve 6 karakterden azsa *@
                @* If password is entered and less than 6 characters *@
                if (password && password.length < 6) {
                    @* Form gönderimini engelle *@
                    @* Prevent form submission *@
                    e.preventDefault();
                    @* Hata mesajı göster *@
                    @* Show error message *@
                    alert('Şifre en az 6 karakter olmalıdır!');
                    @* False döndür *@
                    @* Return false *@
                    return false;
                }
            });
        });
    </script>
}

