@{
    // Admin giriş sayfası
    // Admin login page
    ViewBag.Title = "Admin Girişi";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section styles {
    <!-- Admin giriş sayfası CSS -->
    <!-- Admin login page CSS -->
    <link rel="stylesheet" href="~/Content/css/admin.css">
}

<!-- ADMIN GİRİŞ BÖLÜMÜ -->
<!-- ADMIN LOGIN SECTION -->
<section class="admin-login-section">
    <div class="admin-login-container">
        <div class="admin-login-card">
            <!-- Logo ve başlık -->
            <!-- Logo and title -->
            <div class="admin-login-header">
                <i class="fa-solid fa-shield-halved"></i>
                <h1>Admin Paneli</h1>
                <p>Yönetici girişi yapın</p>
            </div>

            <!-- Hata mesajı -->
            <!-- Error message -->
            @if (ViewBag.Error != null)
            {
                <div class="alert alert-danger">
                    <i class="fa-solid fa-exclamation-circle"></i>
                    @ViewBag.Error
                </div>
            }

            <!-- Giriş formu -->
            <!-- Login form -->
            @using (Html.BeginForm("Login", "Admin", FormMethod.Post, new { @class = "admin-login-form" }))
            {
                @Html.AntiForgeryToken()

                <!-- Kullanıcı adı -->
                <!-- Username -->
                <div class="form-group">
                    <label for="username">
                        <i class="fa-solid fa-user"></i> Kullanıcı Adı
                    </label>
                    <input type="text" id="username" name="username" class="form-control" required autofocus placeholder="Kullanıcı adınızı girin">
                </div>

                <!-- Şifre -->
                <!-- Password -->
                <div class="form-group">
                    <label for="password">
                        <i class="fa-solid fa-lock"></i> Şifre
                    </label>
                    <div class="password-input-wrapper">
                        <input type="password" id="password" name="password" class="form-control" required placeholder="Şifrenizi girin">
                        <button type="button" class="password-toggle-btn" onclick="togglePassword('password')">
                            <i class="fa-solid fa-eye"></i>
                        </button>
                    </div>
                </div>

                <!-- Giriş butonu -->
                <!-- Login button -->
                <button type="submit" class="admin-login-btn">
                    <i class="fa-solid fa-sign-in-alt"></i>
                    Giriş Yap
                </button>
            }

            <!-- Ana sayfaya dön -->
            <!-- Back to homepage -->
            <div class="admin-login-footer">
                <a href="@Url.Action("Index", "Home")">
                    <i class="fa-solid fa-arrow-left"></i> Ana Sayfaya Dön
                </a>
            </div>
        </div>
    </div>
</section>

@section scripts {
    <script>
        // Şifre görünürlüğünü değiştir
        // Toggle password visibility
        function togglePassword(inputId) {
            const input = document.getElementById(inputId);
            const icon = input.nextElementSibling.querySelector('i');
            if (input.type === 'password') {
                input.type = 'text';
                icon.classList.remove('fa-eye');
                icon.classList.add('fa-eye-slash');
            } else {
                input.type = 'password';
                icon.classList.remove('fa-eye-slash');
                icon.classList.add('fa-eye');
            }
        }
    </script>
}

