@model Trabzon_Airlines.Models.Package

@{
    // Yeni paket ekleme sayfası
    // Add new package page
    ViewBag.Title = "Yeni Paket Ekle";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section styles {
    <link rel="stylesheet" href="~/Content/css/admin.css">
}

<section class="admin-dashboard">
    <div class="admin-dashboard-header">
        <h1><i class="fa-solid fa-plus-circle"></i> Yeni Paket Ekle</h1>
        <p>Yeni bir seyahat paketi oluşturun</p>
    </div>

    <div class="admin-table-container">
        @using (Html.BeginForm("AddPackage", "Admin", FormMethod.Post, new { @class = "admin-form" }))
        {
            @Html.AntiForgeryToken()

            <div class="form-group">
                @Html.LabelFor(m => m.Title, new { @class = "form-label" })
                @Html.TextBoxFor(m => m.Title, new { @class = "form-control", required = "required", placeholder = "Paket adı" })
                @Html.ValidationMessageFor(m => m.Title, "", new { @class = "text-danger" })
            </div>

            <div class="form-group">
                @Html.LabelFor(m => m.Description, new { @class = "form-label" })
                @Html.TextAreaFor(m => m.Description, new { @class = "form-control", rows = "5", required = "required", placeholder = "Paket açıklaması" })
                @Html.ValidationMessageFor(m => m.Description, "", new { @class = "text-danger" })
            </div>

            <div class="form-group">
                @Html.LabelFor(m => m.ShortDescription, new { @class = "form-label" })
                @Html.TextBoxFor(m => m.ShortDescription, new { @class = "form-control", placeholder = "Kısa açıklama (liste görünümü için)" })
            </div>

            <div class="form-row">
                <div class="form-group">
                    @Html.LabelFor(m => m.Price, new { @class = "form-label" })
                    @Html.TextBoxFor(m => m.Price, new { @class = "form-control", type = "number", step = "0.01", required = "required", placeholder = "0.00" })
                    @Html.ValidationMessageFor(m => m.Price, "", new { @class = "text-danger" })
                </div>

                <div class="form-group">
                    @Html.LabelFor(m => m.OldPrice, new { @class = "form-label" })
                    @Html.TextBoxFor(m => m.OldPrice, new { @class = "form-control", type = "number", step = "0.01", placeholder = "Eski fiyat (opsiyonel)" })
                </div>
            </div>

            <div class="form-row">
                <div class="form-group">
                    @Html.LabelFor(m => m.Category, new { @class = "form-label" })
                    @Html.DropDownListFor(m => m.Category, new SelectList(new[] {
                        new SelectListItem { Text = "Yurt İçi", Value = "domestic" },
                        new SelectListItem { Text = "Yurt Dışı", Value = "international" }
                    }, "Value", "Text"), "Kategori Seçiniz", new { @class = "form-control", required = "required" })
                    @Html.ValidationMessageFor(m => m.Category, "", new { @class = "text-danger" })
                </div>

                <div class="form-group">
                    @Html.LabelFor(m => m.SubCategory, new { @class = "form-label" })
                    @Html.DropDownListFor(m => m.SubCategory, new SelectList(new[] {
                        new SelectListItem { Text = "Plaj", Value = "beach" },
                        new SelectListItem { Text = "Şehir", Value = "city" },
                        new SelectListItem { Text = "Macera", Value = "adventure" }
                    }, "Value", "Text"), "Alt Kategori (Opsiyonel)", new { @class = "form-control" })
                </div>
            </div>

            <div class="form-row">
                <div class="form-group">
                    @Html.LabelFor(m => m.Duration, new { @class = "form-label" })
                    @Html.TextBoxFor(m => m.Duration, new { @class = "form-control", type = "number", required = "required", placeholder = "Gün sayısı" })
                    @Html.ValidationMessageFor(m => m.Duration, "", new { @class = "text-danger" })
                </div>

                <div class="form-group">
                    @Html.LabelFor(m => m.Nights, new { @class = "form-label" })
                    @Html.TextBoxFor(m => m.Nights, new { @class = "form-control", type = "number", required = "required", placeholder = "Gece sayısı" })
                    @Html.ValidationMessageFor(m => m.Nights, "", new { @class = "text-danger" })
                </div>
            </div>

            <div class="form-row">
                <div class="form-group">
                    @Html.LabelFor(m => m.Rating, new { @class = "form-label" })
                    @Html.TextBoxFor(m => m.Rating, new { @class = "form-control", type = "number", step = "0.1", min = "0", max = "5", value = "0", placeholder = "0.0 - 5.0" })
                </div>

                <div class="form-group">
                    @Html.LabelFor(m => m.HotelStars, new { @class = "form-label" })
                    @Html.TextBoxFor(m => m.HotelStars, new { @class = "form-control", type = "number", min = "1", max = "5", placeholder = "1-5" })
                </div>
            </div>

            <div class="form-group">
                @Html.LabelFor(m => m.ImageUrl, new { @class = "form-label" })
                @Html.TextBoxFor(m => m.ImageUrl, new { @class = "form-control", type = "url", placeholder = "https://example.com/image.jpg" })
            </div>

            <div class="form-group">
                @Html.LabelFor(m => m.Badge, new { @class = "form-label" })
                @Html.DropDownListFor(m => m.Badge, new SelectList(new[] {
                    new SelectListItem { Text = "Yok", Value = "" },
                    new SelectListItem { Text = "Popüler", Value = "Popüler" },
                    new SelectListItem { Text = "Yeni", Value = "Yeni" },
                    new SelectListItem { Text = "Özel", Value = "Özel" },
                    new SelectListItem { Text = "%25 İndirim", Value = "%25 İndirim" },
                    new SelectListItem { Text = "%30 İndirim", Value = "%30 İndirim" }
                }, "Value", "Text"), new { @class = "form-control" })
            </div>

            <div class="form-group">
                @Html.LabelFor(m => m.MealType, new { @class = "form-label" })
                @Html.DropDownListFor(m => m.MealType, new SelectList(new[] {
                    new SelectListItem { Text = "Yok", Value = "" },
                    new SelectListItem { Text = "Kahvaltı Dahil", Value = "Kahvaltı Dahil" },
                    new SelectListItem { Text = "Her Şey Dahil", Value = "Her Şey Dahil" },
                    new SelectListItem { Text = "Yarım Pansiyon", Value = "Yarım Pansiyon" }
                }, "Value", "Text"), new { @class = "form-control" })
            </div>

            <div class="form-row">
                <div class="form-group checkbox-group">
                    @Html.CheckBoxFor(m => m.FlightIncluded, new { @id = "flightIncluded" })
                    <label for="flightIncluded" class="checkbox-label">Uçak Bileti Dahil</label>
                </div>

                <div class="form-group checkbox-group">
                    @Html.CheckBoxFor(m => m.IsFeatured, new { @id = "isFeatured" })
                    <label for="isFeatured" class="checkbox-label">Öne Çıkan Paket</label>
                </div>
            </div>

            <div class="admin-form-actions">
                <button type="submit" class="admin-btn">
                    <i class="fa-solid fa-save"></i> Paketi Kaydet
                </button>
                <a href="@Url.Action("Packages", "Admin")" class="admin-btn admin-btn-secondary">
                    <i class="fa-solid fa-times"></i> İptal
                </a>
            </div>
        }
    </div>
</section>

<style>
    .admin-form {
        display: flex;
        flex-direction: column;
        gap: 1.5rem;
    }

    .form-row {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 1rem;
    }

    .admin-form-actions {
        display: flex;
        gap: 1rem;
        margin-top: 1rem;
    }

    @media (max-width: 768px) {
        .form-row {
            grid-template-columns: 1fr;
        }
    }
</style>

