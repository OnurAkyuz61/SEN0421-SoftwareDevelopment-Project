@model Trabzon_Airlines.Models.Deal

@{
    // Fırsat düzenleme sayfası
    // Edit deal page
    ViewBag.Title = "Fırsat Düzenle";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section styles {
    <link rel="stylesheet" href="~/Content/css/admin.css">
}

<section class="admin-dashboard">
    <div class="admin-dashboard-header">
        <h1><i class="fa-solid fa-edit"></i> Fırsat Düzenle</h1>
        <p>@Model.Title fırsatını düzenleyin</p>
    </div>

    <div class="admin-table-container">
        @using (Html.BeginForm("EditDeal", "Admin", FormMethod.Post, new { @class = "admin-form" }))
        {
            @Html.AntiForgeryToken()
            @Html.HiddenFor(m => m.Id)

            <div class="form-group">
                @Html.LabelFor(m => m.Title, new { @class = "form-label" })
                @Html.TextBoxFor(m => m.Title, new { @class = "form-control", required = "required" })
                @Html.ValidationMessageFor(m => m.Title, "", new { @class = "text-danger" })
            </div>

            <div class="form-group">
                @Html.LabelFor(m => m.Description, new { @class = "form-label" })
                @Html.TextAreaFor(m => m.Description, new { @class = "form-control", rows = "5", required = "required" })
                @Html.ValidationMessageFor(m => m.Description, "", new { @class = "text-danger" })
            </div>

            <div class="form-group">
                @Html.LabelFor(m => m.ShortDescription, new { @class = "form-label" })
                @Html.TextBoxFor(m => m.ShortDescription, new { @class = "form-control" })
            </div>

            <div class="form-row">
                <div class="form-group">
                    @Html.LabelFor(m => m.DiscountPercentage, new { @class = "form-label" })
                    @Html.TextBoxFor(m => m.DiscountPercentage, new { @class = "form-control", type = "number", min = "1", max = "100", required = "required" })
                    @Html.ValidationMessageFor(m => m.DiscountPercentage, "", new { @class = "text-danger" })
                </div>

                <div class="form-group">
                    @Html.LabelFor(m => m.CampaignCode, new { @class = "form-label" })
                    @Html.TextBoxFor(m => m.CampaignCode, new { @class = "form-control" })
                </div>
            </div>

            <div class="form-row">
                <div class="form-group">
                    @Html.LabelFor(m => m.StartDate, new { @class = "form-label" })
                    @Html.TextBoxFor(m => m.StartDate, "{0:yyyy-MM-dd}", new { @class = "form-control", type = "date", required = "required" })
                    @Html.ValidationMessageFor(m => m.StartDate, "", new { @class = "text-danger" })
                </div>

                <div class="form-group">
                    @Html.LabelFor(m => m.EndDate, new { @class = "form-label" })
                    @Html.TextBoxFor(m => m.EndDate, "{0:yyyy-MM-dd}", new { @class = "form-control", type = "date", required = "required" })
                    @Html.ValidationMessageFor(m => m.EndDate, "", new { @class = "text-danger" })
                </div>
            </div>

            <div class="form-group">
                @Html.LabelFor(m => m.ImageUrl, new { @class = "form-label" })
                @Html.TextBoxFor(m => m.ImageUrl, new { @class = "form-control", type = "url" })
            </div>

            <div class="form-group">
                @Html.LabelFor(m => m.Badge, new { @class = "form-label" })
                @Html.DropDownListFor(m => m.Badge, new SelectList(new[] {
                    new SelectListItem { Text = "Yok", Value = "" },
                    new SelectListItem { Text = "Sıcak Fırsat", Value = "Sıcak Fırsat" },
                    new SelectListItem { Text = "Yeni", Value = "Yeni" },
                    new SelectListItem { Text = "Son Dakika", Value = "Son Dakika" },
                    new SelectListItem { Text = "Özel", Value = "Özel" },
                    new SelectListItem { Text = "Popüler", Value = "Popüler" },
                    new SelectListItem { Text = "Bonus", Value = "Bonus" },
                    new SelectListItem { Text = "Grup", Value = "Grup" },
                    new SelectListItem { Text = "Sezon", Value = "Sezon" }
                }, "Value", "Text", Model.Badge), new { @class = "form-control" })
            </div>

            <div class="form-row">
                <div class="form-group">
                    @Html.LabelFor(m => m.MinPersonCount, new { @class = "form-label" })
                    @Html.TextBoxFor(m => m.MinPersonCount, new { @class = "form-control", type = "number", min = "1" })
                </div>

                <div class="form-group">
                    @Html.LabelFor(m => m.MaxPersonCount, new { @class = "form-label" })
                    @Html.TextBoxFor(m => m.MaxPersonCount, new { @class = "form-control", type = "number", min = "1" })
                </div>
            </div>

            <div class="form-row">
                <div class="form-group checkbox-group">
                    @Html.CheckBoxFor(m => m.IsStudentDiscount, new { @id = "isStudentDiscount" })
                    <label for="isStudentDiscount" class="checkbox-label">Öğrenci İndirimi</label>
                </div>

                <div class="form-group checkbox-group">
                    @Html.CheckBoxFor(m => m.IsFamilyDiscount, new { @id = "isFamilyDiscount" })
                    <label for="isFamilyDiscount" class="checkbox-label">Aile İndirimi</label>
                </div>

                <div class="form-group checkbox-group">
                    @Html.CheckBoxFor(m => m.IsGroupDiscount, new { @id = "isGroupDiscount" })
                    <label for="isGroupDiscount" class="checkbox-label">Grup İndirimi</label>
                </div>
            </div>

            <div class="form-row">
                <div class="form-group checkbox-group">
                    @Html.CheckBoxFor(m => m.IsActive, new { @id = "isActive" })
                    <label for="isActive" class="checkbox-label">Aktif</label>
                </div>

                <div class="form-group checkbox-group">
                    @Html.CheckBoxFor(m => m.IsFeatured, new { @id = "isFeatured" })
                    <label for="isFeatured" class="checkbox-label">Öne Çıkan Fırsat</label>
                </div>
            </div>

            <div class="admin-form-actions">
                <button type="submit" class="admin-btn">
                    <i class="fa-solid fa-save"></i> Değişiklikleri Kaydet
                </button>
                <a href="@Url.Action("Deals", "Admin")" class="admin-btn admin-btn-secondary">
                    <i class="fa-solid fa-times"></i> İptal
                </a>
            </div>
        }
    </div>
</section>

<style>
    .admin-form {
        display: flex;
        flex-direction: column;
        gap: 1.5rem;
    }

    .form-row {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 1rem;
    }

    .admin-form-actions {
        display: flex;
        gap: 1rem;
        margin-top: 1rem;
    }

    @media (max-width: 768px) {
        .form-row {
            grid-template-columns: 1fr;
        }
    }
</style>

