@model IEnumerable<Trabzon_Airlines.Models.Package>

@{
    // Paketler yönetim sayfası
    // Packages management page
    ViewBag.Title = "Paketler Yönetimi";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section styles {
    <link rel="stylesheet" href="~/Content/css/admin.css">
}

<section class="admin-dashboard">
    <div class="admin-dashboard-header">
        <h1><i class="fa-solid fa-suitcase-rolling"></i> Paketler Yönetimi</h1>
        <p>Tüm seyahat paketlerini buradan yönetebilirsiniz</p>
    </div>

    <div class="admin-table-container">
        <div class="admin-table-header">
            <h2>Paket Listesi</h2>
            <a href="@Url.Action("AddPackage", "Admin")" class="admin-btn">
                <i class="fa-solid fa-plus"></i> Yeni Paket Ekle
            </a>
        </div>

        <table class="admin-table">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Başlık</th>
                    <th>Kategori</th>
                    <th>Fiyat</th>
                    <th>Puan</th>
                    <th>Durum</th>
                    <th>İşlemler</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var package in Model)
                {
                    <tr>
                        <td>@package.Id</td>
                        <td>@package.Title</td>
                        <td>@package.Category</td>
                        <td>₺@package.Price.ToString("N2")</td>
                        <td>@package.Rating ⭐</td>
                        <td>
                            @if (package.IsActive)
                            {
                                <span style="color: #28a745;"><i class="fa-solid fa-check-circle"></i> Aktif</span>
                            }
                            else
                            {
                                <span style="color: #dc3545;"><i class="fa-solid fa-times-circle"></i> Pasif</span>
                            }
                        </td>
                        <td>
                            <div class="admin-actions">
                                <a href="@Url.Action("EditPackage", "Admin", new { id = package.Id })" class="admin-btn admin-btn-secondary" style="padding: 0.5rem 1rem; font-size: 0.9rem;">
                                    <i class="fa-solid fa-edit"></i> Düzenle
                                </a>
                                <a href="@Url.Action("DeletePackage", "Admin", new { id = package.Id })" class="admin-btn admin-btn-danger" style="padding: 0.5rem 1rem; font-size: 0.9rem;" onclick="return confirm('Bu paketi silmek istediğinize emin misiniz?');">
                                    <i class="fa-solid fa-trash"></i> Sil
                                </a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <div style="margin-top: 1rem;">
        <a href="@Url.Action("Dashboard", "Admin")" class="admin-btn admin-btn-secondary">
            <i class="fa-solid fa-arrow-left"></i> Dashboard'a Dön
        </a>
    </div>
</section>

