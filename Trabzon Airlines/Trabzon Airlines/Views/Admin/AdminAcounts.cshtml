@* Model tanımı - Admin listesi modeli *@
@* Model definition - Admin list model *@
@model List<Trabzon_Airlines.Models.Admin>

@* Sayfa başlığı - ViewBag.Title ayarı *@
@* Page title - ViewBag.Title setting *@
@{
    // Admin yönetimi sayfası - Sistemdeki tüm adminleri listeler
    // Admin management page - Lists all admins in the system
    ViewBag.Title = "Admin Yönetimi";
    ViewBag.TitleEn = "Admin Management";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

@* Admin Yönetimi CSS *@
@* Admin Management CSS *@
@section styles {
    @* Admin yönetimi sayfası için özel CSS dosyası *@
    @* Special CSS file for admin management page *@
    <link rel="stylesheet" href="~/Content/css/admin-users.css?v=@DateTime.Now.Ticks">
}

@* Sayfa Başlığı *@
@* Page Header *@
<div class="admin-page-header">
    @* Sayfa başlık içeriği *@
    @* Page header content *@
    <div class="page-header-content">
        @* Sayfa başlık metni *@
        @* Page title text *@
        <h1 class="page-title">
            @* Admin yönetimi ikonu *@
            @* Admin management icon *@
            <i class="fa-solid fa-user-shield"></i>
            @* Sayfa başlık metni - Çeviri desteği ile *@
            @* Page title text - With translation support *@
            <span data-tr="Admin Yönetimi" data-en="Admin Management">Admin Yönetimi</span>
        </h1>
        @* Yeni admin ekle butonu *@
        @* Add new admin button *@
        <a href="@Url.Action("Create", "AdminAdmins")" class="btn-primary-action">
            @* Ekle ikonu *@
            @* Add icon *@
            <i class="fa-solid fa-plus-circle"></i>
            @* Buton metni - Çeviri desteği ile *@
            @* Button text - With translation support *@
            <span data-tr="Yeni Admin Ekle" data-en="Add New Admin">Yeni Admin Ekle</span>
        </a>
    </div>
</div>

@* Hata Mesajları *@
@* Error Messages *@
@if (TempData["AdminErrorKey"] != null)
{
    @* Hata mesajı kutusu *@
    @* Error message box *@
    <div class="alert alert-error">
        @* Hata ikonu *@
        @* Error icon *@
        <i class="fa-solid fa-circle-exclamation"></i>
        @* Hata mesajı metni *@
        @* Error message text *@
        <span>
            @* Türkçe hata mesajı kontrolü *@
            @* Turkish error message check *@
            @if (TempData["AdminError_tr"] != null)
            {
                @TempData["AdminError_tr"]
            }
            @* İngilizce hata mesajı kontrolü *@
            @* English error message check *@
            else if (TempData["AdminError_en"] != null)
            {
                @TempData["AdminError_en"]
            }
        </span>
    </div>
}

@* Başarı Mesajları *@
@* Success Messages *@
@if (TempData["AdminSuccessKey"] != null)
{
    @* Başarı mesajı kutusu *@
    @* Success message box *@
    <div class="alert alert-success">
        @* Başarı ikonu *@
        @* Success icon *@
        <i class="fa-solid fa-circle-check"></i>
        @* Başarı mesajı metni *@
        @* Success message text *@
        <span>
            @* Türkçe başarı mesajı kontrolü *@
            @* Turkish success message check *@
            @if (TempData["AdminSuccess_tr"] != null)
            {
                @TempData["AdminSuccess_tr"]
            }
            @* İngilizce başarı mesajı kontrolü *@
            @* English success message check *@
            else if (TempData["AdminSuccess_en"] != null)
            {
                @TempData["AdminSuccess_en"]
            }
        </span>
    </div>
}

@* Admin Listesi Kartı *@
@* Admin List Card *@
<div class="admin-card">
    @* Kart başlık bölümü *@
    @* Card header section *@
    <div class="admin-card-header">
        @* Kart başlık metni *@
        @* Card title text *@
        <h2 class="admin-card-title">
            @* Liste ikonu *@
            @* List icon *@
            <i class="fa-solid fa-list"></i>
            @* Kart başlık metni - Çeviri desteği ile *@
            @* Card title text - With translation support *@
            <span data-tr="Tüm Adminler" data-en="All Admins">Tüm Adminler</span>
        </h2>
        @* Kart aksiyonları bölümü *@
        @* Card actions section *@
        <div class="admin-card-actions">
            @* Arama girişi *@
            @* Search input *@
            <input type="text" id="adminSearch" class="search-input" placeholder="Ara..." data-placeholder-tr="Ara..." data-placeholder-en="Search...">
        </div>
    </div>
    @* Kart içerik bölümü *@
    @* Card body section *@
    <div class="admin-card-body">
        @* Admin listesi kontrolü *@
        @* Admin list check *@
        @if (Model != null && Model.Any())
        {
            @* Admin Listesi Tablosu *@
            @* Admin List Table *@
            <div class="table-responsive">
                @* Admin tablosu *@
                @* Admin table *@
                <table class="admin-table" id="adminsTable">
                    @* Tablo başlık bölümü *@
                    @* Table header section *@
                    <thead>
                        @* Tablo başlık satırı *@
                        @* Table header row *@
                        <tr>
                            @* ID sütunu başlığı *@
                            @* ID column header *@
                            <th data-tr="ID" data-en="ID">ID</th>
                            @* Ad Soyad sütunu başlığı *@
                            @* Full Name column header *@
                            <th data-tr="Ad Soyad" data-en="Full Name">Ad Soyad</th>
                            @* E-posta sütunu başlığı *@
                            @* Email column header *@
                            <th data-tr="E-posta" data-en="Email">E-posta</th>
                            @* İşlemler sütunu başlığı *@
                            @* Actions column header *@
                            <th data-tr="İşlemler" data-en="Actions">İşlemler</th>
                        </tr>
                    </thead>
                    @* Tablo gövde bölümü *@
                    @* Table body section *@
                    <tbody>
                        @* Admin listesi döngüsü *@
                        @* Admin list loop *@
                        @foreach (var admin in Model)
                        {
                            @* Tablo satırı *@
                            @* Table row *@
                            <tr>
                                @* Admin ID hücresi *@
                                @* Admin ID cell *@
                                <td>
                                    @* Admin ID metni *@
                                    @* Admin ID text *@
                                    <strong class="admin-id">#@admin.AdminId</strong>
                                </td>

                                @* Ad Soyad hücresi *@
                                @* Full Name cell *@
                                <td>
                                    @* Admin bilgi bölümü *@
                                    @* Admin info section *@
                                    <div class="admin-info">
                                        @* Admin adı metni *@
                                        @* Admin name text *@
                                        <strong class="user-name">@admin.FullName</strong>
                                        @* Mevcut admin kontrolü *@
                                        @* Current admin check *@
                                        @if (admin.AdminId == (int?)Session["AdminId"])
                                        {
                                            @* Mevcut admin rozeti *@
                                            @* Current admin badge *@
                                            <span class="badge badge-primary" data-tr="Siz" data-en="You">Siz</span>
                                        }
                                    </div>
                                </td>

                                @* E-posta hücresi *@
                                @* Email cell *@
                                <td>
                                    @* E-posta metni *@
                                    @* Email text *@
                                    <span class="user-email">@admin.Email</span>
                                </td>

                                @* İşlemler hücresi *@
                                @* Actions cell *@
                                <td>
                                    @* Aksiyon butonları bölümü *@
                                    @* Action buttons section *@
                                    <div class="action-buttons">
                                        @* Düzenle butonu *@
                                        @* Edit button *@
                                        <a href="@Url.Action("Edit", "AdminAdmins", new { id = admin.AdminId })" class="btn-action btn-edit" title="Düzenle" data-tr-title="Düzenle" data-en-title="Edit">
                                            @* Düzenle ikonu *@
                                            @* Edit icon *@
                                            <i class="fa-solid fa-edit"></i>
                                        </a>
                                        @* Mevcut admin kontrolü - Silme butonu sadece diğer adminler için *@
                                        @* Current admin check - Delete button only for other admins *@
                                        @if (admin.AdminId != (int?)Session["AdminId"])
                                        {
                                            @* Sil butonu *@
                                            @* Delete button *@
                                            <a href="@Url.Action("Delete", "AdminAdmins", new { id = admin.AdminId })" class="btn-action btn-delete" title="Sil" data-tr-title="Sil" data-en-title="Delete" onclick="return confirm('Bu admini silmek istediğinizden emin misiniz?');">
                                                @* Sil ikonu *@
                                                @* Delete icon *@
                                                <i class="fa-solid fa-trash"></i>
                                            </a>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            @* Boş Durum *@
            @* Empty State *@
            <div class="admin-empty-state">
                @* Boş durum ikonu *@
                @* Empty state icon *@
                <i class="fa-solid fa-user-shield"></i>
                @* Boş durum başlığı - Çeviri desteği ile *@
                @* Empty state title - With translation support *@
                <h3 data-tr="Henüz admin bulunmuyor" data-en="No admins found">Henüz admin bulunmuyor</h3>
                @* Boş durum açıklaması - Çeviri desteği ile *@
                @* Empty state description - With translation support *@
                <p data-tr="Henüz hiç admin kaydı yapılmamış." data-en="No admin registrations have been made yet.">Henüz hiç admin kaydı yapılmamış.</p>
                @* İlk admini ekle butonu *@
                @* Add first admin button *@
                <a href="@Url.Action("Create", "AdminAdmins")" class="btn-primary-action">
                    @* Ekle ikonu *@
                    @* Add icon *@
                    <i class="fa-solid fa-plus-circle"></i>
                    @* Buton metni - Çeviri desteği ile *@
                    @* Button text - With translation support *@
                    <span data-tr="İlk Admini Ekle" data-en="Add First Admin">İlk Admini Ekle</span>
                </a>
            </div>
        }
    </div>
</div>

@* Admin Yönetimi JavaScript *@
@* Admin Management JavaScript *@
@section scripts {
    @* Admin yönetimi sayfası için özel JavaScript dosyası *@
    @* Special JavaScript file for admin management page *@
    <script>
        @* Sayfa yüklendiğinde çalışacak fonksiyon *@
        @* Function to run when page loads *@
        $(document).ready(function () {
            @* Arama fonksiyonu - Admin arama işlevi *@
            @* Search function - Admin search functionality *@
            $('#adminSearch').on('keyup', function () {
                @* Arama değeri - Küçük harfe çevir *@
                @* Search value - Convert to lowercase *@
                var value = $(this).val().toLowerCase();
                @* Tablo satırlarını filtrele *@
                @* Filter table rows *@
                $('#adminsTable tbody tr').filter(function () {
                    @* Satır metninde arama değeri var mı kontrol et *@
                    @* Check if search value exists in row text *@
                    $(this).toggle($(this).text().toLowerCase().indexOf(value) > -1);
                });
            });
        });
    </script>
}
