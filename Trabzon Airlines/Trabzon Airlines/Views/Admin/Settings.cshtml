@* Model tanımı - Admin modeli *@
@* Model definition - Admin model *@
@model Trabzon_Airlines.Models.Admin

@* Sayfa başlığı - ViewBag.Title ayarı *@
@* Page title - ViewBag.Title setting *@
@{
    ViewBag.Title = "Ayarlar";
    ViewBag.TitleEn = "Settings";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

@* Ayarlar CSS *@
@* Settings CSS *@
@section styles {
    <link rel="stylesheet" href="~/Content/css/admin-settings.css?v=@DateTime.Now.Ticks">
}

@* Sayfa Başlığı *@
@* Page Header *@
<div class="admin-page-header">
    <div class="page-header-content">
        <h1 class="page-title">
            <i class="fa-solid fa-gear"></i>
            <span data-tr="Ayarlar" data-en="Settings">Ayarlar</span>
        </h1>
    </div>
</div>

@* Hata Mesajları *@
@* Error Messages *@
@if (TempData["AdminErrorKey"] != null)
{
    <div class="alert alert-error">
        <i class="fa-solid fa-circle-exclamation"></i>
        <span>
            @if (TempData["AdminError_tr"] != null)
            {
                @TempData["AdminError_tr"]
            }
            else if (TempData["AdminError_en"] != null)
            {
                @TempData["AdminError_en"]
            }
        </span>
    </div>
}

@* Başarı Mesajları *@
@* Success Messages *@
@if (TempData["AdminSuccessKey"] != null)
{
    <div class="alert alert-success">
        <i class="fa-solid fa-circle-check"></i>
        <span>
            @if (TempData["AdminSuccess_tr"] != null)
            {
                @TempData["AdminSuccess_tr"]
            }
            else if (TempData["AdminSuccess_en"] != null)
            {
                @TempData["AdminSuccess_en"]
            }
        </span>
    </div>
}

@* Ayarlar Formu *@
@* Settings Form *@
<div class="admin-card">
    <div class="admin-card-header">
        <h2 class="admin-card-title">
            <i class="fa-solid fa-user"></i>
            <span data-tr="Profil Bilgileri" data-en="Profile Information">Profil Bilgileri</span>
        </h2>
    </div>
    <div class="admin-card-body">
        <form method="post" action="@Url.Action("Settings", "Admin")" id="settingsForm">
            @Html.AntiForgeryToken() @* CSRF koruması *@
            
            @* Ad Soyad Alanı *@
            @* Full Name Field *@
            <div class="form-group">
                <label for="fullName" class="form-label">
                    <i class="fa-solid fa-user"></i>
                    <span data-tr="Ad Soyad *" data-en="Full Name *">Ad Soyad *</span>
                </label>
                <input type="text" id="fullName" name="fullName" class="form-control" value="@Model.FullName" required>
            </div>

            @* E-posta Alanı *@
            @* Email Field *@
            <div class="form-group">
                <label for="email" class="form-label">
                    <i class="fa-solid fa-envelope"></i>
                    <span data-tr="E-posta *" data-en="Email *">E-posta *</span>
                </label>
                <input type="email" id="email" name="email" class="form-control" value="@Model.Email" required>
            </div>

            @* Şifre Değiştirme Bölümü *@
            @* Password Change Section *@
            <div class="form-section">
                <h3 class="form-section-title" data-tr="Şifre Değiştir" data-en="Change Password">Şifre Değiştir</h3>
                <p class="form-section-description" data-tr="Şifrenizi değiştirmek istemiyorsanız bu alanları boş bırakın." data-en="Leave these fields empty if you don't want to change your password.">Şifrenizi değiştirmek istemiyorsanız bu alanları boş bırakın.</p>
            </div>

            @* Mevcut Şifre Alanı *@
            @* Current Password Field *@
            <div class="form-group">
                <label for="currentPassword" class="form-label">
                    <i class="fa-solid fa-lock"></i>
                    <span data-tr="Mevcut Şifre" data-en="Current Password">Mevcut Şifre</span>
                </label>
                <input type="password" id="currentPassword" name="currentPassword" class="form-control">
            </div>

            @* Yeni Şifre Alanı *@
            @* New Password Field *@
            <div class="form-group">
                <label for="newPassword" class="form-label">
                    <i class="fa-solid fa-key"></i>
                    <span data-tr="Yeni Şifre" data-en="New Password">Yeni Şifre</span>
                </label>
                <input type="password" id="newPassword" name="newPassword" class="form-control">
            </div>

            @* Şifre Onay Alanı *@
            @* Confirm Password Field *@
            <div class="form-group">
                <label for="confirmPassword" class="form-label">
                    <i class="fa-solid fa-key"></i>
                    <span data-tr="Yeni Şifre (Tekrar)" data-en="New Password (Confirm)">Yeni Şifre (Tekrar)</span>
                </label>
                <input type="password" id="confirmPassword" name="confirmPassword" class="form-control">
            </div>

            @* Form Butonları *@
            @* Form Buttons *@
            <div class="form-actions">
                <button type="submit" class="btn-primary-action">
                    <i class="fa-solid fa-save"></i>
                    <span data-tr="Kaydet" data-en="Save">Kaydet</span>
                </button>
                <a href="@Url.Action("Dashboard", "Admin")" class="btn-secondary-action">
                    <i class="fa-solid fa-times"></i>
                    <span data-tr="İptal" data-en="Cancel">İptal</span>
                </a>
            </div>
        </form>
    </div>
</div>

@* Ayarlar JavaScript *@
@* Settings JavaScript *@
@section scripts {
    <script src="~/js/admin-settings.js"></script>
}

