@model IEnumerable<Trabzon_Airlines.Models.SupportRequest>

@{
    ViewBag.Title = "Destek Talepleri";
    ViewBag.TitleEn = "Support Tickets";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";

    var currentStatus = (Request.QueryString["status"] ?? "all").ToLower();
    var searchText = Request.QueryString["search"] ?? "";
}

@section styles {
    <!-- FLIGHTS CSS -->
    <link rel="stylesheet" href="~/Content/css/admin-flights.css?v=@DateTime.Now.Ticks" />

    <!-- Destek sayfası -->
    <style>
        .admin-page-header {
            margin-bottom: 1.5rem;
        }

        .admin-card-header {
            align-items: center;
            justify-content: space-between;
        }

        .admin-card-title {
            display: flex;
            align-items: center;
            gap: .6rem;
        }

            .admin-card-title i {
                font-size: 1.2rem;
            }

        .admin-card-actions {
            display: flex;
            align-items: center;
            gap: 1rem;
        }

        /* Sekmeler (Hepsi / Yeni / Devam Eden / Çözüldü) */
        .status-tabs {
            display: flex;
            align-items: center;
            gap: .5rem;
        }

        .status-tab {
            padding: .35rem .9rem;
            border-radius: 999px;
            background: #f5f5f5;
            border: 1px solid #e3e3e3;
            font-size: .85rem;
            color: #444;
            text-decoration: none;
            transition: all .15s ease;
            white-space: nowrap;
        }

            .status-tab:hover {
                background: #ffe6ea;
                border-color: #e4002b;
                color: #e4002b;
            }

            .status-tab.active {
                background: #e4002b;
                border-color: #e4002b;
                color: #fff;
                font-weight: 600;
            }

        .admin-search-form {
            display: flex;
            align-items: center;
        }

            .admin-search-form .search-input {
                min-width: 220px;
            }

        /* Tablo görünümü */
        #supportTable.admin-table th,
        #supportTable.admin-table td {
            vertical-align: middle;
        }

        #supportTable .time-info {
            display: flex;
            flex-direction: column;
            line-height: 1.2;
        }

        #supportTable .time-date {
            font-size: .85rem;
            font-weight: 500;
        }

        #supportTable .time-hour {
            font-size: .8rem;
            color: #777;
        }

        .support-message {
            max-width: 360px;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        /* Satır hover  */
        #supportTable tbody tr {
            transition: background-color .15s ease, transform .05s ease;
        }

            #supportTable tbody tr.row-hover,
            #supportTable tbody tr:hover {
                background-color: #fff7f7;
                transform: translateY(-1px);
            }

        /* Durum dropdown + buton yan yana */
        .inline-form {
            display: flex;
            align-items: center;
            gap: 1.5rem;
        }

            .inline-form .status-select {
                padding: .25rem .4rem;
                font-size: .8rem;
                border-radius: .4rem;
            }

            .inline-form .btn-action {
                display: inline-flex;
                align-items: center;
                gap: .25rem;
                padding: .25rem .55rem;
                font-size: .8rem;
            }

                .inline-form .btn-action i {
                    font-size: .75rem;
                }
    </style>
}

<div class="admin-page-header">
    <div class="page-header-content">
        <h1 class="page-title">
            <i class="fa-solid fa-headset"></i>
            <span data-tr="Destek Talepleri" data-en="Support Tickets">Destek Talepleri</span>
        </h1>
        <p class="page-subtitle">
            <span data-tr="Kullanıcılardan gelen destek taleplerini buradan yönetebilirsiniz."
                  data-en="You can manage support tickets from your customers here.">
                Kullanıcılardan gelen destek taleplerini buradan yönetebilirsiniz.
            </span>
        </p>
    </div>
</div>

<div class="admin-card">
    <div class="admin-card-header">
        <div class="admin-card-title">
            <i class="fa-solid fa-list"></i>
            <span data-tr="Tüm Destek Talepleri" data-en="All Support Tickets">Tüm Destek Talepleri</span>
        </div>

        <div class="admin-card-actions">

            <div class="status-tabs">
                <a href="@Url.Action("Index", new { status = "all", search = searchText })"
                   class="status-tab @(currentStatus == "all" ? "active" : "")">
                    <span data-tr="Hepsi" data-en="All">Hepsi</span>
                </a>
                <a href="@Url.Action("Index", new { status = "new", search = searchText })"
                   class="status-tab @(currentStatus == "new" ? "active" : "")">
                    <span data-tr="Yeni" data-en="New">Yeni</span>
                </a>
                <a href="@Url.Action("Index", new { status = "inprogress", search = searchText })"
                   class="status-tab @(currentStatus == "inprogress" ? "active" : "")">
                    <span data-tr="Devam Eden" data-en="In Progress">Devam Eden</span>
                </a>
                <a href="@Url.Action("Index", new { status = "resolved", search = searchText })"
                   class="status-tab @(currentStatus == "resolved" ? "active" : "")">
                    <span data-tr="Çözüldü" data-en="Resolved">Çözüldü</span>
                </a>
            </div>

            <form method="get"
                  action="@Url.Action("Index")"
                  class="admin-search-form">
                <input type="hidden" name="status" value="@currentStatus" />
                <input type="text"
                       name="search"
                       value="@searchText"
                       class="search-input"
                       placeholder="Ara..."
                       data-placeholder-tr="İsim, PNR veya konu ara..."
                       data-placeholder-en="Search name, PNR or topic..." />
            </form>
        </div>
    </div>

    <div class="admin-card-body">
        @if (Model != null && Model.Any())
        {
            <div class="table-responsive">
                <table class="admin-table" id="supportTable">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th data-tr="Tarih" data-en="Date">Tarih</th>
                            <th data-tr="Kullanıcı" data-en="User">Kullanıcı</th>
                            <th data-tr="PNR" data-en="PNR">PNR</th>
                            <th data-tr="Konu" data-en="Topic">Konu</th>
                            <th data-tr="Durum" data-en="Status">Durum</th>
                            <th data-tr="Mesaj" data-en="Message">Mesaj</th>
                            <th data-tr="İşlemler" data-en="Actions">İşlemler</th>
                        </tr>
                    </thead>
                    <tbody>
                        @{
                            var index = 1;
                        }
                        @foreach (var item in Model)
                        {
                            var badgeClass = "badge badge-secondary";
                            var statusTextTr = "Bilinmiyor";
                            var statusTextEn = "Unknown";

                            if (item.Status == "New")
                            {
                                badgeClass = "badge badge-danger";
                                statusTextTr = "Yeni";
                                statusTextEn = "New";
                            }
                            else if (item.Status == "InProgress")
                            {
                                badgeClass = "badge badge-warning text-dark";
                                statusTextTr = "Devam Ediyor";
                                statusTextEn = "In Progress";
                            }
                            else if (item.Status == "Resolved")
                            {
                                badgeClass = "badge badge-success";
                                statusTextTr = "Çözüldü";
                                statusTextEn = "Resolved";
                            }

                            var displayName = string.IsNullOrWhiteSpace(item.FullName)
                                ? "Misafir Kullanıcı"
                                : item.FullName;
                            <tr>
                                <td>@index</td>
                                <td>
                                    <div class="time-info">
                                        <div class="time-date">@item.CreatedAt.ToString("dd.MM.yyyy")</div>
                                        <div class="time-hour">@item.CreatedAt.ToString("HH:mm")</div>
                                    </div>
                                </td>
                                <td>@displayName</td>
                                <td>@item.PNR</td>
                                <td>@item.Topic</td>
                                <td>
                                    <span class="@badgeClass"
                                          data-tr="@statusTextTr"
                                          data-en="@statusTextEn">
                                        @statusTextTr
                                    </span>
                                </td>
                                <td class="support-message" title="@item.Message">
                                    @item.Message
                                </td>
                                <td>
                                    @using (Html.BeginForm("UpdateStatus", "AdminSupport", FormMethod.Post, new { @class = "inline-form" }))
                                    {
                                        @Html.AntiForgeryToken()
                                        @Html.Hidden("id", item.SupportRequestId)

                                        <select name="status" class="status-select">
                                            <option value="New" @(item.Status == "New" ? "selected" : "")>Yeni</option>
                                            <option value="InProgress" @(item.Status == "InProgress" ? "selected" : "")>Devam Ediyor</option>
                                            <option value="Resolved" @(item.Status == "Resolved" ? "selected" : "")>Çözüldü</option>
                                        </select>

                                        <button type="submit" class="btn-action btn-edit">
                                            <i class="fa-solid fa-rotate"></i>
                                            <span data-tr="Güncelle" data-en="Update">Güncelle</span>
                                        </button>
                                    }
                                </td>
                            </tr>
                            index++;
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="admin-empty-state">
                <i class="fa-solid fa-inbox"></i>
                <h3 data-tr="Henüz destek talebi bulunmuyor" data-en="No support tickets yet">
                    Henüz destek talebi bulunmuyor
                </h3>
                <p data-tr="Kullanıcılar bu sayfadan size ulaştığında talepler burada listelenecektir."
                   data-en="When users contact you from the support page, their tickets will appear here.">
                    Kullanıcılar bu sayfadan size ulaştığında talepler burada listelenecektir.
                </p>
            </div>
        }
    </div>
</div>

@section scripts {
    <script>
        (function () {
            const table = document.getElementById("supportTable");
            if (!table) return;

            table.querySelectorAll("tbody tr").forEach(function (row) {
                row.addEventListener("mouseenter", function () {
                    row.classList.add("row-hover");
                });
                row.addEventListener("mouseleave", function () {
                    row.classList.remove("row-hover");
                });
            });
        })();
    </script>
}
