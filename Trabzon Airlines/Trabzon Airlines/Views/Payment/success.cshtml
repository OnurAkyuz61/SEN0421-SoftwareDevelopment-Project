@* Sayfa başlığı - ViewBag.Title ayarı *@
@* Page title - ViewBag.Title setting *@
@{
    ViewBag.Title = "Ödeme Başarılı";
    ViewBag.TitleEn = "Payment Successful";
    
    // Varsayılan mesajlar - Eğer ViewBag'de yoksa
    // Default messages - If not in ViewBag
    if (ViewBag.Mesaj == null && ViewBag.Message == null)
    {
        ViewBag.Mesaj = "Ödeme işleminiz başarıyla tamamlandı.";
        ViewBag.Message = "Your payment has been successfully completed.";
    }
}

@* Özel CSS stilleri - Site temasına uygun *@
@* Custom CSS styles - Matching site theme *@
@section styles {
    <style>
        /* Success Page Wrapper */
        .success-page-wrapper {
            background: linear-gradient(135deg, #e4002b 0%, #c20025 50%, #a0001f 100%);
            min-height: calc(100vh - 70px);
            padding: 3rem 0;
            position: relative;
            overflow: hidden;
        }

        .success-page-wrapper::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: url('data:image/svg+xml,<svg width="100" height="100" xmlns="http://www.w3.org/2000/svg"><circle cx="50" cy="50" r="2" fill="rgba(255,255,255,0.1)"/></svg>');
            opacity: 0.3;
            pointer-events: none;
        }

        .success-container {
            position: relative;
            z-index: 1;
            max-width: 800px;
            margin: 0 auto;
        }

        /* Success Card */
        .success-card {
            background: white;
            border-radius: 30px;
            padding: 3rem;
            box-shadow: 0 20px 60px rgba(0,0,0,0.3);
            text-align: center;
            animation: slideUp 0.6s ease-out;
        }

        @@keyframes slideUp {
            from {
                opacity: 0;
                transform: translateY(30px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        /* Success Icon */
        .success-icon-wrapper {
            position: relative;
            display: inline-block;
            margin-bottom: 2rem;
        }

        .success-icon-circle {
            width: 120px;
            height: 120px;
            background: linear-gradient(135deg, #28a745 0%, #20c997 100%);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0 auto;
            box-shadow: 0 10px 30px rgba(40, 167, 69, 0.4);
            animation: scaleIn 0.5s ease-out 0.2s both;
        }

        @@keyframes scaleIn {
            from {
                transform: scale(0);
            }
            to {
                transform: scale(1);
            }
        }

        .success-icon-circle i {
            font-size: 4rem;
            color: white;
            animation: checkmark 0.6s ease-out 0.5s both;
        }

        @@keyframes checkmark {
            0% {
                transform: scale(0) rotate(45deg);
            }
            50% {
                transform: scale(1.2) rotate(45deg);
            }
            100% {
                transform: scale(1) rotate(0deg);
            }
        }

        /* Success Title */
        .success-title {
            font-size: 2.5rem;
            font-weight: 700;
            color: #333;
            margin-bottom: 1rem;
            background: linear-gradient(135deg, #28a745 0%, #20c997 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }

        /* Success Message Card */
        .success-message-card {
            background: linear-gradient(135deg, #d4edda 0%, #c3e6cb 100%);
            border: 2px solid #28a745;
            border-radius: 20px;
            padding: 2rem;
            margin: 2rem 0;
            text-align: left;
        }

        .success-message-header {
            display: flex;
            align-items: center;
            gap: 1rem;
            margin-bottom: 1rem;
        }

        .success-message-header i {
            font-size: 1.5rem;
            color: #28a745;
        }

        .success-message-header h4 {
            font-size: 1.3rem;
            font-weight: 700;
            color: #155724;
            margin: 0;
        }

        .success-message-text {
            font-size: 1.1rem;
            color: #155724;
            margin-bottom: 1rem;
            line-height: 1.6;
        }

        .payment-reference {
            background: white;
            border-radius: 10px;
            padding: 1rem;
            margin-top: 1rem;
            border: 2px dashed #28a745;
        }

        .payment-reference-label {
            font-size: 0.9rem;
            color: #666;
            margin-bottom: 0.5rem;
            font-weight: 600;
        }

        .payment-reference-code {
            font-size: 1.3rem;
            font-weight: 700;
            color: #e4002b;
            font-family: 'Courier New', monospace;
            letter-spacing: 2px;
        }

        /* Info Card */
        .info-card {
            background: linear-gradient(135deg, #d1ecf1 0%, #bee5eb 100%);
            border: 2px solid #17a2b8;
            border-radius: 20px;
            padding: 1.5rem;
            margin: 2rem 0;
            display: flex;
            align-items: flex-start;
            gap: 1rem;
        }

        .info-card i {
            font-size: 1.5rem;
            color: #17a2b8;
            margin-top: 0.2rem;
        }

        .info-card-text {
            font-size: 1rem;
            color: #0c5460;
            line-height: 1.6;
            margin: 0;
        }

        /* Action Buttons */
        .action-buttons {
            display: flex;
            gap: 1rem;
            justify-content: center;
            flex-wrap: wrap;
            margin-top: 2.5rem;
        }

        .btn-success-action {
            background: linear-gradient(135deg, #e4002b 0%, #c20025 100%);
            border: none;
            color: white;
            padding: 1rem 2.5rem;
            border-radius: 15px;
            font-size: 1.1rem;
            font-weight: 600;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            gap: 0.75rem;
            transition: all 0.3s ease;
            box-shadow: 0 4px 15px rgba(228, 0, 43, 0.3);
        }

        .btn-success-action:hover {
            transform: translateY(-3px);
            box-shadow: 0 6px 20px rgba(228, 0, 43, 0.4);
            background: linear-gradient(135deg, #c20025 0%, #e4002b 100%);
            color: white;
            text-decoration: none;
        }

        .btn-success-action:active {
            transform: translateY(-1px);
        }

        .btn-outline-success-action {
            background: white;
            border: 2px solid #e4002b;
            color: #e4002b;
            padding: 1rem 2.5rem;
            border-radius: 15px;
            font-size: 1.1rem;
            font-weight: 600;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            gap: 0.75rem;
            transition: all 0.3s ease;
        }

        .btn-outline-success-action:hover {
            background: #e4002b;
            color: white;
            transform: translateY(-3px);
            box-shadow: 0 6px 20px rgba(228, 0, 43, 0.3);
            text-decoration: none;
        }

        .btn-secondary-success-action {
            background: #f8f9fa;
            border: 2px solid #dee2e6;
            color: #6c757d;
            padding: 1rem 2.5rem;
            border-radius: 15px;
            font-size: 1.1rem;
            font-weight: 600;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            gap: 0.75rem;
            transition: all 0.3s ease;
        }

        .btn-secondary-success-action:hover {
            background: #e9ecef;
            border-color: #adb5bd;
            color: #495057;
            transform: translateY(-3px);
            box-shadow: 0 6px 20px rgba(0, 0, 0, 0.1);
            text-decoration: none;
        }

        /* Responsive */
        @@media (max-width: 768px) {
            .success-page-wrapper {
                padding: 2rem 1rem;
            }

            .success-card {
                padding: 2rem 1.5rem;
                border-radius: 20px;
            }

            .success-title {
                font-size: 2rem;
            }

            .success-icon-circle {
                width: 100px;
                height: 100px;
            }

            .success-icon-circle i {
                font-size: 3rem;
            }

            .action-buttons {
                flex-direction: column;
            }

            .btn-success-action,
            .btn-outline-success-action,
            .btn-secondary-success-action {
                width: 100%;
                justify-content: center;
            }
        }
    </style>
}

@* Ana İçerik - Site temasına uygun tasarım *@
@* Main Content - Design matching site theme *@
<div class="success-page-wrapper">
    <div class="container">
        <div class="success-container">
            <div class="success-card">
                @* Başarı İkonu - Animasyonlu *@
                @* Success Icon - Animated *@
                <div class="success-icon-wrapper">
                    <div class="success-icon-circle">
                        <i class="fa-solid fa-check"></i>
                    </div>
                </div>

                @* Başlık *@
                @* Title *@
                <h1 class="success-title" data-tr="Ödeme Başarılı!" data-en="Payment Successful!">
                    Ödeme Başarılı!
                </h1>

                @* Başarı Mesajı Kartı *@
                @* Success Message Card *@
                @{
                    var successMessage = ViewBag.Mesaj ?? ViewBag.Message ?? TempData["Success"] ?? TempData["Success_tr"];
                    var successMessageEn = ViewBag.Message ?? TempData["Success_en"];
                }
                @if (successMessage != null || successMessageEn != null)
                {
                    <div class="success-message-card">
                        <div class="success-message-header">
                            <i class="fa-solid fa-check-circle"></i>
                            <h4 data-tr="Tebrikler!" data-en="Congratulations!">Tebrikler!</h4>
                        </div>
                        <p class="success-message-text">@(successMessage ?? successMessageEn)</p>
                        @if (ViewBag.PaymentId != null)
                        {
                            <div class="payment-reference">
                                <div class="payment-reference-label" data-tr="Ödeme Referans Numarası:" data-en="Payment Reference Number:">
                                    Ödeme Referans Numarası:
                                </div>
                                <div class="payment-reference-code">@ViewBag.PaymentId</div>
                            </div>
                        }
                    </div>
                }

                @* Bilgilendirme Kartı *@
                @* Information Card *@
                <div class="info-card">
                    <i class="fa-solid fa-info-circle"></i>
                    <p class="info-card-text" data-tr="Ödeme işleminiz başarıyla tamamlandı. Rezervasyon bilgileriniz e-posta adresinize gönderilecektir." data-en="Your payment has been successfully completed. Your reservation information will be sent to your email address.">
                        Ödeme işleminiz başarıyla tamamlandı. Rezervasyon bilgileriniz e-posta adresinize gönderilecektir.
                    </p>
                </div>

                @* Aksiyon Butonları *@
                @* Action Buttons *@
                <div class="action-buttons">
                    @if (ViewBag.BookingId != null)
                    {
                        <a href="@Url.Action("BookingResult", "Booking", new { bookingId = ViewBag.BookingId })" class="btn-success-action">
                            <i class="fa-solid fa-ticket"></i>
                            <span data-tr="Rezervasyon Detayları" data-en="Booking Details">Rezervasyon Detayları</span>
                        </a>
                    }
                    <a href="@Url.Action("Index", "Home")" class="btn-outline-success-action">
                        <i class="fa-solid fa-home"></i>
                        <span data-tr="Ana Sayfaya Dön" data-en="Return to Home">Ana Sayfaya Dön</span>
                    </a>
                    <a href="@Url.Action("Index", "Flights")" class="btn-secondary-success-action">
                        <i class="fa-solid fa-plane"></i>
                        <span data-tr="Yeni Uçuş Ara" data-en="Search New Flight">Yeni Uçuş Ara</span>
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
