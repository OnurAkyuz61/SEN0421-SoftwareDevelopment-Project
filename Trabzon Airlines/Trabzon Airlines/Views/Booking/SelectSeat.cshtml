@* Model tanımı - Koltuk listesi modeli *@
@* Model definition - Seat list model *@
@model List<Trabzon_Airlines.Models.FlightSeat>

@* Sayfa başlığı - ViewBag.Title ayarı *@
@* Page title - ViewBag.Title setting *@
@{
    ViewBag.Title = "Koltuk Seçimi - Seat Selection";
}

@* Ana başlık ve buton bölümü - Flexbox ile düzenlenmiş *@
@* Main header and button section - Arranged with flexbox *@
<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 2rem;">
    @* Ortalanmış başlık bölümü *@
    @* Centered header section *@
    <div style="flex: 1; text-align: center;">
        <div>
            @* Uçuş numarası ve koltuk seçimi başlığı - Çeviri desteği ile *@
            @* Flight number and seat selection title - With translation support *@
            <h2 style="margin: 0;" data-tr="@ViewBag.Flight.FlightNumber Koltuk Seçimi" data-en="@ViewBag.Flight.FlightNumber Seat Selection">@ViewBag.Flight.FlightNumber Koltuk Seçimi</h2>
            @* Uçuş rotası - Kalkış ve varış havalimanları arasında uçak ikonu *@
            @* Flight route - Plane icon between departure and arrival airports *@
            <h4 style="margin: 0.5rem 0 0 0; display: flex; align-items: center; justify-content: center; gap: 10px;">
                @ViewBag.Flight.FromCode 
                @* Uçak ikonu - FontAwesome'dan *@
                @* Plane icon - From FontAwesome *@
                <i class="fa-solid fa-plane" style="font-size: 1.2rem; color: var(--primary-color, #007bff);"></i>
                @ViewBag.Flight.ToCode
            </h4>
        </div>
    </div>
    @* Sağ üstteki devam et butonu *@
    @* Continue button at top right *@
    <div style="margin-left: auto;">
        @* Form submit butonu - Form dışında ama form'a bağlı *@
        @* Form submit button - Outside form but connected to form *@
        <button type="submit" form="seatSelectionForm" class="btn btn-success" data-tr="Devam Et" data-en="Continue">
            Devam Et
        </button>
    </div>
</div>
@* Yatay çizgi ayırıcı *@
@* Horizontal line separator *@
<hr />

@* Hata mesajı gösterimi - Error message display *@
@if (TempData["Error_tr"] != null || TempData["Error_en"] != null)
{
    <div class="alert alert-danger" role="alert" style="margin-bottom: 2rem; padding: 1rem; border-radius: 5px; background: #f8d7da; color: #721c24; border: 1px solid #f5c6cb;">
        <strong data-tr="Hata!" data-en="Error!">Hata!</strong>
        <span>@(TempData["Error_tr"] ?? TempData["Error_en"])</span>
    </div>
}

@* Koltuk seçim formu - POST metodu ile *@
@* Seat selection form - With POST method *@
@using (Html.BeginForm("SelectSeat", "Booking", FormMethod.Post, new { id = "seatSelectionForm" }))
{
    @* CSRF koruması için anti-forgery token *@
    @* Anti-forgery token for CSRF protection *@
    @Html.AntiForgeryToken()
    @* Gizli uçuş ID alanı - Form gönderiminde kullanılacak *@
    @* Hidden flight ID field - Will be used in form submission *@
    <input type="hidden" name="FlightId" value="@ViewBag.Flight.FlightId" />
    
    @* Gizli yolcu sayıları ve kabin sınıfı alanları - JavaScript ile doldurulacak *@
    @* Hidden passenger counts and cabin class fields - Will be filled by JavaScript *@
    <input type="hidden" name="AdultCount" id="hiddenAdultCount" value="1" />
    <input type="hidden" name="ChildCount" id="hiddenChildCount" value="0" />
    <input type="hidden" name="InfantCount" id="hiddenInfantCount" value="0" />
    <input type="hidden" name="CabinClass" id="hiddenCabinClass" value="economy" />

    @* Uçak gövdesi - Koltuk haritası için container *@
    @* Plane body - Container for seat map *@
    <div class="plane-body">
        @* Kokpit bölümü - Uçağın ön kısmı *@
        @* Cockpit section - Front part of the plane *@
        <div class="cockpit" data-tr="Kokpit" data-en="Cockpit">Kokpit</div>

        @* Koltuk satırları - 1'den 14'e kadar *@
        @* Seat rows - From 1 to 14 *@
        @for (int row = 1; row <= 14; row++)
        {
            @* Her satır için div *@
            @* Div for each row *@
            <div class="seat-row">
                @* Her satırdaki koltuk sütunları - A, B, C, D *@
                @* Seat columns in each row - A, B, C, D *@
                @foreach (var col in new[] { "A", "B", "C", "D" })
                {
                    @* Koltuk numarası oluştur - Satır + Sütun (örn: 1A, 2B) *@
                    @* Create seat number - Row + Column (e.g., 1A, 2B) *@
                    var seatNumber = row + col;

                    @* Model'den bu koltuk numarasına sahip koltuğu bul *@
                    @* Find seat with this seat number from model *@
                    var seat = Model.FirstOrDefault(s => s.Seat.SeatNumber == seatNumber);

                    @* Eğer koltuk bulunduysa *@
                    @* If seat is found *@
                    if (seat != null)
                    {
                        @* Koltuk rezerve edilmiş mi kontrol et *@
                        @* Check if seat is reserved *@
                        bool isReserved = seat.IsReserved;
                        @* Koltuk durumu - Rezerve ise "reserved", değilse "free" *@
                        @* Seat state - "reserved" if reserved, "free" if not *@
                        string seatState = isReserved ? "reserved" : "free";
                        @* Kabin sınıfı - İlk 4 satır business, diğerleri economy *@
                        @* Cabin class - First 4 rows business, others economy *@
                        string cabinClass = row <= 4 ? "business" : "economy";

                        @* Koltuk etiketi - Checkbox ile seçilebilir (çoklu seçim) *@
                        @* Seat label - Selectable with checkbox (multiple selection) *@
                        <label class="seat-item @seatState @cabinClass" data-seat="@seatNumber" style="position: relative; z-index: 1;">
                            @* Checkbox - Koltuk seçimi için (çoklu seçim) *@
                            @* Checkbox - For seat selection (multiple selection) *@
                            <input type="checkbox"
                                   name="SelectedSeatIds"
                                   value="@seat.SeatId"
                                   @(isReserved ? "disabled" : "")
                                   style="position: absolute; opacity: 0; width: 100%; height: 100%; cursor: pointer; z-index: 2;" />
                            @* Koltuk numarası gösterimi *@
                            @* Seat number display *@
                            <span style="position: relative; z-index: 1; pointer-events: none; user-select: none;">@seatNumber</span>
                        </label>
                    }
                    else
                    {
                        @* Koltuk bulunamadıysa boş div göster *@
                        @* If seat not found, show empty div *@
                        <div class="seat-item empty"></div>
                    }

                    @* B sütunundan sonra koridor ekle *@
                    @* Add aisle after column B *@
                    if (col == "B")
                    { 
                        <div class="aisle"></div>;
                    }
                }
            </div>
        }
        @* Kuyruk bölümü - Uçağın arka kısmı *@
        @* Tail section - Back part of the plane *@
        <div class="tail" data-tr="Kuyruk" data-en="Tail">Kuyruk</div>
    </div>

    @* Koltuk durumu gösterge kutusu - Renk açıklamaları *@
    @* Seat status indicator box - Color descriptions *@
    <div class="seat-info-box">
        @* Boş koltuk göstergesi *@
        @* Empty seat indicator *@
        <span class="seat-indicator free"></span> <span data-tr="Boş" data-en="Empty">Boş</span>
        @* Dolu koltuk göstergesi *@
        @* Occupied seat indicator *@
        <span class="seat-indicator reserved"></span> <span data-tr="Dolu" data-en="Occupied">Dolu</span>
        @* Business sınıfı göstergesi *@
        @* Business class indicator *@
        <span class="seat-indicator business"></span> <span data-tr="Business" data-en="Business">Business</span>
        @* Economy sınıfı göstergesi *@
        @* Economy class indicator *@
        <span class="seat-indicator economy"></span> <span data-tr="Economy" data-en="Economy">Economy</span>
        @* Seçili koltuk göstergesi *@
        @* Selected seat indicator *@
        <span class="seat-indicator selected"></span> <span data-tr="Seçili" data-en="Selected">Seçili</span>
    </div>
}

@* CSS stilleri bölümü - Koltuk haritası CSS'i *@
@* CSS styles section - Seat map CSS *@
@section Styles {
    @* Koltuk haritası CSS dosyası *@
    @* Seat map CSS file *@
    <link href="~/Content/css/seatmap.css" rel="stylesheet" />
}

@* JavaScript bölümü - Seçili koltuk için dinamik class ekleme ve kabin sınıfı filtreleme *@
@* JavaScript section - Dynamic class addition for selected seat and cabin class filtering *@
@section Scripts {
    <script>
        $(document).ready(function () {
            // Yolcu sayıları ve kabin sınıfını localStorage'dan al
            // Get passenger counts and cabin class from localStorage
            let passengerCounts = {
                adult: 1,
                child: 0,
                infant: 0
            };
            let selectedCabinClass = 'economy';
            
            // localStorage'dan yolcu sayılarını yükle
            // Load passenger counts from localStorage
            try {
                const savedCounts = localStorage.getItem('passengerCounts');
                if (savedCounts) {
                    const parsed = JSON.parse(savedCounts);
                    passengerCounts.adult = parsed.adult || 1;
                    passengerCounts.child = parsed.child || 0;
                    passengerCounts.infant = parsed.infant || 0;
                }
            } catch (e) {
                console.error('Error loading passenger counts:', e);
            }
            
            // localStorage'dan kabin sınıfını yükle
            // Load cabin class from localStorage
            try {
                const savedCabinClass = localStorage.getItem('selectedCabinClass');
                if (savedCabinClass && (savedCabinClass === 'business' || savedCabinClass === 'economy')) {
                    selectedCabinClass = savedCabinClass;
                    console.log('✅ localStorage\'dan kabin sınıfı yüklendi:', selectedCabinClass);
                } else {
                    console.log('⚠️ localStorage\'da kabin sınıfı bulunamadı veya geçersiz, varsayılan kullanılıyor:', selectedCabinClass);
                }
            } catch (e) {
                console.error('❌ Error loading cabin class:', e);
            }
            
            // Debug için konsola yazdır
            // Print to console for debugging
            console.log('📋 Yüklenen kabin sınıfı:', selectedCabinClass);
            
            // Gizli input alanlarını güncelle
            // Update hidden input fields
            $('#hiddenAdultCount').val(passengerCounts.adult);
            $('#hiddenChildCount').val(passengerCounts.child);
            $('#hiddenInfantCount').val(passengerCounts.infant);
            $('#hiddenCabinClass').val(selectedCabinClass);
            
            // Tüm koltukların görünür olduğundan emin ol (filtreleme kaldırıldı)
            // Ensure all seats are visible (filtering removed)
            $('.seat-item:not(.empty)').each(function() {
                const $seat = $(this);
                $seat.css('display', 'inline-flex')
                     .css('visibility', 'visible')
                     .css('opacity', '1')
                     .removeClass('seat-hidden')
                     .addClass('seat-visible');
            });
            
            // Checkbox değiştiğinde seçili koltuk class'ını güncelle (çoklu seçim)
            // Update selected seat class when checkbox changes (multiple selection)
            $('input[type="checkbox"][name="SelectedSeatIds"]').on('change', function () {
                const $seatItem = $(this).closest('.seat-item');
                
                if ($(this).is(':checked')) {
                    // Checkbox seçildiyse selected class'ı ekle
                    // If checkbox is checked, add selected class
                    $seatItem.addClass('selected');
                } else {
                    // Checkbox seçimi kaldırıldıysa selected class'ını kaldır
                    // If checkbox is unchecked, remove selected class
                    $seatItem.removeClass('selected');
                }
                
                // Seçili koltuk sayısını kontrol et ve yolcu sayısıyla karşılaştır
                // Check selected seat count and compare with passenger count
                const selectedCount = $('input[type="checkbox"][name="SelectedSeatIds"]:checked').length;
                const totalPassengers = passengerCounts.adult + passengerCounts.child;
                
                if (selectedCount > totalPassengers) {
                    // Seçili koltuk sayısı yolcu sayısından fazlaysa uyar
                    // Warn if selected seat count exceeds passenger count
                    alert('Seçtiğiniz koltuk sayısı yolcu sayısından fazla! Lütfen ' + totalPassengers + ' koltuk seçin.');
                    $(this).prop('checked', false);
                    $seatItem.removeClass('selected');
                }
            });
            
            // Sayfa yüklendiğinde zaten seçili olan koltuk varsa class ekle
            // If a seat is already selected on page load, add class
            $('input[type="checkbox"][name="SelectedSeatIds"]:checked').each(function () {
                $(this).closest('.seat-item').addClass('selected');
            });
            
            // Form submit edilmeden önce gizli alanları güncelle ve koltuk sayısını kontrol et
            // Update hidden fields before form submit and check seat count
            $('#seatSelectionForm').on('submit', function(e) {
                // Sadece checked ve disabled olmayan checkbox'ları say
                // Count only checked and non-disabled checkboxes
                const selectedCheckboxes = $('input[type="checkbox"][name="SelectedSeatIds"]:checked:not(:disabled)');
                const selectedCount = selectedCheckboxes.length;
                const totalPassengers = passengerCounts.adult + passengerCounts.child;
                
                console.log('Seçili koltuk sayısı:', selectedCount);
                console.log('Toplam yolcu sayısı:', totalPassengers);
                console.log('Seçili koltuk ID\'leri:', selectedCheckboxes.map(function() { return $(this).val(); }).get());
                
                // Disabled checkbox'ları geçici olarak enable et (submit edilebilmeleri için)
                // Temporarily enable disabled checkboxes (so they can be submitted)
                // Ama sadece checked olanları
                // But only the checked ones
                $('input[type="checkbox"][name="SelectedSeatIds"]:checked:disabled').each(function() {
                    $(this).prop('disabled', false);
                });
                
                if (selectedCount === 0) {
                    e.preventDefault();
                    alert('Lütfen en az bir koltuk seçin.');
                    return false;
                }
                
                if (selectedCount !== totalPassengers) {
                    e.preventDefault();
                    alert('Seçtiğiniz koltuk sayısı (' + selectedCount + ') yolcu sayısı (' + totalPassengers + ') ile eşleşmiyor. Lütfen ' + totalPassengers + ' koltuk seçin.');
                    return false;
                }
                
                // Gizli alanları güncelle
                // Update hidden fields
                $('#hiddenAdultCount').val(passengerCounts.adult);
                $('#hiddenChildCount').val(passengerCounts.child);
                $('#hiddenInfantCount').val(passengerCounts.infant);
                $('#hiddenCabinClass').val(selectedCabinClass);
                
                console.log('Form gönderiliyor...');
                return true;
            });
        });
    </script>
}
}