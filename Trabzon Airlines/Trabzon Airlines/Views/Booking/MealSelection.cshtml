@* Sayfa başlığı - ViewBag.Title ayarı *@
@* Page title - ViewBag.Title setting *@
@{
    ViewBag.Title = "Yemek Seçimi";
    ViewBag.TitleEn = "Meal Selection";
}

@* Styles bölümü - CSS dosyası ekleme *@
@* Styles section - Adding CSS file *@
@section styles {
    <link href="~/Content/css/meal-selection.css" rel="stylesheet" />
}

@* Ana container *@
@* Main container *@
<div class="meal-selection-page">
    <div class="container">
        @* Sayfa başlığı *@
        @* Page header *@
        <div class="page-header">
            <h1>
                <i class="fa-solid fa-utensils"></i>
                <span data-tr="🍽️ Uçuş Yemeği Seçimi" data-en="🍽️ Select Your In-Flight Meal">🍽️ Select Your In-Flight Meal</span>
            </h1>
            
            @* Uçuş bilgileri (ViewBag'den) *@
            @* Flight information (from ViewBag) *@
            @if (ViewBag.FlightNumber != null)
            {
                <div class="flight-info-box">
                    <p>
                        <strong data-tr="Uçuş:" data-en="Flight:">Uçuş:</strong> 
                        @(ViewBag.FlightNumber ?? "N/A")
                    </p>
                    <p>
                        <strong data-tr="Rota:" data-en="Route:">Rota:</strong> 
                        @(ViewBag.FromCode ?? "") → @(ViewBag.ToCode ?? "")
                    </p>
                    <p>
                        <strong data-tr="Kabin Sınıfı:" data-en="Cabin Class:">Kabin Sınıfı:</strong> 
                        @(ViewBag.CabinClass ?? "N/A")
                    </p>
                </div>
            }
        </div>

        @* Bilgi kutusu *@
        @* Information box *@
        <div class="info-alert">
            <p>
                <strong data-tr="ℹ️ Bilgi:" data-en="ℹ️ Information:">ℹ️ Information:</strong>
            </p>
            <p data-tr="Uçuşunuz için tercih ettiğiniz yemekleri seçebilirsiniz. Tüm yemekler ücretsizdir." data-en="You can select your preferred meals for your flight. All meals are free.">
                You can select your preferred meals for your flight. All meals are free.
            </p>
            <p data-tr="Birden fazla yemek seçebilirsiniz. Yemek seçmek istemiyorsanız, 'Yemek Seçimini Atla' butonuna tıklayarak devam edebilirsiniz." data-en="You can select multiple meals. If you prefer not to order any meals, click 'Skip Meal Selection' to continue.">
                You can select multiple meals. If you prefer not to order any meals, click 'Skip Meal Selection' to continue.
            </p>
        </div>

        @* Yemek seçim formu *@
        @* Meal selection form *@
        @using (Html.BeginForm("MealSelection", "Booking", FormMethod.Post))
        {
            @Html.AntiForgeryToken()
            
            @* Ana Yemekler - Main Courses *@
            <div class="category-section">
                <h2 class="category-title">
                    <i class="fa-solid fa-drumstick-bite"></i>
                    <span data-tr="🍖 Ana Yemekler" data-en="🍖 Main Courses">🍖 Main Courses</span>
                </h2>
                <div class="meal-grid">
                    @* Tavuklu Pilav - Chicken Rice *@
                    <div class="meal-card" onclick="toggleMeal(this)">
                        <input type="checkbox" name="selectedMeals" value="1" onclick="event.stopPropagation();" />
                        <img src="@Url.Content("~/assets/images/meals/chickenrice.jpg")" alt="Tavuklu Pilav" class="meal-image" onerror="this.style.display='none';" />
                        <div class="meal-content">
                            <div class="meal-name" data-tr="Tavuklu Pilav" data-en="Chicken Rice">Chicken Rice</div>
                            <div class="meal-description" data-tr="Lezzetli tavuk eti ve özel baharatlı pilav" data-en="Delicious chicken and special spiced rice">Delicious chicken and special spiced rice</div>
                            <span class="meal-free-badge" data-tr="ÜCRETSİZ" data-en="FREE">FREE</span>
                        </div>
                    </div>
                    
                    @* Köfte - Meatball *@
                    <div class="meal-card" onclick="toggleMeal(this)">
                        <input type="checkbox" name="selectedMeals" value="2" onclick="event.stopPropagation();" />
                        <img src="@Url.Content("~/assets/images/meals/meatballpasta.jpg")" alt="Köfte" class="meal-image" onerror="this.style.display='none';" />
                        <div class="meal-content">
                            <div class="meal-name" data-tr="Köfte" data-en="Meatball">Meatball</div>
                            <div class="meal-description" data-tr="Geleneksel Türk köftesi, patates ve salata ile" data-en="Traditional Turkish meatball with potatoes and salad">Traditional Turkish meatball with potatoes and salad</div>
                            <span class="meal-free-badge" data-tr="ÜCRETSİZ" data-en="FREE">FREE</span>
                        </div>
                    </div>
                    
                    @* Makarna - Pasta *@
                    <div class="meal-card" onclick="toggleMeal(this)">
                        <input type="checkbox" name="selectedMeals" value="3" onclick="event.stopPropagation();" />
                        <img src="@Url.Content("~/assets/images/meals/meatballpasta.jpg")" alt="Makarna" class="meal-image" onerror="this.style.display='none';" />
                        <div class="meal-content">
                            <div class="meal-name" data-tr="Makarna" data-en="Pasta">Pasta</div>
                            <div class="meal-description" data-tr="İtalyan usulü makarna, domates sosu ile" data-en="Italian style pasta with tomato sauce">Italian style pasta with tomato sauce</div>
                            <span class="meal-free-badge" data-tr="ÜCRETSİZ" data-en="FREE">FREE</span>
                        </div>
                    </div>
                    
                    @* Balık - Fish *@
                    <div class="meal-card" onclick="toggleMeal(this)">
                        <input type="checkbox" name="selectedMeals" value="4" onclick="event.stopPropagation();" />
                        <img src="@Url.Content("~/assets/images/meals/fish.jpg")" alt="Balık" class="meal-image" onerror="this.style.display='none';" />
                        <div class="meal-content">
                            <div class="meal-name" data-tr="Balık" data-en="Fish">Fish</div>
                            <div class="meal-description" data-tr="Taze balık, sebze garnitürü ile" data-en="Fresh fish with vegetable garnish">Fresh fish with vegetable garnish</div>
                            <span class="meal-free-badge" data-tr="ÜCRETSİZ" data-en="FREE">FREE</span>
                        </div>
                    </div>
                    
                    @* Vejetaryen Menü - Vegetarian Menu *@
                    <div class="meal-card" onclick="toggleMeal(this)">
                        <input type="checkbox" name="selectedMeals" value="5" onclick="event.stopPropagation();" />
                        <img src="@Url.Content("~/assets/images/meals/vegeterianmenu.jpg")" alt="Vejetaryen Menü" class="meal-image" onerror="this.style.display='none';" />
                        <div class="meal-content">
                            <div class="meal-name" data-tr="Vejetaryen Menü" data-en="Vegetarian Menu">Vegetarian Menu</div>
                            <div class="meal-description" data-tr="Taze sebzeler ve tahıl bazlı yemekler" data-en="Fresh vegetables and grain-based dishes">Fresh vegetables and grain-based dishes</div>
                            <span class="meal-free-badge" data-tr="ÜCRETSİZ" data-en="FREE">FREE</span>
                        </div>
                    </div>
                </div>
            </div>

            @* İçecekler - Beverages *@
            <div class="category-section">
                <h2 class="category-title">
                    <i class="fa-solid fa-glass-water"></i>
                    <span data-tr="🥤 İçecekler" data-en="🥤 Beverages">🥤 Beverages</span>
                </h2>
                <div class="meal-grid">
                    @* Su - Water *@
                    <div class="meal-card" onclick="toggleMeal(this)">
                        <input type="checkbox" name="selectedMeals" value="6" onclick="event.stopPropagation();" />
                        <img src="@Url.Content("~/assets/images/meals/su.jpg")" alt="Su" class="meal-image" onerror="this.style.display='none';" />
                        <div class="meal-content">
                            <div class="meal-name" data-tr="Su" data-en="Water">Water</div>
                            <div class="meal-description" data-tr="Doğal kaynak suyu" data-en="Natural spring water">Natural spring water</div>
                            <span class="meal-free-badge" data-tr="ÜCRETSİZ" data-en="FREE">FREE</span>
                        </div>
                    </div>
                    
                    @* Çay - Tea *@
                    <div class="meal-card" onclick="toggleMeal(this)">
                        <input type="checkbox" name="selectedMeals" value="7" onclick="event.stopPropagation();" />
                        <img src="@Url.Content("~/assets/images/meals/cay.jpg")" alt="Çay" class="meal-image" onerror="this.style.display='none';" />
                        <div class="meal-content">
                            <div class="meal-name" data-tr="Çay" data-en="Tea">Tea</div>
                            <div class="meal-description" data-tr="Sıcak Türk çayı" data-en="Hot Turkish tea">Hot Turkish tea</div>
                            <span class="meal-free-badge" data-tr="ÜCRETSİZ" data-en="FREE">FREE</span>
                        </div>
                    </div>
                    
                    @* Türk Kahvesi - Turkish Coffee *@
                    <div class="meal-card" onclick="toggleMeal(this)">
                        <input type="checkbox" name="selectedMeals" value="8" onclick="event.stopPropagation();" />
                        <img src="@Url.Content("~/assets/images/meals/turkkahvesi.jpg")" alt="Türk Kahvesi" class="meal-image" onerror="this.style.display='none';" />
                        <div class="meal-content">
                            <div class="meal-name" data-tr="Türk Kahvesi" data-en="Turkish Coffee">Turkish Coffee</div>
                            <div class="meal-description" data-tr="Geleneksel Türk kahvesi" data-en="Traditional Turkish coffee">Traditional Turkish coffee</div>
                            <span class="meal-free-badge" data-tr="ÜCRETSİZ" data-en="FREE">FREE</span>
                        </div>
                    </div>
                </div>
            </div>

            @* Tatlılar - Desserts *@
            <div class="category-section">
                <h2 class="category-title">
                    <i class="fa-solid fa-ice-cream"></i>
                    <span data-tr="🍰 Tatlılar" data-en="🍰 Desserts">🍰 Desserts</span>
                </h2>
                <div class="meal-grid">
                    @* Baklava - Baklava *@
                    <div class="meal-card" onclick="toggleMeal(this)">
                        <input type="checkbox" name="selectedMeals" value="9" onclick="event.stopPropagation();" />
                        <img src="@Url.Content("~/assets/images/meals/baklava.jpg")" alt="Baklava" class="meal-image" onerror="this.style.display='none';" />
                        <div class="meal-content">
                            <div class="meal-name" data-tr="Baklava" data-en="Baklava">Baklava</div>
                            <div class="meal-description" data-tr="Geleneksel Türk baklavası" data-en="Traditional Turkish baklava">Traditional Turkish baklava</div>
                            <span class="meal-free-badge" data-tr="ÜCRETSİZ" data-en="FREE">FREE</span>
                        </div>
                    </div>
                    
                    @* Sütlaç - Rice Pudding *@
                    <div class="meal-card" onclick="toggleMeal(this)">
                        <input type="checkbox" name="selectedMeals" value="10" onclick="event.stopPropagation();" />
                        <img src="@Url.Content("~/assets/images/meals/sutlac.jpg")" alt="Sütlaç" class="meal-image" onerror="this.style.display='none';" />
                        <div class="meal-content">
                            <div class="meal-name" data-tr="Sütlaç" data-en="Rice Pudding">Rice Pudding</div>
                            <div class="meal-description" data-tr="Ev yapımı sütlaç" data-en="Homemade rice pudding">Homemade rice pudding</div>
                            <span class="meal-free-badge" data-tr="ÜCRETSİZ" data-en="FREE">FREE</span>
                        </div>
                    </div>
                </div>
            </div>

            @* Aksiyon butonları *@
            @* Action buttons *@
            <div class="action-buttons">
                <button type="submit" class="btn-meal btn-meal-secondary" data-tr="Yemek Seçimini Atla" data-en="Skip Meal Selection">
                    Skip Meal Selection
                </button>
                <button type="submit" class="btn-meal btn-meal-primary" data-tr="Seçimi Onayla ve Devam Et" data-en="Confirm and Continue">
                    Confirm and Continue
                </button>
            </div>
        }
    </div>
</div>

@* Scripts bölümü - JavaScript kodları *@
@* Scripts section - JavaScript code *@
@section scripts {
    <script src="~/js/language.js"></script>
    <script>
        @* Yemek kartı toggle fonksiyonu *@
        @* Meal card toggle function *@
        function toggleMeal(card) {
            var checkbox = card.querySelector('input[type="checkbox"]');
            checkbox.checked = !checkbox.checked;

            if (checkbox.checked) {
                card.classList.add('selected');
            } else {
                card.classList.remove('selected');
            }
        }

        @* Sayfa yüklendiğinde dil ayarlarını uygula *@
        @* Apply language settings when page loads *@
        document.addEventListener('DOMContentLoaded', function() {
            if (typeof updatePageLanguage === 'function') {
                updatePageLanguage();
            }
        });

        @* Sayfa yüklendiğinde seçili yemekleri göster *@
        @* Show selected meals when page loads *@
        window.onload = function () {
            document.querySelectorAll('input[type="checkbox"]:checked').forEach(function(checkbox) {
                checkbox.closest('.meal-card').classList.add('selected');
            });
        };
    </script>
}
