@{
    ViewBag.Title = "Gizlilik Politikası";
}

@section styles {
    <link rel="stylesheet" href="~/Content/css/about.css">
}

<!-- PRIVACY HERO SECTION - Gizlilik Politikası ana bölümü -->
<section class="about-hero">
  <div class="container">
    <div class="about-hero-content">
      <!-- Ana başlık -->
      <h1 class="about-title" data-tr="Gizlilik Politikası ve KVKK Aydınlatma Metni" data-en="Privacy Policy and KVKK Disclosure">Gizlilik Politikası ve KVKK Aydınlatma Metni</h1>
      
      <!-- Alt başlık -->
      <p class="about-subtitle" data-tr="Kişisel verilerinizin korunması bizim için önemlidir" data-en="The protection of your personal data is important to us">
        Kişisel verilerinizin korunması bizim için önemlidir
      </p>
    </div>
  </div>
</section>

<!-- PRIVACY CONTENT SECTION - Gizlilik politikası içeriği -->
<section class="company-info" style="padding: 4rem 0;">
  <div class="container">
    <div class="info-grid" style="grid-template-columns: 1fr; gap: 2rem;">
      
      <!-- 1. Veri Sorumlusu -->
      <div class="info-card">
        <div class="info-icon">
          <i class="fa-solid fa-building"></i>
        </div>
        <h3 data-tr="1. Veri Sorumlusu" data-en="1. Data Controller">1. Veri Sorumlusu</h3>
        <p data-tr="6698 sayılı Kişisel Verilerin Korunması Kanunu ('KVKK') uyarınca, kişisel verileriniz Trabzon Airlines tarafından veri sorumlusu sıfatıyla işlenmektedir." 
           data-en="In accordance with Law No. 6698 on the Protection of Personal Data ('KVKK'), your personal data is processed by Trabzon Airlines as the data controller.">
          6698 sayılı Kişisel Verilerin Korunması Kanunu ('KVKK') uyarınca, kişisel verileriniz Trabzon Airlines tarafından veri sorumlusu sıfatıyla işlenmektedir.
        </p>
        <p style="margin-top: 1rem;" data-tr="İletişim: info@trabzonairlines.com" data-en="Contact: info@trabzonairlines.com">
          İletişim: info@trabzonairlines.com
        </p>
      </div>

      <!-- 2. İşlenen Kişisel Veriler -->
      <div class="info-card">
        <div class="info-icon">
          <i class="fa-solid fa-database"></i>
        </div>
        <h3 data-tr="2. İşlenen Kişisel Veriler" data-en="2. Processed Personal Data">2. İşlenen Kişisel Veriler</h3>
        <p data-tr="Aşağıdaki kişisel verileriniz işlenmektedir:" 
           data-en="The following personal data is processed:">
          Aşağıdaki kişisel verileriniz işlenmektedir:
        </p>
        <ul style="margin-top: 1rem; padding-left: 1.5rem; line-height: 1.8;">
          <li data-tr="Kimlik Bilgileri: Ad, soyad, TC kimlik numarası, doğum tarihi, cinsiyet" 
              data-en="Identity Information: Name, surname, Turkish ID number, date of birth, gender">
            Kimlik Bilgileri: Ad, soyad, TC kimlik numarası, doğum tarihi, cinsiyet
          </li>
          <li data-tr="İletişim Bilgileri: E-posta adresi, telefon numarası, adres" 
              data-en="Contact Information: Email address, phone number, address">
            İletişim Bilgileri: E-posta adresi, telefon numarası, adres
          </li>
          <li data-tr="Rezervasyon Bilgileri: Uçuş bilgileri, bilet numaraları, seyahat geçmişi" 
              data-en="Reservation Information: Flight information, ticket numbers, travel history">
            Rezervasyon Bilgileri: Uçuş bilgileri, bilet numaraları, seyahat geçmişi
          </li>
          <li data-tr="Finansal Bilgiler: Ödeme bilgileri, faturalama bilgileri" 
              data-en="Financial Information: Payment information, billing information">
            Finansal Bilgiler: Ödeme bilgileri, faturalama bilgileri
          </li>
        </ul>
      </div>

      <!-- 3. Kişisel Verilerin İşlenme Amaçları -->
      <div class="info-card">
        <div class="info-icon">
          <i class="fa-solid fa-bullseye"></i>
        </div>
        <h3 data-tr="3. Kişisel Verilerin İşlenme Amaçları" data-en="3. Purposes of Processing Personal Data">3. Kişisel Verilerin İşlenme Amaçları</h3>
        <p data-tr="Kişisel verileriniz aşağıdaki amaçlarla işlenmektedir:" 
           data-en="Your personal data is processed for the following purposes:">
          Kişisel verileriniz aşağıdaki amaçlarla işlenmektedir:
        </p>
        <ul style="margin-top: 1rem; padding-left: 1.5rem; line-height: 1.8;">
          <li data-tr="Uçuş rezervasyonlarının yapılması ve yönetilmesi" 
              data-en="Making and managing flight reservations">
            Uçuş rezervasyonlarının yapılması ve yönetilmesi
          </li>
          <li data-tr="Müşteri hizmetleri ve destek hizmetlerinin sunulması" 
              data-en="Providing customer service and support services">
            Müşteri hizmetleri ve destek hizmetlerinin sunulması
          </li>
          <li data-tr="Kampanya, promosyon ve fırsatlar hakkında bilgilendirme (izin verilmesi halinde)" 
              data-en="Informing about campaigns, promotions and opportunities (if consent is given)">
            Kampanya, promosyon ve fırsatlar hakkında bilgilendirme (izin verilmesi halinde)
          </li>
          <li data-tr="Yasal yükümlülüklerin yerine getirilmesi" 
              data-en="Fulfillment of legal obligations">
            Yasal yükümlülüklerin yerine getirilmesi
          </li>
          <li data-tr="Güvenlik ve hizmet kalitesinin artırılması" 
              data-en="Improving security and service quality">
            Güvenlik ve hizmet kalitesinin artırılması
          </li>
        </ul>
      </div>

      <!-- 4. Kişisel Verilerin Aktarılması -->
      <div class="info-card">
        <div class="info-icon">
          <i class="fa-solid fa-share-nodes"></i>
        </div>
        <h3 data-tr="4. Kişisel Verilerin Aktarılması" data-en="4. Transfer of Personal Data">4. Kişisel Verilerin Aktarılması</h3>
        <p data-tr="Kişisel verileriniz, yukarıda belirtilen amaçlar doğrultusunda, yasal yükümlülüklerimiz ve hizmet kalitesinin sağlanması amacıyla, sınırlı sayıda ve güvenilir üçüncü taraflarla paylaşılabilir. Verileriniz yurt dışına aktarılmamaktadır." 
           data-en="Your personal data may be shared with a limited number of reliable third parties in line with the purposes stated above, for the fulfillment of our legal obligations and ensuring service quality. Your data is not transferred abroad.">
          Kişisel verileriniz, yukarıda belirtilen amaçlar doğrultusunda, yasal yükümlülüklerimiz ve hizmet kalitesinin sağlanması amacıyla, sınırlı sayıda ve güvenilir üçüncü taraflarla paylaşılabilir. Verileriniz yurt dışına aktarılmamaktadır.
        </p>
      </div>

      <!-- 5. Kişisel Verilerin Saklanma Süresi -->
      <div class="info-card">
        <div class="info-icon">
          <i class="fa-solid fa-clock"></i>
        </div>
        <h3 data-tr="5. Kişisel Verilerin Saklanma Süresi" data-en="5. Retention Period of Personal Data">5. Kişisel Verilerin Saklanma Süresi</h3>
        <p data-tr="Kişisel verileriniz, işlenme amaçlarının gerektirdiği süre boyunca ve yasal saklama sürelerine uygun olarak saklanmaktadır. Bu süre sona erdiğinde, verileriniz yasalara uygun şekilde silinmekte veya anonim hale getirilmektedir." 
           data-en="Your personal data is stored for the period required by the processing purposes and in accordance with legal retention periods. When this period expires, your data is deleted or anonymized in accordance with the law.">
          Kişisel verileriniz, işlenme amaçlarının gerektirdiği süre boyunca ve yasal saklama sürelerine uygun olarak saklanmaktadır. Bu süre sona erdiğinde, verileriniz yasalara uygun şekilde silinmekte veya anonim hale getirilmektedir.
        </p>
      </div>

      <!-- 6. KVKK Kapsamındaki Haklarınız -->
      <div class="info-card">
        <div class="info-icon">
          <i class="fa-solid fa-user-shield"></i>
        </div>
        <h3 data-tr="6. KVKK Kapsamındaki Haklarınız" data-en="6. Your Rights Under KVKK">6. KVKK Kapsamındaki Haklarınız</h3>
        <p data-tr="KVKK'nın 11. maddesi uyarınca, aşağıdaki haklara sahipsiniz:" 
           data-en="In accordance with Article 11 of KVKK, you have the following rights:">
          KVKK'nın 11. maddesi uyarınca, aşağıdaki haklara sahipsiniz:
        </p>
        <ul style="margin-top: 1rem; padding-left: 1.5rem; line-height: 1.8;">
          <li data-tr="Kişisel verilerinizin işlenip işlenmediğini öğrenme" 
              data-en="Learning whether your personal data is processed">
            Kişisel verilerinizin işlenip işlenmediğini öğrenme
          </li>
          <li data-tr="İşlenmişse buna ilişkin bilgi talep etme" 
              data-en="Requesting information if processed">
            İşlenmişse buna ilişkin bilgi talep etme
          </li>
          <li data-tr="İşlenme amacını ve bunların amacına uygun kullanılıp kullanılmadığını öğrenme" 
              data-en="Learning the purpose of processing and whether they are used in accordance with this purpose">
            İşlenme amacını ve bunların amacına uygun kullanılıp kullanılmadığını öğrenme
          </li>
          <li data-tr="Yurt içinde veya yurt dışında aktarıldığı üçüncü kişileri bilme" 
              data-en="Knowing the third parties to whom it is transferred domestically or abroad">
            Yurt içinde veya yurt dışında aktarıldığı üçüncü kişileri bilme
          </li>
          <li data-tr="Eksik veya yanlış işlenmişse düzeltilmesini isteme" 
              data-en="Requesting correction if processed incompletely or incorrectly">
            Eksik veya yanlış işlenmişse düzeltilmesini isteme
          </li>
          <li data-tr="KVKK'da öngörülen şartlar çerçevesinde silinmesini veya yok edilmesini isteme" 
              data-en="Requesting deletion or destruction within the framework of the conditions stipulated in KVKK">
            KVKK'da öngörülen şartlar çerçevesinde silinmesini veya yok edilmesini isteme
          </li>
          <li data-tr="Aktarıldığı üçüncü kişilere yukarıdaki işlemlerin bildirilmesini isteme" 
              data-en="Requesting that the above operations be notified to third parties to whom it is transferred">
            Aktarıldığı üçüncü kişilere yukarıdaki işlemlerin bildirilmesini isteme
          </li>
          <li data-tr="İşlenen verilerin münhasıran otomatik sistemler ile analiz edilmesi suretiyle kişinin kendisi aleyhine bir sonucun ortaya çıkmasına itiraz etme" 
              data-en="Objecting to the emergence of a result against the person by analyzing the processed data exclusively through automated systems">
            İşlenen verilerin münhasıran otomatik sistemler ile analiz edilmesi suretiyle kişinin kendisi aleyhine bir sonucun ortaya çıkmasına itiraz etme
          </li>
          <li data-tr="Kişisel verilerin kanuna aykırı olarak işlenmesi sebebiyle zarara uğraması halinde zararın giderilmesini talep etme" 
              data-en="Requesting compensation for damages in case of damage due to processing of personal data in violation of the law">
            Kişisel verilerin kanuna aykırı olarak işlenmesi sebebiyle zarara uğraması halinde zararın giderilmesini talep etme
          </li>
        </ul>
      </div>

      <!-- 7. İletişim -->
      <div class="info-card">
        <div class="info-icon">
          <i class="fa-solid fa-envelope"></i>
        </div>
        <h3 data-tr="7. İletişim" data-en="7. Contact">7. İletişim</h3>
        <p data-tr="KVKK kapsamındaki haklarınızı kullanmak için aşağıdaki iletişim kanallarını kullanabilirsiniz:" 
           data-en="You can use the following contact channels to exercise your rights under KVKK:">
          KVKK kapsamındaki haklarınızı kullanmak için aşağıdaki iletişim kanallarını kullanabilirsiniz:
        </p>
        <p style="margin-top: 1rem;" data-tr="E-posta: kvkk@trabzonairlines.com" data-en="Email: kvkk@trabzonairlines.com">
          E-posta: kvkk@trabzonairlines.com
        </p>
        <p data-tr="Adres: Trabzon Havalimanı, Trabzon, Türkiye" data-en="Address: Trabzon Airport, Trabzon, Turkey">
          Adres: Trabzon Havalimanı, Trabzon, Türkiye
        </p>
      </div>

      <!-- 8. Güvenlik -->
      <div class="info-card">
        <div class="info-icon">
          <i class="fa-solid fa-shield-halved"></i>
        </div>
        <h3 data-tr="8. Güvenlik" data-en="8. Security">8. Güvenlik</h3>
        <p data-tr="Kişisel verilerinizin güvenliği için teknik ve idari tedbirler alınmaktadır. Verileriniz, yetkisiz erişim, değişiklik, ifşa veya imha riskine karşı korunmaktadır." 
           data-en="Technical and administrative measures are taken for the security of your personal data. Your data is protected against the risk of unauthorized access, modification, disclosure or destruction.">
          Kişisel verilerinizin güvenliği için teknik ve idari tedbirler alınmaktadır. Verileriniz, yetkisiz erişim, değişiklik, ifşa veya imha riskine karşı korunmaktadır.
        </p>
      </div>

      <!-- Son Güncelleme -->
      <div class="info-card" style="background: #f5f5f5; border: 1px solid #e0e0e0;">
        <p style="text-align: center; color: #666; font-size: 0.9rem;" data-tr="Son Güncelleme: @DateTime.Now.ToString("dd MMMM yyyy", new System.Globalization.CultureInfo("tr-TR"))" 
           data-en="Last Update: @DateTime.Now.ToString("MMMM dd, yyyy", new System.Globalization.CultureInfo("en-US"))">
          Son Güncelleme: @DateTime.Now.ToString("dd MMMM yyyy", new System.Globalization.CultureInfo("tr-TR"))
        </p>
      </div>

    </div>
  </div>
</section>

