@* Sayfa başlığı - ViewBag.Title ayarı *@
@* Page title - ViewBag.Title setting *@
@{
    ViewBag.Title = "Trip AI";
    ViewBag.TitleEn = "Trip AI";
}

@* Sayfa içeriği container'ı *@
@* Page content container *@
<div class="page-content">
    <div class="container">

        @* HERO / ÜST BÖLÜM - Ana başlık ve alt başlık *@
        @* HERO / TOP SECTION - Main title and subtitle *@
        <div class="support-page-header">
            <div class="page-header-content">
                <h1 class="page-title">
                    <i class="fa-solid fa-robot"></i>
                    <span data-tr="Trip AI – Akıllı Seyahat Planlayıcı" data-en="Trip AI – Smart Travel Planner">Trip AI – Akıllı Seyahat Planlayıcı</span>
                </h1>
                <p class="page-subtitle" data-tr="Sadece birkaç bilgi gir, senin için hazır planı gösterelim." data-en="Just enter a few details, and we'll show you a ready-made plan.">
                    Sadece birkaç bilgi gir, senin için hazır planı gösterelim.
                </p>
            </div>
        </div>

        @* FORM + SONUÇ BÖLÜMÜ - Form ve AI çıktı alanı *@
        @* FORM + RESULT SECTION - Form and AI output area *@
        <section class="tripai-main">

            @* Sol: Form kartı - Seyahat tercihleri formu *@
            @* Left: Form card - Travel preferences form *@
            <div class="tripai-form-card">
                @* Form başlığı - Çeviri desteği ile *@
                @* Form title - With translation support *@
                <h2 data-tr="Seyahat Tercihlerin" data-en="Your Travel Preferences">Seyahat Tercihlerin</h2>

                @* Şehir seçimi form grubu *@
                @* City selection form group *@
                <div class="tripai-form-group">
                    <label for="destinationSelect" data-tr="Şehir" data-en="City">Şehir</label>
                    <select id="destinationSelect" class="tripai-input">
                        <option value="" data-tr="Seçiniz" data-en="Select">Seçiniz</option>
                        <option value="antalya" data-tr="Antalya" data-en="Antalya">Antalya</option>
                        <option value="istanbul" data-tr="İstanbul" data-en="Istanbul">İstanbul</option>
                        <option value="izmir" data-tr="İzmir" data-en="Izmir">İzmir</option>
                        <option value="trabzon" data-tr="Trabzon" data-en="Trabzon">Trabzon</option>
                    </select>
                </div>

                @* Seyahat süresi seçimi form grubu *@
                @* Travel duration selection form group *@
                <div class="tripai-form-group">
                    <label for="durationSelect" data-tr="Seyahat Süresi" data-en="Travel Duration">Seyahat Süresi</label>
                    <select id="durationSelect" class="tripai-input">
                        <option value="" data-tr="Seçiniz" data-en="Select">Seçiniz</option>
                        <option value="2" data-tr="2 Gün" data-en="2 Days">2 Gün</option>
                        <option value="3" data-tr="3 Gün" data-en="3 Days">3 Gün</option>
                        <option value="5" data-tr="5 Gün" data-en="5 Days">5 Gün</option>
                        <option value="7" data-tr="7 Gün" data-en="7 Days">7 Gün</option>
                    </select>
                </div>

                @* Bütçe seçimi form grubu *@
                @* Budget selection form group *@
                <div class="tripai-form-group">
                    <label for="budgetSelect" data-tr="Bütçe" data-en="Budget">Bütçe</label>
                    <select id="budgetSelect" class="tripai-input">
                        <option value="" data-tr="Seçiniz" data-en="Select">Seçiniz</option>
                        <option value="ekonomik" data-tr="Ekonomik" data-en="Economy">Ekonomik</option>
                        <option value="orta" data-tr="Orta" data-en="Medium">Orta</option>
                        <option value="premium" data-tr="Premium" data-en="Premium">Premium</option>
                    </select>
                </div>

                @* İlgi alanı seçimi form grubu *@
                @* Interest area selection form group *@
                <div class="tripai-form-group">
                    <label for="interestSelect" data-tr="İlgi Alanı" data-en="Interest Area">İlgi Alanı</label>
                    <select id="interestSelect" class="tripai-input">
                        <option value="" data-tr="Seçiniz" data-en="Select">Seçiniz</option>
                        <option value="tarih" data-tr="Tarih & Kültür" data-en="History & Culture">Tarih & Kültür</option>
                        <option value="deniz" data-tr="Deniz & Plaj" data-en="Sea & Beach">Deniz & Plaj</option>
                        <option value="dogal" data-tr="Doğa & Manzara" data-en="Nature & Landscape">Doğa & Manzara</option>
                        <option value="alisveris" data-tr="Alışveriş & Şehir" data-en="Shopping & City">Alışveriş & Şehir</option>
                    </select>
                </div>

                @* Plan oluştur butonu - Çeviri desteği ile *@
                @* Create plan button - With translation support *@
                <button type="button" class="tripai-btn" onclick="generateTripPlan()">
                    <i class="fa-solid fa-wand-magic-sparkles"></i>
                    <span data-tr="Plan Oluştur" data-en="Create Plan">Plan Oluştur</span>
                </button>

                @* Bilgilendirme notu - Çeviri desteği ile *@
                @* Information note - With translation support *@
                <small class="tripai-note" data-tr="Bu sayfadaki tüm planlar örnek olarak önceden hazırlanmıştır." data-en="All plans on this page are pre-prepared as examples.">
                    Bu sayfadaki tüm planlar örnek olarak önceden hazırlanmıştır.
                </small>
            </div>

            @* Sağ: AI Çıktı Alanı - Trip AI sonuç kartı *@
            @* Right: AI Output Area - Trip AI result card *@
            <div class="tripai-result-card">
                @* Sonuç başlığı - AI etiketi ve durum *@
                @* Result header - AI label and status *@
                <div class="tripai-result-header">
                    <span class="tripai-ai-label" data-tr="Trip AI" data-en="Trip AI">Trip AI</span>
                    <span class="tripai-status" id="tripaiStatus" data-tr="Hazır" data-en="Ready">Hazır</span>
                </div>

                @* AI sohbet alanı - Mesajlar burada gösterilir *@
                @* AI chat area - Messages are displayed here *@
                <div id="tripResult" class="tripai-chat-area">
                    @* AI hoş geldin mesajı - Çeviri desteği ile *@
                    @* AI welcome message - With translation support *@
                    <div class="tripai-message ai">
                        <div class="bubble">
                            <p data-tr="Merhaba! Soldaki formdan seyahat bilgilerini seç, senin için hazır bir plan göstereyim." 
                               data-en="Hello! Select travel information from the form on the left, and I'll show you a ready-made plan.">
                                Merhaba! Soldaki formdan seyahat bilgilerini seç, senin için hazır bir plan göstereyim.
                            </p>
                        </div>
                    </div>
                </div>
            </div>

        </section>

    </div>
</div>

@* CSS stilleri bölümü - Trip AI CSS dosyası *@
@* CSS styles section - Trip AI CSS file *@
@section styles {
    @* Support CSS dosyası - Başlık için *@
    @* Support CSS file - For header *@
    <link href="~/Content/css/support.css" rel="stylesheet" />
    @* Trip AI CSS dosyası *@
    @* Trip AI CSS file *@
    <link href="~/Content/css/trip.css" rel="stylesheet" />
}

@* JavaScript scriptleri bölümü - Trip AI JavaScript dosyası *@
@* JavaScript scripts section - Trip AI JavaScript file *@
@section Scripts {
    @* Trip AI JavaScript dosyası *@
    @* Trip AI JavaScript file *@
    <script src="~/js/tripai.js"></script>
}
