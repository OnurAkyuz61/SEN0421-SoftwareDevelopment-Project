@* Sayfa başlığı - ViewBag.Title ayarı *@
@* Page title - ViewBag.Title setting *@
@{
    ViewBag.Title = "Hakkımızda";
    ViewBag.TitleEn = "About Us";
}

@section styles {
    <link rel="stylesheet" href="~/Content/css/about.css">
}

<!-- ABOUT HERO SECTION - Hakkımızda ana bölümü -->
<section class="about-hero">
  <div class="container">
    <div class="about-hero-content">
      <!-- Ana başlık -->
      <h1 class="about-title" data-tr="Trabzon Airlines Hakkında" data-en="About Trabzon Airlines">Trabzon Airlines Hakkında</h1>
      
      <!-- Alt başlık -->
      <p class="about-subtitle" data-tr="Karadeniz'in incisi Trabzon'dan dünyaya açılan kapınız" data-en="Your gateway to the world from Trabzon, the pearl of the Black Sea">
        Karadeniz'in incisi Trabzon'dan dünyaya açılan kapınız
      </p>
    </div>
  </div>
</section>

<!-- COMPANY INFO SECTION - Şirket bilgileri bölümü -->
<section class="company-info">
  <div class="container">
    <div class="info-grid">
      
      <!-- Misyonumuz -->
      <div class="info-card">
        <div class="info-icon">
          <i class="fa-solid fa-bullseye"></i>
        </div>
        <h3 data-tr="Misyonumuz" data-en="Our Mission">Misyonumuz</h3>
        <p data-tr="Trabzon ve çevresindeki yolcularımıza güvenli, konforlu ve uygun fiyatlı uçuş deneyimi sunmak. Karadeniz bölgesinin turizm ve ticaret potansiyelini dünyaya tanıtmak." 
           data-en="To provide safe, comfortable and affordable flight experience to our passengers in Trabzon and surrounding areas. To promote the tourism and trade potential of the Black Sea region to the world.">
          Trabzon ve çevresindeki yolcularımıza güvenli, konforlu ve uygun fiyatlı uçuş deneyimi sunmak. Karadeniz bölgesinin turizm ve ticaret potansiyelini dünyaya tanıtmak.
        </p>
      </div>

      <!-- Vizyonumuz -->
      <div class="info-card">
        <div class="info-icon">
          <i class="fa-solid fa-eye"></i>
        </div>
        <h3 data-tr="Vizyonumuz" data-en="Our Vision">Vizyonumuz</h3>
        <p data-tr="Karadeniz bölgesinin önde gelen havayolu şirketi olmak ve Trabzon'u önemli bir havacılık merkezi haline getirmek. Sürdürülebilir büyüme ile bölgesel kalkınmaya katkı sağlamak." 
           data-en="To become the leading airline of the Black Sea region and make Trabzon an important aviation hub. To contribute to regional development through sustainable growth.">
          Karadeniz bölgesinin önde gelen havayolu şirketi olmak ve Trabzon'u önemli bir havacılık merkezi haline getirmek. Sürdürülebilir büyüme ile bölgesel kalkınmaya katkı sağlamak.
        </p>
      </div>

      <!-- Değerlerimiz -->
      <div class="info-card">
        <div class="info-icon">
          <i class="fa-solid fa-heart"></i>
        </div>
        <h3 data-tr="Değerlerimiz" data-en="Our Values">Değerlerimiz</h3>
        <p data-tr="Güvenlik, müşteri memnuniyeti, çevre bilinci ve yerel kültüre saygı temel değerlerimizdir. Her uçuşta Karadeniz misafirperverliğini yaşatırız." 
           data-en="Safety, customer satisfaction, environmental awareness and respect for local culture are our core values. We bring Black Sea hospitality to every flight.">
          Güvenlik, müşteri memnuniyeti, çevre bilinci ve yerel kültüre saygı temel değerlerimizdir. Her uçuşta Karadeniz misafirperverliğini yaşatırız.
        </p>
      </div>

    </div>
  </div>
</section>

<!-- STATS SECTION - İstatistikler bölümü -->
<section class="stats-section">
  <div class="container">
    <h2 class="section-title" data-tr="Rakamlarla Trabzon Airlines" data-en="Trabzon Airlines by Numbers">Rakamlarla Trabzon Airlines</h2>
    
    <div class="stats-grid">
      
      <!-- Yolcu sayısı -->
      <div class="stat-item">
        <div class="stat-number">2.5M+</div>
        <div class="stat-label" data-tr="Mutlu Yolcu" data-en="Happy Passengers">Mutlu Yolcu</div>
      </div>

      <!-- Destinasyon sayısı -->
      <div class="stat-item">
        <div class="stat-number">45+</div>
        <div class="stat-label" data-tr="Destinasyon" data-en="Destinations">Destinasyon</div>
      </div>

      <!-- Filo büyüklüğü -->
      <div class="stat-item">
        <div class="stat-number">25</div>
        <div class="stat-label" data-tr="Modern Uçak" data-en="Modern Aircraft">Modern Uçak</div>
      </div>

      <!-- Deneyim yılı -->
      <div class="stat-item">
        <div class="stat-number">15+</div>
        <div class="stat-label" data-tr="Yıllık Deneyim" data-en="Years Experience">Yıllık Deneyim</div>
      </div>

    </div>
  </div>
</section>

<!-- TEAM SECTION - Ekip bölümü -->
<section class="team-section">
  <div class="container">
    <h2 class="section-title" data-tr="Ekibimiz" data-en="Our Team">Ekibimiz</h2>
    
    <div class="team-grid">
      
      <!-- CEO -->
      <div class="team-member">
        <div class="member-photo">
          <img src="~/assets/images/team/ceo.jpg" alt="CEO">
        </div>
        <h4 class="member-name">Mehmet Özkan</h4>
        <p class="member-title" data-tr="Genel Müdür" data-en="Chief Executive Officer">Genel Müdür</p>
        <p class="member-bio" data-tr="20 yıllık havacılık deneyimi ile Trabzon Airlines'ı başarıya taşıyor." 
           data-en="Leading Trabzon Airlines to success with 20 years of aviation experience.">
          20 yıllık havacılık deneyimi ile Trabzon Airlines'ı başarıya taşıyor.
        </p>
      </div>

      <!-- CTO -->
      <div class="team-member">
        <div class="member-photo">
          <img src="~/assets/images/team/cto.jpg" alt="CTO">
        </div>
        <h4 class="member-name">Ayşe Demir</h4>
        <p class="member-title" data-tr="Teknoloji Direktörü" data-en="Chief Technology Officer">Teknoloji Direktörü</p>
        <p class="member-bio" data-tr="Dijital dönüşüm ve yenilikçi çözümlerle müşteri deneyimini geliştiriyor." 
           data-en="Improving customer experience through digital transformation and innovative solutions.">
          Dijital dönüşüm ve yenilikçi çözümlerle müşteri deneyimini geliştiriyor.
        </p>
      </div>

      <!-- Operations Manager -->
      <div class="team-member">
        <div class="member-photo">
          <img src="~/assets/images/team/ops.jpg" alt="Operations Manager">
        </div>
        <h4 class="member-name">Ali Yılmaz</h4>
        <p class="member-title" data-tr="Operasyon Müdürü" data-en="Operations Manager">Operasyon Müdürü</p>
        <p class="member-bio" data-tr="Uçuş operasyonlarının güvenli ve zamanında gerçekleşmesini sağlıyor." 
           data-en="Ensuring flight operations are conducted safely and on time.">
          Uçuş operasyonlarının güvenli ve zamanında gerçekleşmesini sağlıyor.
        </p>
      </div>

    </div>
  </div>
</section>
