@model Trabzon_Airlines.Models.Deal

@{
    // Fırsat detay sayfası
    // Deal detail page
    ViewBag.Title = Model != null ? Model.Title : "Fırsat Detayı";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section styles {
    <link rel="stylesheet" href="~/Content/css/deal-detail.css">
}

@if (Model != null)
{
    <!-- FIRSAT DETAY HERO BÖLÜMÜ -->
    <!-- DEAL DETAIL HERO SECTION -->
    <section class="deal-detail-hero" style="background-image: url('@(string.IsNullOrEmpty(Model.ImageUrl) ? "https://images.unsplash.com/photo-1488646953014-85cb44e25828?w=1920&h=1080&fit=crop" : Model.ImageUrl)');">
        <div class="hero-overlay"></div>
        <div class="hero-content">
            <h1 class="hero-title">@Model.Title</h1>
            <div class="hero-meta">
                <span class="hero-discount">%@Model.DiscountPercentage İndirim</span>
                @if (!string.IsNullOrEmpty(Model.Badge))
                {
                    <span class="hero-badge">@Model.Badge</span>
                }
            </div>
        </div>
    </section>

    <!-- FIRSAT DETAY İÇERİK BÖLÜMÜ -->
    <!-- DEAL DETAIL CONTENT SECTION -->
    <section class="deal-detail-section">
        <div class="container">
            <div class="deal-detail-grid">
                <!-- Sol taraf - Detaylar -->
                <!-- Left side - Details -->
                <div class="deal-detail-main">
                    <!-- Fırsat açıklaması -->
                    <!-- Deal description -->
                    <div class="detail-card">
                        <h2 class="detail-card-title"><i class="fa-solid fa-info-circle"></i> Kampanya Hakkında</h2>
                        <p class="detail-description">@Model.Description</p>
                    </div>

                    <!-- Kampanya detayları -->
                    <!-- Campaign details -->
                    <div class="detail-card">
                        <h2 class="detail-card-title"><i class="fa-solid fa-calendar-alt"></i> Kampanya Detayları</h2>
                        <div class="campaign-details">
                            <div class="campaign-detail-item">
                                <i class="fa-solid fa-calendar-check"></i>
                                <div>
                                    <h4>Başlangıç Tarihi</h4>
                                    <p>@Model.StartDate.ToString("dd MMMM yyyy", new System.Globalization.CultureInfo("tr-TR"))</p>
                                </div>
                            </div>
                            <div class="campaign-detail-item">
                                <i class="fa-solid fa-calendar-times"></i>
                                <div>
                                    <h4>Bitiş Tarihi</h4>
                                    <p>@Model.EndDate.ToString("dd MMMM yyyy", new System.Globalization.CultureInfo("tr-TR"))</p>
                                </div>
                            </div>
                            @if (!string.IsNullOrEmpty(Model.CampaignCode))
                            {
                                <div class="campaign-detail-item">
                                    <i class="fa-solid fa-tag"></i>
                                    <div>
                                        <h4>Kampanya Kodu</h4>
                                        <p><strong>@Model.CampaignCode</strong></p>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>

                    <!-- Fırsat koşulları -->
                    <!-- Deal conditions -->
                    <div class="detail-card">
                        <h2 class="detail-card-title"><i class="fa-solid fa-list-check"></i> Kampanya Koşulları</h2>
                        <div class="conditions-list">
                            @if (Model.IsStudentDiscount)
                            {
                                <div class="condition-item">
                                    <i class="fa-solid fa-graduation-cap"></i>
                                    <span>Öğrenci indirimi geçerlidir</span>
                                </div>
                            }
                            @if (Model.IsFamilyDiscount)
                            {
                                <div class="condition-item">
                                    <i class="fa-solid fa-users"></i>
                                    <span>Aile indirimi geçerlidir (@(Model.MinPersonCount ?? 4)+ kişi)</span>
                                </div>
                            }
                            @if (Model.IsGroupDiscount)
                            {
                                <div class="condition-item">
                                    <i class="fa-solid fa-users"></i>
                                    <span>Grup indirimi geçerlidir (@(Model.MinPersonCount ?? 10)+ kişi)</span>
                                </div>
                            }
                            @if (Model.MinPersonCount.HasValue)
                            {
                                <div class="condition-item">
                                    <i class="fa-solid fa-user-group"></i>
                                    <span>Minimum @Model.MinPersonCount.Value kişi gereklidir</span>
                                </div>
                            }
                        </div>
                    </div>
                </div>

                <!-- Sağ taraf - Rezervasyon kartı -->
                <!-- Right side - Booking card -->
                <div class="deal-booking-sidebar">
                    <div class="booking-card">
                        <h3 class="booking-card-title">Fırsatı Kaçırma</h3>
                        
                        <div class="booking-discount">
                            <div class="discount-percentage">%@Model.DiscountPercentage</div>
                            <div class="discount-label">İndirim</div>
                        </div>

                        <div class="booking-info">
                            <div class="booking-info-item">
                                <i class="fa-solid fa-calendar"></i>
                                <span>@Model.StartDate.ToString("dd.MM.yyyy") - @Model.EndDate.ToString("dd.MM.yyyy")</span>
                            </div>
                            @if (!string.IsNullOrEmpty(Model.CampaignCode))
                            {
                                <div class="booking-info-item">
                                    <i class="fa-solid fa-tag"></i>
                                    <span>Kod: @Model.CampaignCode</span>
                                </div>
                            }
                        </div>

                        <button class="booking-btn" onclick="window.location.href='@Url.Action("Login", "Home")'">
                            <i class="fa-solid fa-bolt"></i>
                            Hemen Rezervasyon Yap
                        </button>

                        <div class="booking-features">
                            <div class="booking-feature">
                                <i class="fa-solid fa-shield-halved"></i>
                                <span>Güvenli Ödeme</span>
                            </div>
                            <div class="booking-feature">
                                <i class="fa-solid fa-clock"></i>
                                <span>Sınırlı Süre</span>
                            </div>
                            <div class="booking-feature">
                                <i class="fa-solid fa-headset"></i>
                                <span>7/24 Destek</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
}
else
{
    <!-- Fırsat bulunamadı -->
    <!-- Deal not found -->
    <section class="deal-detail-section">
        <div class="container">
            <div style="text-align: center; padding: 4rem 2rem;">
                <i class="fa-solid fa-exclamation-triangle" style="font-size: 4rem; color: var(--gray); margin-bottom: 1rem;"></i>
                <h2 style="color: var(--gray); margin-bottom: 0.5rem;">Fırsat bulunamadı</h2>
                <p style="color: var(--gray);">Aradığınız fırsat mevcut değil veya süresi dolmuş olabilir.</p>
                <a href="@Url.Action("Deals", "Home")" class="admin-btn" style="margin-top: 2rem;">
                    <i class="fa-solid fa-arrow-left"></i> Fırsatlara Dön
                </a>
            </div>
        </div>
    </section>
}

