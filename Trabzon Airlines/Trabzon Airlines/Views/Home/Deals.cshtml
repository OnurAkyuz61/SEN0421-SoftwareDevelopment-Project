@{
    ViewBag.Title = "Fırsatlar";
    ViewBag.TitleEn = "Deals";
}

<div class="page-content">

    <!-- ================== HERO ================== -->
    <section style="
        background: linear-gradient(135deg, #e4002b, #c20025);
        color: white;
        padding: 3rem 1rem;
        border-radius: 16px;
        text-align: center;
        margin-bottom: 3rem;
    ">
        <h1 style="font-size:2.5rem; margin-bottom:0.5rem;" data-tr="Özel Fırsatlar" data-en="Special Offers">Özel Fırsatlar</h1>
        <p style="opacity:0.9; max-width:600px; margin:auto;" data-tr="Trabzon Airlines yolcularına özel indirim ve ayrıcalıkları keşfet" data-en="Discover special discounts and privileges for Trabzon Airlines passengers">
            Trabzon Airlines yolcularına özel indirim ve ayrıcalıkları keşfet
        </p>
    </section>

    <!-- ================== FIRSATLAR ================== -->
    <section class="offers-section">

        <div style="
            display:grid;
            grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
            gap:2rem;
        ">

            <!-- STARBUCKS -->
            <div class="offer-card">
                <div class="offer-badge" data-tr="%20 İndirim" data-en="20% Off">%20 İndirim</div>
                <h3>Starbucks</h3>
                <p>
                    <span data-tr="Trabzon Airlines biletini göster, Starbucks'ta yapacağın tüm alışverişlerde" data-en="Show your Trabzon Airlines ticket and get">Trabzon Airlines biletini göster, Starbucks'ta yapacağın tüm alışverişlerde</span>
                    <strong data-tr="%20 indirim" data-en="20% discount">%20 indirim</strong>
                    <span data-tr="kazan." data-en="on all purchases.">kazan.</span>
                </p>
                <small data-tr="* Kampanya seçili mağazalarda geçerlidir." data-en="* Campaign is valid at selected stores.">* Kampanya seçili mağazalarda geçerlidir.</small>
            </div>

            <!-- OTEL -->
            <div class="offer-card">
                <div class="offer-badge" data-tr="₺500 İndirim" data-en="₺500 Off">₺500 İndirim</div>
                <h3 data-tr="Elite Oteller" data-en="Elite Hotels">Elite Oteller</h3>
                <p>
                    <span data-tr="Trabzon Airlines yolcularına özel," data-en="Special for Trabzon Airlines passengers,">Trabzon Airlines yolcularına özel,</span>
                    <span data-tr="2 gece ve üzeri konaklamalarda" data-en="for stays of 2 nights or more">2 gece ve üzeri konaklamalarda</span>
                    <strong data-tr="₺500 indirim" data-en="₺500 discount">₺500 indirim</strong>
                    <span data-tr="." data-en=".">.</span>
                </p>
                <small data-tr="* Rezervasyon sırasında uçuş kodu gereklidir." data-en="* Flight code is required during reservation.">* Rezervasyon sırasında uçuş kodu gereklidir.</small>
            </div>

            <!-- ARAÇ KİRALAMA -->
            <div class="offer-card">
                <div class="offer-badge" data-tr="%15 İndirim" data-en="15% Off">%15 İndirim</div>
                <h3>Rento Car Rental</h3>
                <p>
                    <span data-tr="Uçuşunu tamamla, Rento'dan araç kirala." data-en="Complete your flight, rent a car from Rento.">Uçuşunu tamamla, Rento'dan araç kirala.</span>
                    <span data-tr="Tüm araçlarda" data-en="On all vehicles">Tüm araçlarda</span>
                    <strong data-tr="%15 indirim" data-en="15% discount">%15 indirim</strong>
                    <span data-tr="." data-en=".">.</span>
                </p>
                <small data-tr="* Havalimanı ofislerinde geçerlidir." data-en="* Valid at airport offices.">* Havalimanı ofislerinde geçerlidir.</small>
            </div>

            <!-- LOUNGE -->
            <div class="offer-card">
                <div class="offer-badge" data-tr="Ücretsiz" data-en="Free">Ücretsiz</div>
                <h3 data-tr="Airport Lounge" data-en="Airport Lounge">Airport Lounge</h3>
                <p>
                    <span data-tr="Business Class yolcularımıza" data-en="For our Business Class passengers">Business Class yolcularımıza</span>
                    <strong data-tr="ücretsiz lounge erişimi" data-en="free lounge access">ücretsiz lounge erişimi</strong>
                    <span data-tr="." data-en=".">.</span>
                </p>
                <small data-tr="* İç hatlar uçuşları için geçerlidir." data-en="* Valid for domestic flights.">* İç hatlar uçuşları için geçerlidir.</small>
            </div>

        </div>

    </section>

</div>

<!-- ================== SAYFAYA ÖZEL CSS ================== -->
<style>
    .offer-card {
        position: relative;
        background: #ffffff;
        padding: 2rem;
        border-radius: 16px;
        box-shadow: 0 10px 30px rgba(0,0,0,0.1);
        transition: transform .3s, box-shadow .3s;
    }

        .offer-card:hover {
            transform: translateY(-8px);
            box-shadow: 0 18px 40px rgba(0,0,0,0.15);
        }

        .offer-card h3 {
            margin-bottom: 0.75rem;
            color: #e4002b;
        }

        .offer-card p {
            color: #555;
            line-height: 1.6;
            margin-bottom: 1rem;
        }

        .offer-card small {
            color: #888;
        }

    .offer-badge {
        position: absolute;
        top: 1rem;
        right: 1rem;
        background: #e4002b;
        color: white;
        padding: 0.4rem 0.8rem;
        border-radius: 20px;
        font-size: 0.75rem;
        font-weight: 600;
    }
</style>

