@* Sayfa başlığı - ViewBag.Title ayarı *@
@* Page title - ViewBag.Title setting *@
@{
    ViewBag.Title = "İletişim";
    ViewBag.TitleEn = "Contact";
}

@section styles {
    <link rel="stylesheet" href="~/Content/css/contact.css">
}

<!-- CONTACT HERO SECTION - İletişim ana bölümü -->
<section class="contact-hero">
  <div class="container">
    <div class="contact-hero-content">
      <!-- Ana başlık -->
      <h1 class="contact-title" data-tr="Bizimle İletişime Geçin" data-en="Get in Touch with Us">Bizimle İletişime Geçin</h1>
      
      <!-- Alt başlık -->
      <p class="contact-subtitle" data-tr="Sorularınız, önerileriniz veya şikayetleriniz için bize ulaşın" data-en="Contact us for your questions, suggestions or complaints">
        Sorularınız, önerileriniz veya şikayetleriniz için bize ulaşın
      </p>
    </div>
  </div>
</section>

<!-- CONTACT INFO SECTION - İletişim bilgileri bölümü -->
<section class="contact-info">
  <div class="container">
    <div class="contact-grid">
      
      <!-- İletişim kartları -->
      <div class="contact-cards">
        
        <!-- Telefon -->
        <div class="contact-card">
          <div class="contact-icon">
            <i class="fa-solid fa-phone"></i>
          </div>
          <h3 data-tr="Telefon" data-en="Phone">Telefon</h3>
          <p data-tr="7/24 Müşteri Hizmetleri" data-en="24/7 Customer Service">7/24 Müşteri Hizmetleri</p>
          <a href="tel:+904622300000" class="contact-link">+90 (462) 230 00 00</a>
        </div>

        <!-- E-posta -->
        <div class="contact-card">
          <div class="contact-icon">
            <i class="fa-solid fa-envelope"></i>
          </div>
          <h3 data-tr="E-posta" data-en="Email">E-posta</h3>
          <p data-tr="Genel Bilgi ve Destek" data-en="General Information and Support">Genel Bilgi ve Destek</p>
          <a href="mailto:info@trabzonairlines.com" class="contact-link">info@trabzonairlines.com</a>
        </div>

        <!-- Adres -->
        <div class="contact-card">
          <div class="contact-icon">
            <i class="fa-solid fa-map-marker-alt"></i>
          </div>
          <h3 data-tr="Adres" data-en="Address">Adres</h3>
          <p data-tr="Genel Merkez" data-en="Headquarters">Genel Merkez</p>
          <address class="contact-address" data-tr="Trabzon Havalimanı, 61000 Trabzon, Türkiye" data-en="Trabzon Airport, 61000 Trabzon, Turkey">
            Trabzon Havalimanı, 61000 Trabzon, Türkiye
          </address>
        </div>

        <!-- Çalışma Saatleri -->
        <div class="contact-card">
          <div class="contact-icon">
            <i class="fa-solid fa-clock"></i>
          </div>
          <h3 data-tr="Çalışma Saatleri" data-en="Working Hours">Çalışma Saatleri</h3>
          <p data-tr="Ofis Saatleri" data-en="Office Hours">Ofis Saatleri</p>
          <div class="working-hours">
            <p data-tr="Pazartesi - Cuma: 08:00 - 18:00" data-en="Monday - Friday: 08:00 - 18:00">Pazartesi - Cuma: 08:00 - 18:00</p>
            <p data-tr="Cumartesi: 09:00 - 17:00" data-en="Saturday: 09:00 - 17:00">Cumartesi: 09:00 - 17:00</p>
            <p data-tr="Pazar: Kapalı" data-en="Sunday: Closed">Pazar: Kapalı</p>
          </div>
        </div>

      </div>

      <!-- İletişim formu -->
      <div class="contact-form-container">
        <h2 class="form-title" data-tr="Mesaj Gönderin" data-en="Send Message">Mesaj Gönderin</h2>
        
        <form class="contact-form" id="contactForm" onsubmit="submitContactForm(event); return false;">
          
          <!-- Ad Soyad -->
          <div class="form-group">
            <label for="fullName" data-tr="Ad Soyad *" data-en="Full Name *">Ad Soyad *</label>
            <input type="text" id="fullName" name="fullName" required 
                   placeholder="Adınızı ve soyadınızı girin" 
                   data-placeholder-tr="Adınızı ve soyadınızı girin" 
                   data-placeholder-en="Enter your full name">
          </div>

          <!-- E-posta -->
          <div class="form-group">
            <label for="email" data-tr="E-posta Adresi *" data-en="Email Address *">E-posta Adresi *</label>
            <input type="email" id="email" name="email" required 
                   placeholder="ornek@email.com" 
                   data-placeholder-tr="ornek@email.com" 
                   data-placeholder-en="example@email.com">
          </div>

          <!-- Telefon -->
          <div class="form-group">
            <label for="phone" data-tr="Telefon Numarası" data-en="Phone Number">Telefon Numarası</label>
            <input type="tel" id="phone" name="phone" 
                   placeholder="+90 5XX XXX XX XX" 
                   data-placeholder-tr="+90 5XX XXX XX XX" 
                   data-placeholder-en="+90 5XX XXX XX XX">
          </div>

          <!-- Konu -->
          <div class="form-group">
            <label for="subject" data-tr="Konu *" data-en="Subject *">Konu *</label>
            <select id="subject" name="subject" required>
              <option value="" data-tr="Konu seçin" data-en="Select subject">Konu seçin</option>
              <option value="reservation" data-tr="Rezervasyon" data-en="Reservation">Rezervasyon</option>
              <option value="complaint" data-tr="Şikayet" data-en="Complaint">Şikayet</option>
              <option value="suggestion" data-tr="Öneri" data-en="Suggestion">Öneri</option>
              <option value="lost-found" data-tr="Kayıp Eşya" data-en="Lost & Found">Kayıp Eşya</option>
              <option value="refund" data-tr="İade Talebi" data-en="Refund Request">İade Talebi</option>
              <option value="other" data-tr="Diğer" data-en="Other">Diğer</option>
            </select>
          </div>

          <!-- Rezervasyon Numarası -->
          <div class="form-group">
            <label for="reservationNumber" data-tr="Rezervasyon Numarası" data-en="Reservation Number">Rezervasyon Numarası</label>
            <input type="text" id="reservationNumber" name="reservationNumber" 
                   placeholder="TZX123456" 
                   data-placeholder-tr="TZX123456" 
                   data-placeholder-en="TZX123456">
          </div>

          <!-- Mesaj -->
          <div class="form-group">
            <label for="message" data-tr="Mesajınız *" data-en="Your Message *">Mesajınız *</label>
            <textarea id="message" name="message" rows="5" required 
                      placeholder="Mesajınızı buraya yazın..." 
                      data-placeholder-tr="Mesajınızı buraya yazın..." 
                      data-placeholder-en="Write your message here..."></textarea>
          </div>

          <!-- KVKK Onayı -->
          <div class="form-group checkbox-group">
            <input type="checkbox" id="kvkk" name="kvkk" required>
            <label for="kvkk" class="checkbox-label">
              <span data-tr="Kişisel verilerimin işlenmesine ve " data-en="I agree to the processing of my personal data and ">Kişisel verilerimin işlenmesine ve </span>
              <a href="#" onclick="showComingSoonAlert('privacy'); return false;" data-tr="KVKK Aydınlatma Metni" data-en="Privacy Policy">KVKK Aydınlatma Metni</a>
              <span data-tr="'ni okuduğumu kabul ediyorum. *" data-en=" and confirm that I have read it. *">'ni okuduğumu kabul ediyorum. *</span>
            </label>
          </div>

          <!-- Gönder butonu -->
          <button type="submit" class="submit-btn" data-tr="Mesajı Gönder" data-en="Send Message">
            <i class="fa-solid fa-paper-plane"></i>
            <span data-tr="Mesajı Gönder" data-en="Send Message">Mesajı Gönder</span>
          </button>

        </form>
      </div>

    </div>
  </div>
</section>

<!-- FAQ SECTION - Sık sorulan sorular bölümü -->
<section class="faq-section">
  <div class="container">
    <h2 class="section-title" data-tr="Sık Sorulan Sorular" data-en="Frequently Asked Questions">Sık Sorulan Sorular</h2>
    
    <div class="faq-container">
      
      <!-- FAQ öğesi 1 -->
      <div class="faq-item">
        <button class="faq-question" onclick="toggleFaq(1)">
          <span data-tr="Rezervasyon nasıl yapabilirim?" data-en="How can I make a reservation?">Rezervasyon nasıl yapabilirim?</span>
          <i class="fa-solid fa-chevron-down"></i>
        </button>
        <div class="faq-answer" id="faq-1">
          <p data-tr="Web sitemizden, mobil uygulamamızdan veya çağrı merkezimizi arayarak rezervasyon yapabilirsiniz. Online rezervasyon 7/24 hizmet vermektedir." 
             data-en="You can make reservations through our website, mobile app, or by calling our call center. Online reservation is available 24/7.">
            Web sitemizden, mobil uygulamamızdan veya çağrı merkezimizi arayarak rezervasyon yapabilirsiniz. Online rezervasyon 7/24 hizmet vermektedir.
          </p>
        </div>
      </div>

      <!-- FAQ öğesi 2 -->
      <div class="faq-item">
        <button class="faq-question" onclick="toggleFaq(2)">
          <span data-tr="Bagaj hakkım nedir?" data-en="What is my baggage allowance?">Bagaj hakkım nedir?</span>
          <i class="fa-solid fa-chevron-down"></i>
        </button>
        <div class="faq-answer" id="faq-2">
          <p data-tr="Ekonomi sınıfında 20 kg, business sınıfında 30 kg bagaj hakkınız bulunmaktadır. Kabin bagajı için 8 kg sınırı vardır." 
             data-en="You have 20 kg baggage allowance in economy class and 30 kg in business class. Cabin baggage limit is 8 kg.">
            Ekonomi sınıfında 20 kg, business sınıfında 30 kg bagaj hakkınız bulunmaktadır. Kabin bagajı için 8 kg sınırı vardır.
          </p>
        </div>
      </div>

      <!-- FAQ öğesi 3 -->
      <div class="faq-item">
        <button class="faq-question" onclick="toggleFaq(3)">
          <span data-tr="Check-in işlemini ne zaman yapabilirim?" data-en="When can I check-in?">Check-in işlemini ne zaman yapabilirim?</span>
          <i class="fa-solid fa-chevron-down"></i>
        </button>
        <div class="faq-answer" id="faq-3">
          <p data-tr="Online check-in uçuştan 24 saat önce açılır ve kalkıştan 2 saat öncesine kadar yapılabilir. Havalimanında check-in kalkıştan 3 saat önce başlar." 
             data-en="Online check-in opens 24 hours before flight and can be done until 2 hours before departure. Airport check-in starts 3 hours before departure.">
            Online check-in uçuştan 24 saat önce açılır ve kalkıştan 2 saat öncesine kadar yapılabilir. Havalimanında check-in kalkıştan 3 saat önce başlar.
          </p>
        </div>
      </div>

      <!-- FAQ öğesi 4 -->
      <div class="faq-item">
        <button class="faq-question" onclick="toggleFaq(4)">
          <span data-tr="İptal ve değişiklik koşulları nelerdir?" data-en="What are the cancellation and change conditions?">İptal ve değişiklik koşulları nelerdir?</span>
          <i class="fa-solid fa-chevron-down"></i>
        </button>
        <div class="faq-answer" id="faq-4">
          <p data-tr="Bilet türüne göre değişiklik ve iptal koşulları farklılık gösterir. Esnek biletlerde ücretsiz değişiklik hakkı bulunmaktadır. Detaylar için satış koşullarını inceleyebilirsiniz." 
             data-en="Change and cancellation conditions vary according to ticket type. Flexible tickets include free change rights. You can review the terms of sale for details.">
            Bilet türüne göre değişiklik ve iptal koşulları farklılık gösterir. Esnek biletlerde ücretsiz değişiklik hakkı bulunmaktadır. Detaylar için satış koşullarını inceleyebilirsiniz.
          </p>
        </div>
      </div>

    </div>
  </div>
</section>
