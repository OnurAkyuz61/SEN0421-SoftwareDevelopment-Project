@{
    ViewBag.Title = "Check-In";
    ViewBag.TitleEn = "Check-In";
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title data-tr="Check-In - Trabzon Airlines" data-en="Check-In - Trabzon Airlines">Check-In - Trabzon Airlines</title>
    <link href="~/Content/css/checkin-index.css" rel="stylesheet" />
</head>
<body>
    <div class="container">
        <div class="header">
            <div class="emoji">🎫</div>
            <h1 data-tr="Online Check-In" data-en="Online Check-In">Online Check-In</h1>
            <p data-tr="PNR kodunuzu girerek check-in yapın" data-en="Enter your PNR code to check in">Enter your PNR code to check in</p>
        </div>

        <div class="content" id="checkinContent">

            <div class="info-box">
                <p><strong data-tr="ℹ️ Bilgi:" data-en="ℹ️ Information:">ℹ️ Information:</strong></p>
                <p data-tr="PNR kodunuzu rezervasyon onay e-postanızda bulabilirsiniz." data-en="You can find your PNR code in your booking confirmation email.">You can find your PNR code in your booking confirmation.</p>
                <p data-tr="Check-in, kalkıştan 24 saat önce açılır." data-en="Check-in opens 24 hours before departure.">Check-in opens 24 hours before departure.</p>
            </div>

            @using (Html.BeginForm("SearchBooking", "CheckIn", FormMethod.Post))
            {
                @Html.AntiForgeryToken()

                <div class="form-group">
                    <label for="pnrCode" data-tr="PNR Kodu:" data-en="PNR Code:">PNR Code:</label>
                    <input type="text"
                           id="pnrCode"
                           name="pnrCode"
                           data-placeholder-tr="6 haneli PNR kodunu girin"
                           data-placeholder-en="Enter 6-digit PNR code"
                           placeholder="Enter 6-digit PNR code"
                           maxlength="6"
                           required
                           autofocus />
                </div>

                <button type="submit" class="btn" data-tr="Rezervasyonumu Bul" data-en="Find My Booking">Find My Booking</button>
            }
        </div>
    </div>

    <script src="~/js/language.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            updatePageLanguage();
            
            // TempData mesajlarını dil kontrolü ile göster
            var currentLang = localStorage.getItem('language') || 'tr';
            var contentDiv = document.getElementById('checkinContent');
            
            @if (TempData["Error"] != null || TempData["Error_en"] != null)
            {
                <text>
                var message = currentLang === 'en' && '@TempData["Error_en"]' ? '@TempData["Error_en"]' : '@TempData["Error"]';
                if (message && message !== '') {
                    var alertDiv = document.createElement('div');
                    alertDiv.className = 'alert alert-error';
                    alertDiv.innerHTML = '⚠️ ' + message;
                    contentDiv.insertBefore(alertDiv, contentDiv.firstChild);
                }
                </text>
            }
        });
    </script>
</body>
</html>

