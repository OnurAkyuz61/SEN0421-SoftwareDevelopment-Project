@model Trabzon_Airlines.Models.Booking
@using System.Linq

@{
    ViewBag.Title = "Boarding Pass";
    ViewBag.TitleEn = "Boarding Pass";
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title data-tr="Biniş Kartı - Trabzon Airlines" data-en="Boarding Pass - Trabzon Airlines">Boarding Pass - Trabzon Airlines</title>
    <link href="~/Content/css/checkin-boarding-pass.css" rel="stylesheet" />
</head>
<body>
    <div class="container">
        <div class="header">
            <div class="success-icon">✅</div>
            <h1 data-tr="Check-In Başarılı!" data-en="Check-In Successful!">Check-In Successful!</h1>
            <p data-tr="Biniş kartınız hazır" data-en="Your boarding pass is ready">Your boarding pass is ready</p>
            <div class="status-badge">
                <span data-tr="✓ Check-In Yapıldı - " data-en="✓ Checked In - ">✓ Checked In - </span>@Model.CheckInTime?.ToString("dd MMM yyyy HH:mm")
            </div>
        </div>

        <div class="boarding-pass">
            <div class="bp-header">
                <div class="airline-name">🛫 TRABZON AIRLINES</div>
                <p data-tr="Biniş Kartı" data-en="Boarding Pass">Boarding Pass</p>
            </div>

            <div class="bp-content">
                <div class="route-section">
                    <div class="city">
                        <div class="city-code">@Model.Flight.FromCode</div>
                        <div class="city-name" data-tr="Kalkış" data-en="Departure">Departure</div>
                    </div>
                    <div class="arrow">✈️</div>
                    <div class="city">
                        <div class="city-code">@Model.Flight.ToCode</div>
                        <div class="city-name" data-tr="Varış" data-en="Arrival">Arrival</div>
                    </div>
                </div>

                <div class="details-grid">
                    <div class="detail-box">
                        <div class="detail-label" data-tr="Yolcu" data-en="Passenger">Passenger</div>
                        <div class="detail-value">@Model.PassengerName @Model.PassengerSurname</div>
                    </div>
                    <div class="detail-box">
                        <div class="detail-label" data-tr="Uçuş" data-en="Flight">Flight</div>
                        <div class="detail-value">@Model.Flight.FlightNumber</div>
                    </div>
                    <div class="detail-box">
                        <div class="detail-label" data-tr="Kalkış" data-en="Departure">Departure</div>
                        <div class="detail-value">@Model.Flight.DepartureTime.ToString("dd MMM HH:mm")</div>
                    </div>
                    <div class="detail-box">
                        <div class="detail-label" data-tr="Varış" data-en="Arrival">Arrival</div>
                        <div class="detail-value">@Model.Flight.ArrivalTime.ToString("dd MMM HH:mm")</div>
                    </div>
                    <div class="detail-box">
                        <div class="detail-label" data-tr="Koltuk" data-en="Seat">Seat</div>
                        <div class="detail-value">@Model.Seat.SeatNumber</div>
                    </div>
                    <div class="detail-box">
                        <div class="detail-label" data-tr="Sınıf" data-en="Class">Class</div>
                        <div class="detail-value">@Model.Seat.CabinClass</div>
                    </div>
                </div>

                <div class="qr-section">
                    <div class="qr-code">
                        📱
                    </div>
                    <p style="color: #666; margin-bottom: 10px;" data-tr="Biniş kapısında taratın" data-en="Scan at boarding gate">Scan at boarding gate</p>
                    <div class="pnr-large">@Model.PNR</div>
                </div>

                <div class="important-info">
                    <p><strong data-tr="⚠️ Önemli Bilgiler:" data-en="⚠️ Important Information:">⚠️ Important Information:</strong></p>
                    <p data-tr="• Lütfen kalkıştan 30 dakika önce kapıda olun" data-en="• Please arrive at the gate 30 minutes before departure">• Please arrive at the gate 30 minutes before departure</p>
                    <p data-tr="• Biniş kalkıştan 15 dakika önce kapanır" data-en="• Boarding closes 15 minutes before departure">• Boarding closes 15 minutes before departure</p>
                    <p data-tr="• Bu biniş kartını her zaman yanınızda bulundurun" data-en="• Keep this boarding pass with you at all times">• Keep this boarding pass with you at all times</p>
                    @if (Model.BookingMeals != null && Model.BookingMeals.Any())
                    {
                        <p data-tr="• Uçuş yemekleriniz önceden sipariş edilmiştir" data-en="• Your in-flight meals have been pre-ordered">• Your in-flight meals have been pre-ordered</p>
                    }
                </div>
            </div>
        </div>

        <div class="action-buttons" style="margin: 0 30px 30px 30px;">
            <button onclick="window.print()" class="btn btn-primary" data-tr="🖨️ Biniş Kartını Yazdır" data-en="🖨️ Print Boarding Pass">🖨️ Print Boarding Pass</button>
            <a href="@Url.Action("Index", "Home")" class="btn btn-secondary" data-tr="🏠 Ana Sayfaya Dön" data-en="🏠 Back to Home">🏠 Back to Home</a>
        </div>
    </div>

    <script src="~/js/language.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            updatePageLanguage();
            
            // TempData mesajlarını kontrol et
            @if (TempData["Success"] != null || TempData["Success_en"] != null)
            {
                <text>
                var currentLang = localStorage.getItem('language') || 'tr';
                var message = currentLang === 'en' && '@TempData["Success_en"]' ? '@TempData["Success_en"]' : '@TempData["Success"]';
                if (message && message !== '') {
                    var alertDiv = document.createElement('div');
                    alertDiv.className = 'alert alert-success';
                    alertDiv.innerHTML = '✓ ' + message;
                    document.querySelector('.content')?.insertBefore(alertDiv, document.querySelector('.content').firstChild);
                }
                </text>
            }
            
            @if (TempData["Error"] != null || TempData["Error_en"] != null)
            {
                <text>
                var currentLang = localStorage.getItem('language') || 'tr';
                var message = currentLang === 'en' && '@TempData["Error_en"]' ? '@TempData["Error_en"]' : '@TempData["Error"]';
                if (message && message !== '') {
                    var alertDiv = document.createElement('div');
                    alertDiv.className = 'alert alert-error';
                    alertDiv.innerHTML = '⚠️ ' + message;
                    document.querySelector('.content')?.insertBefore(alertDiv, document.querySelector('.content').firstChild);
                }
                </text>
            }
        });
    </script>
</body>
</html>

