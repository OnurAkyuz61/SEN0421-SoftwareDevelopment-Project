@model Trabzon_Airlines.Models.Booking
@using System.Linq

@{
    ViewBag.Title = "Booking Details";
    ViewBag.TitleEn = "Booking Details";
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title data-tr="Rezervasyon Detayları - Trabzon Airlines" data-en="Booking Details - Trabzon Airlines">Booking Details - Trabzon Airlines</title>
    <link href="~/Content/css/checkin-booking-details.css" rel="stylesheet" />
</head>
<body>
    <div class="container">
        <div class="header">
            <h1 data-tr="✈️ Rezervasyon Detayları" data-en="✈️ Booking Details">✈️ Booking Details</h1>
            <p data-tr="Rezervasyon bilgilerinizi inceleyin" data-en="Review your booking information">Review your booking information</p>
        </div>

        <div class="content" id="checkinContent">

            <div class="pnr-box">
                <p style="margin-bottom: 10px;" data-tr="PNR Kodunuz" data-en="Your PNR Code">Your PNR Code</p>
                <div class="pnr-code">@Model.PNR</div>
            </div>

            <div class="info-section">
                <h3 data-tr="✈️ Uçuş Bilgileri" data-en="✈️ Flight Information">✈️ Flight Information</h3>
                <div class="info-row">
                    <span class="info-label" data-tr="Uçuş Numarası:" data-en="Flight Number:">Flight Number:</span>
                    <span class="info-value">@Model.Flight.FlightNumber</span>
                </div>
                <div class="info-row">
                    <span class="info-label" data-tr="Rota:" data-en="Route:">Route:</span>
                    <span class="info-value">@Model.Flight.FromCode → @Model.Flight.ToCode</span>
                </div>
                <div class="info-row">
                    <span class="info-label" data-tr="Kalkış:" data-en="Departure:">Departure:</span>
                    <span class="info-value">@Model.Flight.DepartureTime.ToString("dd MMM yyyy HH:mm")</span>
                </div>
                <div class="info-row">
                    <span class="info-label" data-tr="Varış:" data-en="Arrival:">Arrival:</span>
                    <span class="info-value">@Model.Flight.ArrivalTime.ToString("dd MMM yyyy HH:mm")</span>
                </div>
            </div>

            <div class="info-section">
                <h3 data-tr="🪑 Yolcu ve Koltuk" data-en="🪑 Passenger & Seat">🪑 Passenger & Seat</h3>
                <div class="info-row">
                    <span class="info-label" data-tr="Yolcu:" data-en="Passenger:">Passenger:</span>
                    <span class="info-value">@Model.PassengerName @Model.PassengerSurname</span>
                </div>
                <div class="info-row">
                    <span class="info-label" data-tr="Koltuk:" data-en="Seat:">Seat:</span>
                    <span class="info-value">@Model.Seat.SeatNumber (@Model.Seat.CabinClass)</span>
                </div>
                <div class="info-row">
                    <span class="info-label" data-tr="Rezervasyon Tarihi:" data-en="Booking Date:">Booking Date:</span>
                    <span class="info-value">@Model.BookingDate.ToString("dd MMM yyyy HH:mm")</span>
                </div>
            </div>

            @if (Model.BookingMeals != null && Model.BookingMeals.Any())
            {
                <div class="meal-section">
                    <h3 data-tr="🍽️ Seçilen Yemekler" data-en="🍽️ Selected Meals">🍽️ Selected Meals</h3>
                    <ul class="meal-list">
                        @foreach (var bookingMeal in Model.BookingMeals)
                        {
                            <li class="meal-item">
                                ✓ @bookingMeal.Meal.MealName
                                @if (bookingMeal.Quantity > 1)
                                {
                                    <span> x @bookingMeal.Quantity</span>
                                }
                            </li>
                        }
                    </ul>
                </div>
            }

            <div class="info-section">
                <h3 data-tr="📋 Check-In Durumu" data-en="📋 Check-In Status">📋 Check-In Status</h3>
                @if (Model.CheckedIn)
                {
                    <span class="status-badge status-completed" data-tr="✓ Check-In Yapıldı" data-en="✓ Checked In">✓ Checked In</span>
                    <div class="info-row">
                        <span class="info-label" data-tr="Check-In Zamanı:" data-en="Check-In Time:">Check-In Time:</span>
                        <span class="info-value">@Model.CheckInTime?.ToString("dd MMM yyyy HH:mm")</span>
                    </div>
                }
                else
                {
                    <span class="status-badge status-pending" data-tr="⏳ Check-In Bekliyor" data-en="⏳ Check-In Pending">⏳ Check-In Pending</span>
                }
            </div>

            <div class="action-buttons">
                @if (Model.CheckedIn)
                {
                    <a href="@Url.Action("BoardingPass", "CheckIn", new { bookingId = Model.BookingId })" class="btn btn-primary" data-tr="Biniş Kartını Görüntüle" data-en="View Boarding Pass">
                        View Boarding Pass
                    </a>
                }
                else
                {
                    using (Html.BeginForm("DoCheckIn", "CheckIn", FormMethod.Post))
                    {
                        @Html.AntiForgeryToken()
                        @Html.Hidden("bookingId", Model.BookingId)
                        <button type="submit" class="btn btn-primary" data-tr="Check-In'i Tamamla" data-en="Complete Check-In">Complete Check-In</button>
                    }
                }

                <a href="@Url.Action("Index", "CheckIn")" class="btn btn-secondary" data-tr="Başka Rezervasyon Kontrol Et" data-en="Check Another Booking">Check Another Booking</a>
            </div>
        </div>
    </div>

    <script src="~/js/language.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            updatePageLanguage();
            
            // TempData mesajlarını dil kontrolü ile göster
            var currentLang = localStorage.getItem('language') || 'tr';
            var contentDiv = document.getElementById('checkinContent');
            
            @if (TempData["Info"] != null || TempData["Info_en"] != null)
            {
                <text>
                var message = currentLang === 'en' && '@TempData["Info_en"]' ? '@TempData["Info_en"]' : '@TempData["Info"]';
                if (message && message !== '') {
                    var alertDiv = document.createElement('div');
                    alertDiv.className = 'alert alert-info';
                    alertDiv.innerHTML = 'ℹ️ ' + message;
                    contentDiv.insertBefore(alertDiv, contentDiv.firstChild);
                }
                </text>
            }
            
            @if (TempData["Warning"] != null || TempData["Warning_en"] != null)
            {
                <text>
                var message = currentLang === 'en' && '@TempData["Warning_en"]' ? '@TempData["Warning_en"]' : '@TempData["Warning"]';
                if (message && message !== '') {
                    var alertDiv = document.createElement('div');
                    alertDiv.className = 'alert alert-warning';
                    alertDiv.innerHTML = '⚠️ ' + message;
                    contentDiv.insertBefore(alertDiv, contentDiv.firstChild);
                }
                </text>
            }
            
            @if (TempData["Error"] != null || TempData["Error_en"] != null)
            {
                <text>
                var message = currentLang === 'en' && '@TempData["Error_en"]' ? '@TempData["Error_en"]' : '@TempData["Error"]';
                if (message && message !== '') {
                    var alertDiv = document.createElement('div');
                    alertDiv.className = 'alert alert-error';
                    alertDiv.innerHTML = '⚠️ ' + message;
                    contentDiv.insertBefore(alertDiv, contentDiv.firstChild);
                }
                </text>
            }
        });
    </script>
</body>
</html>

