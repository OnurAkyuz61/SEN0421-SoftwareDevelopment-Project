@* Model tanımı - Rezervasyon listesi modeli *@
@* Model definition - Booking list model *@
@model IEnumerable<Trabzon_Airlines.Models.Booking>

@* Sayfa başlığı - ViewBag.Title ayarı *@
@* Page title - ViewBag.Title setting *@
@{
    ViewBag.Title = "Rezervasyon Yönetimi";
    ViewBag.TitleEn = "Booking Management";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

@* Rezervasyon Yönetimi CSS *@
@* Booking Management CSS *@
@section styles {
    <link rel="stylesheet" href="~/Content/css/admin-bookings.css?v=@DateTime.Now.Ticks">
}

@* Sayfa Başlığı *@
@* Page Header *@
<div class="admin-page-header">
    <div class="page-header-content">
        <h1 class="page-title">
            <i class="fa-solid fa-calendar-check"></i>
            <span data-tr="Rezervasyon Yönetimi" data-en="Booking Management">Rezervasyon Yönetimi</span>
        </h1>
    </div>
</div>

@* Hata Mesajları *@
@* Error Messages *@
@if (TempData["AdminErrorKey"] != null)
{
    <div class="alert alert-error">
        <i class="fa-solid fa-circle-exclamation"></i>
        <span>
            @if (TempData["AdminError_tr"] != null)
            {
                @TempData["AdminError_tr"]
            }
            else if (TempData["AdminError_en"] != null)
            {
                @TempData["AdminError_en"]
            }
        </span>
    </div>
}

@* Başarı Mesajları *@
@* Success Messages *@
@if (TempData["AdminSuccessKey"] != null)
{
    <div class="alert alert-success">
        <i class="fa-solid fa-circle-check"></i>
        <span>
            @if (TempData["AdminSuccess_tr"] != null)
            {
                @TempData["AdminSuccess_tr"]
            }
            else if (TempData["AdminSuccess_en"] != null)
            {
                @TempData["AdminSuccess_en"]
            }
        </span>
    </div>
}

@* Rezervasyon Listesi Kartı *@
@* Booking List Card *@
<div class="admin-card">
    <div class="admin-card-header">
        <h2 class="admin-card-title">
            <i class="fa-solid fa-list"></i>
            <span data-tr="Tüm Rezervasyonlar" data-en="All Bookings">Tüm Rezervasyonlar</span>
        </h2>
        <div class="admin-card-actions">
            <input type="text" id="bookingSearch" class="search-input" placeholder="Ara..." data-placeholder-tr="Ara..." data-placeholder-en="Search...">
        </div>
    </div>
    <div class="admin-card-body">
        @if (Model != null && Model.Any())
        {
            @* Rezervasyon Listesi Tablosu *@
            @* Booking List Table *@
            <div class="table-responsive">
                <table class="admin-table" id="bookingsTable">
                    <thead>
                        <tr>
                            <th data-tr="PNR" data-en="PNR">PNR</th>
                            <th data-tr="Yolcu" data-en="Passenger">Yolcu</th>
                            <th data-tr="Uçuş" data-en="Flight">Uçuş</th>
                            <th data-tr="Koltuk" data-en="Seat">Koltuk</th>
                            <th data-tr="Rezervasyon Tarihi" data-en="Booking Date">Rezervasyon Tarihi</th>
                            <th data-tr="İşlemler" data-en="Actions">İşlemler</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var booking in Model)
                        {
                            <tr>
                                @* PNR Kodu *@
                                @* PNR Code *@
                                <td>
                                    <strong class="pnr-code">@booking.PNR</strong>
                                </td>

                                @* Yolcu Bilgisi *@
                                @* Passenger Information *@
                                <td>
                                    <div class="passenger-info">
                                        <div class="passenger-name">@booking.PassengerName @booking.PassengerSurname</div>
                                    </div>
                                </td>

                                @* Uçuş Bilgisi *@
                                @* Flight Information *@
                                <td>
                                    <div class="flight-info">
                                        <div class="flight-number">@booking.Flight.FlightNumber</div>
                                        <div class="route-info">
                                            <span class="route-code">@booking.Flight.FromCode</span>
                                            <i class="fa-solid fa-arrow-right route-arrow"></i>
                                            <span class="route-code">@booking.Flight.ToCode</span>
                                        </div>
                                    </div>
                                </td>

                                @* Koltuk Bilgisi *@
                                @* Seat Information *@
                                <td>
                                    <span class="seat-number">@booking.Seat.SeatNumber</span>
                                </td>

                                @* Rezervasyon Tarihi *@
                                @* Booking Date *@
                                <td>
                                    <div class="time-info">
                                        <div class="time-date">@booking.BookingDate.ToString("dd.MM.yyyy")</div>
                                        <div class="time-hour">@booking.BookingDate.ToString("HH:mm")</div>
                                    </div>
                                </td>

                                @* İşlemler *@
                                @* Actions *@
                                <td>
                                    <div class="action-buttons">
                                        <a href="@Url.Action("Details", "AdminBookings", new { id = booking.BookingId })" class="btn-action btn-view" title="Detay" data-tr-title="Detay" data-en-title="Details">
                                            <i class="fa-solid fa-eye"></i>
                                        </a>
                                        <a href="@Url.Action("Delete", "AdminBookings", new { id = booking.BookingId })" class="btn-action btn-delete" title="Sil" data-tr-title="Sil" data-en-title="Delete" onclick="return confirm('Bu rezervasyonu silmek istediğinizden emin misiniz?');">
                                            <i class="fa-solid fa-trash"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            @* Boş Durum *@
            @* Empty State *@
            <div class="admin-empty-state">
                <i class="fa-solid fa-calendar-times"></i>
                <h3 data-tr="Henüz rezervasyon bulunmuyor" data-en="No bookings found">Henüz rezervasyon bulunmuyor</h3>
                <p data-tr="Henüz hiç rezervasyon yapılmamış." data-en="No bookings have been made yet.">Henüz hiç rezervasyon yapılmamış.</p>
            </div>
        }
    </div>
</div>

@* Rezervasyon Yönetimi JavaScript *@
@* Booking Management JavaScript *@
@section scripts {
    <script src="~/js/admin-bookings.js"></script>
}

