@* Model tanımı - Kullanıcı listesi modeli *@
@* Model definition - User list model *@
@model IEnumerable<Trabzon_Airlines.Models.User>

@* Sayfa başlığı - ViewBag.Title ayarı *@
@* Page title - ViewBag.Title setting *@
@{
    ViewBag.Title = "Kullanıcı Yönetimi";
    ViewBag.TitleEn = "User Management";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

@* Kullanıcı Yönetimi CSS *@
@* User Management CSS *@
@section styles {
    <link rel="stylesheet" href="~/Content/css/admin-users.css?v=@DateTime.Now.Ticks">
}

@* Sayfa Başlığı *@
@* Page Header *@
<div class="admin-page-header">
    <div class="page-header-content">
        <h1 class="page-title">
            <i class="fa-solid fa-users"></i>
            <span data-tr="Kullanıcı Yönetimi" data-en="User Management">Kullanıcı Yönetimi</span>
        </h1>
    </div>
</div>

@* Hata Mesajları *@
@* Error Messages *@
@if (TempData["AdminErrorKey"] != null)
{
    <div class="alert alert-error">
        <i class="fa-solid fa-circle-exclamation"></i>
        <span>
            @if (TempData["AdminError_tr"] != null)
            {
                @TempData["AdminError_tr"]
            }
            else if (TempData["AdminError_en"] != null)
            {
                @TempData["AdminError_en"]
            }
        </span>
    </div>
}

@* Başarı Mesajları *@
@* Success Messages *@
@if (TempData["AdminSuccessKey"] != null)
{
    <div class="alert alert-success">
        <i class="fa-solid fa-circle-check"></i>
        <span>
            @if (TempData["AdminSuccess_tr"] != null)
            {
                @TempData["AdminSuccess_tr"]
            }
            else if (TempData["AdminSuccess_en"] != null)
            {
                @TempData["AdminSuccess_en"]
            }
        </span>
    </div>
}

@* Kullanıcı Listesi Kartı *@
@* User List Card *@
<div class="admin-card">
    <div class="admin-card-header">
        <h2 class="admin-card-title">
            <i class="fa-solid fa-list"></i>
            <span data-tr="Tüm Kullanıcılar" data-en="All Users">Tüm Kullanıcılar</span>
        </h2>
        <div class="admin-card-actions">
            <input type="text" id="userSearch" class="search-input" placeholder="Ara..." data-placeholder-tr="Ara..." data-placeholder-en="Search...">
        </div>
    </div>
    <div class="admin-card-body">
        @if (Model != null && Model.Any())
        {
            @* Kullanıcı Listesi Tablosu *@
            @* User List Table *@
            <div class="table-responsive">
                <table class="admin-table" id="usersTable">
                    <thead>
                        <tr>
                            <th data-tr="Ad Soyad" data-en="Full Name">Ad Soyad</th>
                            <th data-tr="E-posta" data-en="Email">E-posta</th>
                            <th data-tr="Telefon" data-en="Phone">Telefon</th>
                            <th data-tr="Doğum Tarihi" data-en="Birth Date">Doğum Tarihi</th>
                            <th data-tr="Cinsiyet" data-en="Gender">Cinsiyet</th>
                            <th data-tr="İşlemler" data-en="Actions">İşlemler</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var user in Model)
                        {
                            <tr>
                                @* Ad Soyad *@
                                @* Full Name *@
                                <td>
                                    <strong class="user-name">@user.FirstName @user.LastName</strong>
                                </td>

                                @* E-posta *@
                                @* Email *@
                                <td>
                                    <span class="user-email">@user.Email</span>
                                </td>

                                @* Telefon *@
                                @* Phone *@
                                <td>
                                    <span class="user-phone">@(string.IsNullOrEmpty(user.Phone) ? "-" : user.Phone)</span>
                                </td>

                                @* Doğum Tarihi *@
                                @* Birth Date *@
                                <td>
                                    <div class="time-info">
                                        <div class="time-date">@user.BirthDate.ToString("dd.MM.yyyy")</div>
                                    </div>
                                </td>

                                @* Cinsiyet *@
                                @* Gender *@
                                <td>
                                    @if (!string.IsNullOrEmpty(user.Gender))
                                    {
                                        <span class="badge badge-info">@user.Gender</span>
                                    }
                                    else
                                    {
                                        <span class="badge badge-secondary">-</span>
                                    }
                                </td>

                                @* İşlemler *@
                                @* Actions *@
                                <td>
                                    <div class="action-buttons">
                                        <a href="@Url.Action("Details", "AdminUsers", new { id = user.UserId })" class="btn-action btn-view" title="Detay" data-tr-title="Detay" data-en-title="Details">
                                            <i class="fa-solid fa-eye"></i>
                                        </a>
                                        <a href="@Url.Action("Delete", "AdminUsers", new { id = user.UserId })" class="btn-action btn-delete" title="Sil" data-tr-title="Sil" data-en-title="Delete" onclick="return confirm('Bu kullanıcıyı silmek istediğinizden emin misiniz?');">
                                            <i class="fa-solid fa-trash"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            @* Boş Durum *@
            @* Empty State *@
            <div class="admin-empty-state">
                <i class="fa-solid fa-user-slash"></i>
                <h3 data-tr="Henüz kullanıcı bulunmuyor" data-en="No users found">Henüz kullanıcı bulunmuyor</h3>
                <p data-tr="Henüz hiç kullanıcı kaydı yapılmamış." data-en="No user registrations have been made yet.">Henüz hiç kullanıcı kaydı yapılmamış.</p>
            </div>
        }
    </div>
</div>

@* Kullanıcı Yönetimi JavaScript *@
@* User Management JavaScript *@
@section scripts {
    <script src="~/js/admin-users.js"></script>
}

