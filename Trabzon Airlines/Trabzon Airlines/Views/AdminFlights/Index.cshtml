@* Model tanımı - Uçuş listesi modeli *@
@* Model definition - Flight list model *@
@model IEnumerable<Trabzon_Airlines.Models.Flight>

@* Sayfa başlığı - ViewBag.Title ayarı *@
@* Page title - ViewBag.Title setting *@
@{
    ViewBag.Title = "Uçuş Listesi";
    ViewBag.TitleEn = "Flight List";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@* Ana başlık - Çeviri desteği ile *@
@* Main header - With translation support *@
<h2 data-tr="Uçuş Listesi" data-en="Flight List">Uçuş Listesi</h2>

@* Yeni sefer ekle butonu - Çeviri desteği ile *@
@* Add new flight button - With translation support *@
<p>
    @Html.ActionLink("Yeni Sefer Ekle", "Create", null, new { @class = "btn btn-primary", data_tr = "Yeni Sefer Ekle", data_en = "Add New Flight" })
</p>

@* Uçuş listesi tablosu *@
@* Flight list table *@
<table class="table table-striped table-bordered">
    @* Tablo başlıkları - Çeviri desteği ile *@
    @* Table headers - With translation support *@
    <thead>
        <tr>
            <th data-tr="Sefer No" data-en="Flight No">Sefer No</th>
            <th data-tr="Güzergah" data-en="Route">Güzergah</th>
            <th data-tr="Kalkış Zamanı" data-en="Departure Time">Kalkış Zamanı</th>
            <th data-tr="Varış Zamanı" data-en="Arrival Time">Varış Zamanı</th>
            <th data-tr="Hava Durumu" data-en="Weather Condition">Hava Durumu</th>
            <th data-tr="Rötar Riski" data-en="Delay Risk">Rötar Riski</th>
            <th data-tr="Fiyat" data-en="Price">Fiyat</th>
            <th data-tr="Durum" data-en="Status">Durum</th>
            <th data-tr="İşlemler" data-en="Actions">İşlemler</th>
        </tr>
    </thead>
    @* Tablo gövdesi *@
    @* Table body *@
    <tbody>
        @* Her uçuş için tablo satırı oluştur *@
        @* Create table row for each flight *@
        @foreach (var item in Model)
        {
            <tr>
                @* Uçuş numarası gösterimi *@
                @* Flight number display *@
                <td>@item.FlightNumber</td>

                @* Güzergah gösterimi - Kalkış ve varış havalimanları *@
                @* Route display - Departure and arrival airports *@
                <td>@item.FromCode → @item.ToCode</td>

                @* Kalkış zamanı gösterimi - Tarih ve saat formatı *@
                @* Departure time display - Date and time format *@
                <td>@item.DepartureTime.ToString("dd.MM.yyyy HH:mm")</td>
                @* Varış zamanı gösterimi - Tarih ve saat formatı *@
                @* Arrival time display - Date and time format *@
                <td>@item.ArrivalTime.ToString("dd.MM.yyyy HH:mm")</td>

                @* Hava durumu gösterimi *@
                @* Weather condition display *@
                <td>@item.WeatherCondition</td>

                @* Rötar riski gösterimi - Renkli badge ile *@
                @* Delay risk display - With colored badge *@
                <td>
                    @* Yüksek risk durumu *@
                    @* High risk status *@
                    @if (item.DelayRisk == "Yüksek" || item.DelayRisk == "High")
                    {
                        <span class="badge bg-danger" data-tr="Yüksek" data-en="High">Yüksek</span>
                    }
                    @* Orta risk durumu *@
                    @* Medium risk status *@
                    else if (item.DelayRisk == "Orta" || item.DelayRisk == "Medium")
                    {
                        <span class="badge bg-warning text-dark" data-tr="Orta" data-en="Medium">Orta</span>
                    }
                    @* Düşük risk durumu *@
                    @* Low risk status *@
                    else if (item.DelayRisk == "Düşük" || item.DelayRisk == "Low")
                    {
                        <span class="badge bg-success" data-tr="Düşük" data-en="Low">Düşük</span>
                    }
                    @* Belirtilmemiş durum *@
                    @* Not specified status *@
                    else
                    {
                        <span class="badge bg-secondary">-</span>
                    }
                </td>

                @* Fiyat gösterimi - Para birimi formatı ile *@
                @* Price display - With currency format *@
                <td>@item.Price.ToString("C")</td>

                @* Durum gösterimi - Aktif/Pasif *@
                @* Status display - Active/Inactive *@
                <td>
                    @if (item.IsActive)
                    {
                        <span class="badge bg-success" data-tr="Aktif" data-en="Active">Aktif</span>
                    }
                    else
                    {
                        <span class="badge bg-secondary" data-tr="Pasif" data-en="Inactive">Pasif</span>
                    }
                </td>

                @* İşlem butonları - Düzenle, Sil, Koltuklar *@
                @* Action buttons - Edit, Delete, Seats *@
                <td>
                    @Html.ActionLink("Düzenle", "Edit", new { id = item.FlightId }, new { data_tr = "Düzenle", data_en = "Edit" }) |
                    @Html.ActionLink("Sil", "Delete", new { id = item.FlightId }, new { data_tr = "Sil", data_en = "Delete" }) |
                    @Html.ActionLink("Koltukları Yönet", "Seats", new { flightId = item.FlightId }, new { data_tr = "Koltukları Yönet", data_en = "Manage Seats" })
                </td>
            </tr>
        }
    </tbody>
</table>
