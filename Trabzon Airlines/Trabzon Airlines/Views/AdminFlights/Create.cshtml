@* Model tanımı - Uçuş modeli *@
@* Model definition - Flight model *@
@model Trabzon_Airlines.Models.Flight

@* Sayfa başlığı - ViewBag.Title ayarı *@
@* Page title - ViewBag.Title setting *@
@{
    ViewBag.Title = "Yeni Uçuş Ekle";
    ViewBag.TitleEn = "Add New Flight";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

@* Uçuş Formu CSS *@
@* Flight Form CSS *@
@section styles {
    <link rel="stylesheet" href="~/Content/css/admin-flight-form.css?v=@DateTime.Now.Ticks">
}

@* Sayfa Başlığı *@
@* Page Header *@
<div class="admin-page-header">
    <div class="page-header-content">
        <h1 class="page-title">
            <i class="fa-solid fa-plus-circle"></i>
            <span data-tr="Yeni Uçuş Ekle" data-en="Add New Flight">Yeni Uçuş Ekle</span>
        </h1>
        <a href="@Url.Action("Index", "AdminFlights")" class="btn-secondary-action">
            <i class="fa-solid fa-arrow-left"></i>
            <span data-tr="Listeye Dön" data-en="Back to List">Listeye Dön</span>
        </a>
    </div>
</div>

@* Hata Mesajları *@
@* Error Messages *@
@if (TempData["AdminErrorKey"] != null)
{
    <div class="alert alert-error">
        <i class="fa-solid fa-circle-exclamation"></i>
        <span>
            @if (TempData["AdminError_tr"] != null)
            {
                @TempData["AdminError_tr"]
            }
            else if (TempData["AdminError_en"] != null)
            {
                @TempData["AdminError_en"]
            }
        </span>
    </div>
}

@* Başarı Mesajları *@
@* Success Messages *@
@if (TempData["AdminSuccessKey"] != null)
{
    <div class="alert alert-success">
        <i class="fa-solid fa-circle-check"></i>
        <span>
            @if (TempData["AdminSuccess_tr"] != null)
            {
                @TempData["AdminSuccess_tr"]
            }
            else if (TempData["AdminSuccess_en"] != null)
            {
                @TempData["AdminSuccess_en"]
            }
        </span>
    </div>
}

@* Uçuş Oluşturma Formu *@
@* Flight Creation Form *@
<div class="admin-card">
    <div class="admin-card-header">
        <h2 class="admin-card-title">
            <i class="fa-solid fa-plane"></i>
            <span data-tr="Uçuş Bilgileri" data-en="Flight Information">Uçuş Bilgileri</span>
        </h2>
    </div>
    <div class="admin-card-body">
        @using (Html.BeginForm("Create", "AdminFlights", FormMethod.Post, new { @class = "flight-form" }))
        {
            @Html.AntiForgeryToken() @* CSRF koruması *@
            
            @* Hata Mesajları *@
            @* Error Messages *@
            @Html.ValidationSummary(true, "", new { @class = "alert alert-error" })

            @* Form Grid *@
            @* Form Grid *@
            <div class="form-grid">
                @* Uçuş Numarası *@
                @* Flight Number *@
                <div class="form-group">
                    <label for="FlightNumber" class="form-label">
                        <i class="fa-solid fa-hashtag"></i>
                        <span data-tr="Uçuş Numarası *" data-en="Flight Number *">Uçuş Numarası *</span>
                    </label>
                    @Html.TextBoxFor(m => m.FlightNumber, new { @class = "form-control", placeholder = "Örn: TK001", required = "required" })
                    @Html.ValidationMessageFor(m => m.FlightNumber, "", new { @class = "validation-error" })
                </div>

                @* Kalkış Havalimanı *@
                @* Departure Airport *@
                <div class="form-group">
                    <label for="FromCode" class="form-label">
                        <i class="fa-solid fa-plane-departure"></i>
                        <span data-tr="Kalkış (IATA) *" data-en="Departure (IATA) *">Kalkış (IATA) *</span>
                    </label>
                    @Html.TextBoxFor(m => m.FromCode, new { @class = "form-control", placeholder = "Örn: TZX", maxlength = "3", required = "required" })
                    @Html.ValidationMessageFor(m => m.FromCode, "", new { @class = "validation-error" })
                </div>

                @* Varış Havalimanı *@
                @* Arrival Airport *@
                <div class="form-group">
                    <label for="ToCode" class="form-label">
                        <i class="fa-solid fa-plane-arrival"></i>
                        <span data-tr="Varış (IATA) *" data-en="Arrival (IATA) *">Varış (IATA) *</span>
                    </label>
                    @Html.TextBoxFor(m => m.ToCode, new { @class = "form-control", placeholder = "Örn: IST", maxlength = "3", required = "required" })
                    @Html.ValidationMessageFor(m => m.ToCode, "", new { @class = "validation-error" })
                </div>

                @* Kalkış Zamanı *@
                @* Departure Time *@
                <div class="form-group">
                    <label for="DepartureTime" class="form-label">
                        <i class="fa-solid fa-calendar-alt"></i>
                        <span data-tr="Kalkış Zamanı *" data-en="Departure Time *">Kalkış Zamanı *</span>
                    </label>
                    @Html.TextBoxFor(m => m.DepartureTime, "{0:yyyy-MM-ddTHH:mm}", new { @class = "form-control", type = "datetime-local", required = "required" })
                    @Html.ValidationMessageFor(m => m.DepartureTime, "", new { @class = "validation-error" })
                </div>

                @* Varış Zamanı *@
                @* Arrival Time *@
                <div class="form-group">
                    <label for="ArrivalTime" class="form-label">
                        <i class="fa-solid fa-calendar-check"></i>
                        <span data-tr="Varış Zamanı *" data-en="Arrival Time *">Varış Zamanı *</span>
                    </label>
                    @Html.TextBoxFor(m => m.ArrivalTime, "{0:yyyy-MM-ddTHH:mm}", new { @class = "form-control", type = "datetime-local", required = "required" })
                    @Html.ValidationMessageFor(m => m.ArrivalTime, "", new { @class = "validation-error" })
                </div>

                @* Fiyat *@
                @* Price *@
                <div class="form-group">
                    <label for="Price" class="form-label">
                        <i class="fa-solid fa-lira-sign"></i>
                        <span data-tr="Fiyat (₺) *" data-en="Price (₺) *">Fiyat (₺) *</span>
                    </label>
                    @Html.TextBoxFor(m => m.Price, new { @class = "form-control", type = "number", step = "0.01", min = "0", placeholder = "0.00", required = "required" })
                    @Html.ValidationMessageFor(m => m.Price, "", new { @class = "validation-error" })
                </div>

                @* Hava Durumu *@
                @* Weather Condition *@
                <div class="form-group">
                    <label for="WeatherCondition" class="form-label">
                        <i class="fa-solid fa-cloud-sun"></i>
                        <span data-tr="Hava Durumu" data-en="Weather Condition">Hava Durumu</span>
                    </label>
                    @Html.DropDownListFor(m => m.WeatherCondition, (IEnumerable<SelectListItem>)ViewBag.WeatherOptions, new { @class = "form-control" })
                    @Html.ValidationMessageFor(m => m.WeatherCondition, "", new { @class = "validation-error" })
                </div>

                @* Rötar Riski *@
                @* Delay Risk *@
                <div class="form-group">
                    <label for="DelayRisk" class="form-label">
                        <i class="fa-solid fa-exclamation-triangle"></i>
                        <span data-tr="Rötar Riski" data-en="Delay Risk">Rötar Riski</span>
                    </label>
                    @Html.DropDownListFor(m => m.DelayRisk, (IEnumerable<SelectListItem>)ViewBag.DelayRiskOptions, new { @class = "form-control" })
                    @Html.ValidationMessageFor(m => m.DelayRisk, "", new { @class = "validation-error" })
                </div>

                @* Aktif Durumu *@
                @* Active Status *@
                <div class="form-group form-group-checkbox">
                    <label class="checkbox-label">
                        @Html.CheckBoxFor(m => m.IsActive, new { @class = "form-checkbox" })
                        <span data-tr="Uçuş Aktif" data-en="Flight Active">Uçuş Aktif</span>
                    </label>
                </div>
            </div>

            @* Form Butonları *@
            @* Form Buttons *@
            <div class="form-actions">
                <button type="submit" class="btn-primary-action">
                    <i class="fa-solid fa-save"></i>
                    <span data-tr="Kaydet" data-en="Save">Kaydet</span>
                </button>
                <a href="@Url.Action("Index", "AdminFlights")" class="btn-secondary-action">
                    <i class="fa-solid fa-times"></i>
                    <span data-tr="İptal" data-en="Cancel">İptal</span>
                </a>
            </div>
        }
    </div>
</div>

@* Uçuş Formu JavaScript *@
@* Flight Form JavaScript *@
@section scripts {
    <script src="~/js/admin-flight-form.js"></script>
}
