@* Model tanımı - FlightSeat modeli kullanılıyor - Model definition - Using FlightSeat model *@
@model Trabzon_Airlines.Models.FlightSeat
@* Razor kod bloğu - ViewBag ve Layout ayarları - Razor code block - ViewBag and Layout settings *@
@{ 
    ViewBag.Title = "Koltuk Yönetimi"; /* Sayfa başlığı (Türkçe) - Page title (Turkish) */
    ViewBag.TitleEn = "Seat Management"; /* Sayfa başlığı (İngilizce) - Page title (English) */
    Layout = "~/Views/Shared/_AdminLayout.cshtml"; /* Admin layout dosyası yolu - Admin layout file path */

}

@* Sayfa başlığı - Page heading *@
<h2>Koltuk Bilgisi</h2> @* Koltuk bilgisi başlığı - Seat information heading *@
<hr /> @* Yatay çizgi ayırıcı - Horizontal line separator *@

@* Uçuş bilgisi paragrafı - Flight information paragraph *@
<p><b>Uçuş:</b> @Model.Flight.FlightNumber (@Model.Flight.FromCode - @Model.Flight.ToCode)</p> @* Uçuş numarası ve rotası (kalın başlık) - Flight number and route (bold title) *@
@* Koltuk bilgisi paragrafı - Seat information paragraph *@
<p><b>Koltuk:</b> @Model.Seat.SeatNumber (@Model.Seat.CabinClass)</p> @* Koltuk numarası ve kabin sınıfı (kalın başlık) - Seat number and cabin class (bold title) *@
@* Durum bilgisi paragrafı - Status information paragraph *@
<p><b>Durum:</b> @(Model.IsReserved ? "DOLU" : "BOŞ")</p> @* Koltuk durumu (rezerve ise DOLU, değilse BOŞ) - Seat status (DOLU if reserved, BOŞ otherwise) *@

@* Rezervasyon durumu kontrolü - Reservation status check *@
@if (Model.IsReserved)
{
    @* Koltuk boşaltma butonu - Unreserve seat button *@
    <a href="@Url.Action("Unreserve", "AdminFlights", new { id = Model.FlightSeatId })"
       class="btn btn-danger">Koltuk Boşalt</a> @* Koltuk boşalt butonu (kırmızı) - Unreserve seat button (red) *@
}
else
{
    @* Boş koltuk mesajı - Empty seat message *@
    <span style="color:green;">Bu koltuk şu anda boştur.</span> @* Yeşil renkli boş koltuk mesajı - Green colored empty seat message *@
}
