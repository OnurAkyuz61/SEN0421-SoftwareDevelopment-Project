@model Trabzon_Airlines.Models.FlightSeat
@{ 
    ViewBag.Title = "Koltuk Yönetimi";
    ViewBag.TitleEn = "Seat Management";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";

}

<h2>Koltuk Bilgisi</h2>
<hr />

<p><b>Uçuş:</b> @Model.Flight.FlightNumber (@Model.Flight.FromCode - @Model.Flight.ToCode)</p>
<p><b>Koltuk:</b> @Model.Seat.SeatNumber (@Model.Seat.CabinClass)</p>
<p><b>Durum:</b> @(Model.IsReserved ? "DOLU" : "BOŞ")</p>

@if (Model.IsReserved)
{
    <a href="@Url.Action("Unreserve", "AdminFlights", new { id = Model.FlightSeatId })"
       class="btn btn-danger">Koltuk Boşalt</a>
}
else
{
    <span style="color:green;">Bu koltuk şu anda boştur.</span>
}
