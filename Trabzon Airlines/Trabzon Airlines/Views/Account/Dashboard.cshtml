@* System.Linq using direktifi - System.Linq using directive *@
@using System.Linq
@* Model tanımı - UserDashboardViewModel modeli kullanılıyor - Model definition - Using UserDashboardViewModel model *@
@model Trabzon_Airlines.Models.UserDashboardViewModel

@* Razor kod bloğu - ViewBag ve Layout ayarları - Razor code block - ViewBag and Layout settings *@
@{
    ViewBag.Title = "Kullanıcı Paneli"; /* Sayfa başlığı (Türkçe) - Page title (Turkish) */
    ViewBag.TitleEn = "User Dashboard"; /* Sayfa başlığı (İngilizce) - Page title (English) */
    Layout = "~/Views/Shared/_Layout.cshtml"; /* Layout dosyası yolu - Layout file path */
}

@* Styles bölümü - CSS dosyası ekleme - Styles section - Adding CSS file *@
@section styles {
    <link rel="stylesheet" href="~/Content/css/admin-dashboard.css?v=@DateTime.Now.Ticks"> /* Admin dashboard CSS dosyası (cache önleme için timestamp) - Admin dashboard CSS file (timestamp for cache prevention) */
}

@* Sayfa başlık bölümü - Page header section *@
<div class="admin-page-header">
    <div class="page-header-content">
        <h1 class="page-title">
            <i class="fa-solid fa-user"></i> @* Kullanıcı ikonu - User icon *@
            <span data-tr="Kullanıcı Paneli" data-en="User Dashboard">Kullanıcı Paneli</span> @* Çok dilli başlık - Multilingual title *@
        </h1>
        <p class="page-subtitle">
            <span data-tr="Hoş geldiniz," data-en="Welcome,">Hoş geldiniz,</span> @* Çok dilli hoş geldiniz metni - Multilingual welcome text *@
            <strong>@Model.FullName</strong> @* Kullanıcı tam adı (kalın) - User full name (bold) *@
        </p>
    </div>
</div>

@* Başarı mesajı kontrolü - Success message check *@
@if (TempData["Success_tr"] != null)
{
    <div class="alert alert-success">@TempData["Success_tr"]</div> /* Başarı mesajı gösterimi - Success message display */
}
@* Hata mesajı kontrolü - Error message check *@
@if (TempData["Error_tr"] != null)
{
    <div class="alert alert-danger">@TempData["Error_tr"]</div> /* Hata mesajı gösterimi - Error message display */
}

@* İstatistik kartları grid - Statistics cards grid *@
<div class="stats-grid">
    @* Toplam rezervasyon kartı (birincil renk) - Total bookings card (primary color) *@
    <div class="stat-card stat-card-primary">
        <div class="stat-card-icon">
            <i class="fa-solid fa-ticket"></i> @* Bilet ikonu - Ticket icon *@
        </div>
        <div class="stat-card-content">
            <h3 class="stat-card-value">@Model.TotalBookings</h3> @* Toplam rezervasyon sayısı - Total bookings count *@
            <p class="stat-card-label" data-tr="Toplam Rezervasyon" data-en="Total Bookings">Toplam Rezervasyon</p> @* Çok dilli etiket - Multilingual label *@
        </div>
    </div>

    @* Yaklaşan uçuşlar kartı (başarı rengi) - Upcoming flights card (success color) *@
    <div class="stat-card stat-card-success">
        <div class="stat-card-icon">
            <i class="fa-solid fa-plane-departure"></i> @* Kalkış uçağı ikonu - Departure plane icon *@
        </div>
        <div class="stat-card-content">
            <h3 class="stat-card-value">@Model.UpcomingCount</h3> @* Yaklaşan uçuş sayısı - Upcoming flights count *@
            <p class="stat-card-label" data-tr="Yaklaşan Uçuşlar" data-en="Upcoming Flights">Yaklaşan Uçuşlar</p> @* Çok dilli etiket - Multilingual label *@
        </div>
    </div>

    @* Geçmiş uçuşlar kartı (bilgi rengi) - Past flights card (info color) *@
    <div class="stat-card stat-card-info">
        <div class="stat-card-icon">
            <i class="fa-solid fa-plane-arrival"></i> @* Varış uçağı ikonu - Arrival plane icon *@
        </div>
        <div class="stat-card-content">
            <h3 class="stat-card-value">@Model.PastCount</h3> @* Geçmiş uçuş sayısı - Past flights count *@
            <p class="stat-card-label" data-tr="Geçmiş Uçuşlar" data-en="Past Flights">Geçmiş Uçuşlar</p> @* Çok dilli etiket - Multilingual label *@
        </div>
    </div>

    @* Toplam harcama kartı (uyarı rengi) - Total spent card (warning color) *@
    <div class="stat-card stat-card-warning">
        <div class="stat-card-icon">
            <i class="fa-solid fa-coins"></i> @* Para ikonu - Coins icon *@
        </div>
        <div class="stat-card-content">
            <h3 class="stat-card-value">
                @Model.TotalSpent.ToString("C", new System.Globalization.CultureInfo("tr-TR"))
            </h3> @* Toplam harcama (para formatında) - Total spent (currency format) *@
            <p class="stat-card-label" data-tr="Toplam Harcama" data-en="Total Spent">Toplam Harcama</p> @* Çok dilli etiket - Multilingual label *@
        </div>
    </div>
</div>

@* Dashboard grid - İki sütunlu düzen - Dashboard grid - Two column layout *@
<div class="dashboard-grid">

    @* Yaklaşan uçuşlar kartı - Upcoming flights card *@
    <div class="dashboard-card">
        <div class="dashboard-card-header">
            <h2 class="dashboard-card-title">
                <i class="fa-solid fa-calendar-check"></i> @* Takvim onay ikonu - Calendar check icon *@
                <span data-tr="Yaklaşan Uçuşlarım" data-en="My Upcoming Flights">Yaklaşan Uçuşlarım</span> @* Çok dilli başlık - Multilingual title *@
            </h2>
        </div>
        <div class="dashboard-card-body">
            @* Yaklaşan uçuş kontrolü - Upcoming flights check *@
            @if (Model.UpcomingBookings == null || !Model.UpcomingBookings.Any())
            {
                @* Boş durum gösterimi - Empty state display *@
                <div class="dashboard-empty">
                    <i class="fa-solid fa-inbox"></i> @* Gelen kutusu ikonu - Inbox icon *@
                    <p data-tr="Yaklaşan uçuşunuz bulunmuyor" data-en="No upcoming flights">Yaklaşan uçuşunuz bulunmuyor</p> @* Çok dilli boş durum mesajı - Multilingual empty state message *@
                </div>
            }
            else
            {
                @* Yaklaşan uçuşlar tablosu - Upcoming flights table *@
                <table class="dashboard-table">
                    <thead>
                        <tr>
                            <th data-tr="PNR" data-en="PNR">PNR</th> @* PNR sütun başlığı - PNR column header *@
                            <th data-tr="Uçuş" data-en="Flight">Uçuş</th> @* Uçuş sütun başlığı - Flight column header *@
                            <th data-tr="Rota" data-en="Route">Rota</th> @* Rota sütun başlığı - Route column header *@
                            <th data-tr="Kalkış" data-en="Departure">Kalkış</th> @* Kalkış sütun başlığı - Departure column header *@
                            <th data-tr="Varış" data-en="Arrival">Varış</th> @* Varış sütun başlığı - Arrival column header *@
                            <th data-tr="Fiyat" data-en="Price">Fiyat</th> @* Fiyat sütun başlığı - Price column header *@
                            <th data-tr="İşlemler" data-en="Actions">İşlemler</th> @* İşlemler sütun başlığı - Actions column header *@
                        </tr>
                    </thead>
                    <tbody>
                        @* Yaklaşan uçuşlar döngüsü - Upcoming flights loop *@
                        @foreach (var b in Model.UpcomingBookings)
                        {
                            <tr>
                                <td><strong>@b.PNR</strong></td> @* PNR kodu (kalın) - PNR code (bold) *@
                                <td>@b.FlightNumber</td> @* Uçuş numarası - Flight number *@
                                <td>@b.FromCode → @b.ToCode</td> @* Rota gösterimi (ok ile) - Route display (with arrow) *@
                                <td>@b.DepartureTime.ToString("dd.MM.yyyy HH:mm")</td> @* Kalkış zamanı (formatlanmış) - Departure time (formatted) *@
                                <td>@b.ArrivalTime.ToString("dd.MM.yyyy HH:mm")</td> @* Varış zamanı (formatlanmış) - Arrival time (formatted) *@
                                <td>@b.Price.ToString("C", new System.Globalization.CultureInfo("tr-TR"))</td> @* Fiyat (para formatında) - Price (currency format) *@
                                <td>
                                    @* İptal formu - Cancel form *@
                                    @using (Html.BeginForm("CancelBooking", "Account",
                                        new { id = b.BookingId },
                                        FormMethod.Post,
                                        new { onsubmit = "return confirm('Bu rezervasyonu iptal etmek istediğinize emin misiniz?');" }))
                                    {
                                        @Html.AntiForgeryToken() @* CSRF koruması token'ı - CSRF protection token *@
                                        <button type="submit" class="btn-action btn-delete" data-tr="İptal Et" data-en="Cancel">
                                            İptal Et
                                        </button> @* İptal butonu (çok dilli) - Cancel button (multilingual) *@
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>
    </div>

    @* Geçmiş uçuşlar kartı - Past flights card *@
    <div class="dashboard-card">
        <div class="dashboard-card-header">
            <h2 class="dashboard-card-title">
                <i class="fa-solid fa-clock-rotate-left"></i> @* Geri dönüş ikonu - Clock rotate left icon *@
                <span data-tr="Geçmiş Uçuşlarım" data-en="My Past Flights">Geçmiş Uçuşlarım</span> @* Çok dilli başlık - Multilingual title *@
            </h2>
        </div>
        <div class="dashboard-card-body">
            @* Geçmiş uçuş kontrolü - Past flights check *@
            @if (Model.PastBookings == null || !Model.PastBookings.Any())
            {
                @* Boş durum gösterimi - Empty state display *@
                <div class="dashboard-empty">
                    <i class="fa-solid fa-inbox"></i> @* Gelen kutusu ikonu - Inbox icon *@
                    <p data-tr="Geçmiş uçuşunuz bulunmuyor" data-en="No past flights">Geçmiş uçuşunuz bulunmuyor</p> @* Çok dilli boş durum mesajı - Multilingual empty state message *@
                </div>
            }
            else
            {
                @* Geçmiş uçuşlar tablosu - Past flights table *@
                <table class="dashboard-table">
                    <thead>
                        <tr>
                            <th data-tr="PNR" data-en="PNR">PNR</th> @* PNR sütun başlığı - PNR column header *@
                            <th data-tr="Uçuş" data-en="Flight">Uçuş</th> @* Uçuş sütun başlığı - Flight column header *@
                            <th data-tr="Rota" data-en="Route">Rota</th> @* Rota sütun başlığı - Route column header *@
                            <th data-tr="Kalkış" data-en="Departure">Kalkış</th> @* Kalkış sütun başlığı - Departure column header *@
                            <th data-tr="Varış" data-en="Arrival">Varış</th> @* Varış sütun başlığı - Arrival column header *@
                            <th data-tr="Fiyat" data-en="Price">Fiyat</th> @* Fiyat sütun başlığı - Price column header *@
                        </tr>
                    </thead>
                    <tbody>
                        @* Geçmiş uçuşlar döngüsü - Past flights loop *@
                        @foreach (var b in Model.PastBookings)
                        {
                            <tr>
                                <td><strong>@b.PNR</strong></td> @* PNR kodu (kalın) - PNR code (bold) *@
                                <td>@b.FlightNumber</td> @* Uçuş numarası - Flight number *@
                                <td>@b.FromCode → @b.ToCode</td> @* Rota gösterimi (ok ile) - Route display (with arrow) *@
                                <td>@b.DepartureTime.ToString("dd.MM.yyyy HH:mm")</td> @* Kalkış zamanı (formatlanmış) - Departure time (formatted) *@
                                <td>@b.ArrivalTime.ToString("dd.MM.yyyy HH:mm")</td> @* Varış zamanı (formatlanmış) - Arrival time (formatted) *@
                                <td>@b.Price.ToString("C", new System.Globalization.CultureInfo("tr-TR"))</td> @* Fiyat (para formatında) - Price (currency format) *@
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>
    </div>

</div>
