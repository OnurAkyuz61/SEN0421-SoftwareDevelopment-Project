<?xml version="1.0" encoding="utf-8"?>
<!--
  Bu dosyayı kopyalama: gerçek secret'ları repo dışına koy.

  macOS / Linux:
    ~/.config/Microsoft/UserSecrets/fa7a7c3c-433f-49bc-b800-debf86b94b2a/secrets.xml

  Windows:
    %APPDATA%\Microsoft\UserSecrets\fa7a7c3c-433f-49bc-b800-debf86b94b2a\secrets.xml

  userSecretsId, Web.config içindeki configBuilders > Secrets ile aynı olmalı.
-->
<root>
  <secrets ver="1.0">
    <secret name="AI:ApiKey" value="YOUR_AI_API_KEY_HERE" />
    <secret name="Smtp:UserName" value="your-email@gmail.com" />
    <secret name="Smtp:Password" value="YOUR_APP_PASSWORD_HERE" />
  </secrets>
</root>
