@model List<EscalationRecord>
@using ServiceDesk.Controllers
@{
    ViewData["Title"] = "Eskalasyon geçmişi raporu";
    var f = (EscalationReportFilter)ViewBag.Filter;
    var s = (EscalationSummary)ViewBag.Summary;
    var pager = (PagerInfo)ViewBag.Pager;
    var teams = (List<Team>)ViewBag.Teams;
    var maxLevel = s.ByLevel.Count == 0 ? 1 : s.ByLevel.Max(x => x.Count);
}

<div class="d-flex flex-wrap align-items-center gap-2 mb-3">
    <h4 class="fw-bold mb-0 me-auto">Eskalasyon geçmişi raporu</h4>
    <a class="btn btn-sm btn-outline-secondary" href="@Url.Action("EscalationsCsv", new { f.From, f.To, f.Level, f.Manual, f.TeamId })">
        <i class="bi bi-filetype-csv"></i> CSV indir
    </a>
</div>

<form method="get" class="panel mb-3">
    <div class="panel-body">
        <div class="row g-2 align-items-end">
            <div class="col-md-2">
                <label class="form-label small text-muted mb-1">Başlangıç</label>
                <input type="date" name="from" value="@f.From?.ToString("yyyy-MM-dd")" class="form-control form-control-sm" />
            </div>
            <div class="col-md-2">
                <label class="form-label small text-muted mb-1">Bitiş</label>
                <input type="date" name="to" value="@f.To?.ToString("yyyy-MM-dd")" class="form-control form-control-sm" />
            </div>
            <div class="col-md-2">
                <label class="form-label small text-muted mb-1">Seviye</label>
                <input type="number" min="1" name="level" value="@f.Level" class="form-control form-control-sm" placeholder="Tümü" />
            </div>
            <div class="col-md-2">
                <label class="form-label small text-muted mb-1">Tür</label>
                <select name="manual" class="form-select form-select-sm">
                    <option value="">Tümü</option>
                    <option value="true" selected="@(f.Manual == true)">Manuel</option>
                    <option value="false" selected="@(f.Manual == false)">Otomatik</option>
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label small text-muted mb-1">Ekip</label>
                <select name="teamId" class="form-select form-select-sm">
                    <option value="">Tümü</option>
                    @foreach (var t in teams) { <option value="@t.Id" selected="@(f.TeamId == t.Id)">@t.Name</option> }
                </select>
            </div>
            <div class="col-md-2"><button class="btn btn-sm btn-primary w-100"><i class="bi bi-funnel"></i> Uygula</button></div>
        </div>
    </div>
</form>

<div class="row g-3 mb-3">
    @foreach (var (label, value, tag) in new[]
    {
        ("Toplam eskalasyon", s.Total.ToString(), "tag-red"),
        ("Etkilenen talep", s.DistinctTickets.ToString(), "tag-gray"),
        ("Manuel / otomatik", $"{s.Manual} / {s.Automatic}", "tag-blue"),
        ("Yedek kurala düşen", s.Fallback.ToString(), "tag-amber"),
        ("Önceliği artırılan", s.PriorityRaised.ToString(), "tag-amber"),
        ("Ort. gecikme", $"{s.AvgMinutesOverdue:0} dk", "tag-gray")
    })
    {
        <div class="col-6 col-md-2">
            <div class="panel h-100"><div class="panel-body">
                <div class="small text-muted">@label</div>
                <div class="fs-4 fw-bold">@value</div>
            </div></div>
        </div>
    }
</div>

<div class="row g-3 mb-3">
    <div class="col-md-4">
        <div class="panel h-100">
            <div class="panel-head">Seviyeye göre</div>
            <div class="panel-body">
                @if (!s.ByLevel.Any()) { <div class="text-muted small">Kayıt yok</div> }
                @foreach (var (level, count) in s.ByLevel)
                {
                    <div class="d-flex align-items-center gap-2 mb-2 small">
                        <span style="width:70px">Seviye @level</span>
                        <div class="flex-fill bg-light rounded" style="height:10px">
                            <div class="bg-danger rounded" style="height:10px;width:@((int)(100.0 * count / maxLevel))%"></div>
                        </div>
                        <span class="fw-semibold" style="width:36px;text-align:right">@count</span>
                    </div>
                }
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="panel h-100">
            <div class="panel-head">En çok yükseltilen kişiler</div>
            <ul class="list-group list-group-flush small">
                @if (!s.ByTarget.Any()) { <li class="list-group-item text-muted">Kayıt yok</li> }
                @foreach (var (name, count) in s.ByTarget) { <li class="list-group-item d-flex justify-content-between"><span>@name</span><strong>@count</strong></li> }
            </ul>
        </div>
    </div>
    <div class="col-md-4">
        <div class="panel h-100">
            <div class="panel-head">Ekibe göre</div>
            <ul class="list-group list-group-flush small">
                @if (!s.ByTeam.Any()) { <li class="list-group-item text-muted">Kayıt yok</li> }
                @foreach (var (team, count) in s.ByTeam) { <li class="list-group-item d-flex justify-content-between"><span>@team</span><strong>@count</strong></li> }
            </ul>
        </div>
    </div>
</div>

<div class="panel">
    <div class="panel-head">Kayıtlar</div>
    <div class="table-responsive">
        <table class="table table-sm mb-0">
            <thead><tr><th>Tarih</th><th>Talep</th><th>Seviye</th><th>Tür</th><th>Gecikme</th><th>İlgilenen</th><th>Öncelik</th><th>Not</th></tr></thead>
            <tbody>
                @if (!Model.Any()) { <tr><td colspan="8" class="text-center text-muted py-4">Seçilen dönemde eskalasyon yok</td></tr> }
                @foreach (var e in Model)
                {
                    <tr>
                        <td class="small text-muted text-nowrap">@AppTime.ToLocal(e.OccurredAt).ToString("dd.MM.yyyy HH:mm")</td>
                        <td>
                            @if (e.Ticket != null) { <a asp-controller="Tickets" asp-action="Details" asp-route-id="@e.TicketId" class="text-decoration-none">@Ui.TicketNo(e.Ticket)</a> <div class="small text-muted">@e.Ticket.Title</div> }
                            else { <span class="text-muted">#@e.TicketId</span> }
                        </td>
                        <td><span class="tag tag-red">S@(e.Level)</span></td>
                        <td class="small">
                            @(e.IsManual ? "Manuel" : "Otomatik")
                            @if (e.IsManual && e.TriggeredBy != null) { <div class="text-muted">@e.TriggeredBy.FullName</div> }
                            @if (e.UsedFallback) { <span class="tag tag-amber">yedek</span> }
                        </td>
                        <td>@e.MinutesOverdue dk</td>
                        <td>@(e.EscalatedTo?.FullName ?? "-")</td>
                        <td class="small">@(e.PriorityAfter == null ? "-" : $"{Ui.PriorityText(e.PriorityBefore!.Value)} → {Ui.PriorityText(e.PriorityAfter.Value)}")</td>
                        <td class="small text-muted">@e.Note</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
<partial name="_Pager" model="pager" />
