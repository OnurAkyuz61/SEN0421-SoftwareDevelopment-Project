@model List<SurveyResponse>
@using ServiceDesk.Controllers
@inject CurrentUser Me
@{
    ViewData["Title"] = "Memnuniyet Anketleri";
    var avg = (double)ViewBag.Avg;
    var dist = (int[])ViewBag.Dist;
    var byQuestion = (List<QuestionAverage>)ViewBag.ByQuestion;
    var toplam = dist.Sum();
    var toplamYanit = (int)ViewBag.TotalResponses;
    var pager = (PagerInfo)ViewBag.Pager;
}

@* Şablon yönetimi yalnızca yöneticide; Destek sonuçları görür ama soruları değiştiremez *@
@if (Me.Role == UserRole.Admin)
{
    <div class="d-flex justify-content-end mb-3">
        <a asp-action="Templates" class="btn btn-light border btn-sm">
            <i class="bi bi-ui-checks"></i> Anket şablonları
        </a>
    </div>
}

<div class="row g-3 mb-3">
    <div class="col-md-3">
        <div class="stat">
            <div class="label">Genel memnuniyet</div>
            <div class="value">@avg.ToString("0.00") <span class="text-muted fs-6">/ 5</span></div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="stat"><div class="label">Değerlendirme</div><div class="value">@toplamYanit</div></div>
    </div>
    <div class="col-md-6">
        <div class="panel h-100">
            <div class="panel-head">Puan dağılımı</div>
            <div class="panel-body py-2">
                @for (var s = 5; s >= 1; s--)
                {
                    var adet = dist[s - 1];
                    var oran = toplam == 0 ? 0 : 100.0 * adet / toplam;
                    <div class="d-flex align-items-center gap-2 mb-1">
                        <span class="small text-muted" style="width:12px">@s</span>
                        <div class="flex-grow-1 bg-light rounded" style="height:8px">
                            <div class="rounded" style="height:8px;width:@oran.ToString("0.#")%;background:var(--accent, #0d6efd)"></div>
                        </div>
                        <span class="small text-muted" style="width:28px">@adet</span>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<div class="panel mb-3">
    <div class="panel-head">Soru bazında ortalama <span class="text-muted small fw-normal">hangi boyutta zayıfız</span></div>
    <table class="table table-sm mb-0">
        <tbody>
            @foreach (var q in byQuestion)
            {
                <tr>
                    <td>@q.Text</td>
                    <td style="width:120px" class="text-end">
                        <span class="tag @(q.Average >= 4 ? "tag-green" : q.Average >= 3 ? "tag-amber" : "tag-red")">
                            @q.Average.ToString("0.00") / 5
                        </span>
                    </td>
                    <td style="width:80px" class="text-end small text-muted">@q.Count cevap</td>
                </tr>
            }
        </tbody>
    </table>
</div>

<div class="panel">
    <div class="panel-head">
        <span>
            @if (pager.TotalCount == 0) { <text>Değerlendirme yok</text> }
            else { <text>@pager.TotalCount değerlendirme · sayfa @pager.Page / @pager.TotalPages</text> }
        </span>
    </div>
    <div class="table-responsive">
        <table class="table table-hover">
            <thead><tr><th>Talep</th><th>Dolduran</th><th>Puanlar</th><th>Yorum</th><th class="text-end">Tarih</th></tr></thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr><td colspan="5" class="text-center text-muted py-5">Henüz değerlendirme yok</td></tr>
                }
                @foreach (var r in Model)
                {
                    var ort = r.Answers.Count == 0 ? 0 : r.Answers.Average(a => a.Score);
                    <tr>
                        <td>
                            <a class="fw-semibold text-decoration-none" asp-controller="Tickets" asp-action="Details" asp-route-id="@r.TicketId">
                                @(r.Ticket == null ? "#" + r.TicketId : Ui.TicketNo(r.Ticket))
                            </a>
                            <div class="small text-muted">@r.Ticket?.Title</div>
                        </td>
                        <td class="small">@(r.SubmittedBy?.FullName ?? "-")</td>
                        <td>
                            <span class="tag @(ort >= 4 ? "tag-green" : ort >= 3 ? "tag-amber" : "tag-red")">@ort.ToString("0.0") / 5</span>
                            <div class="small text-muted">
                                @string.Join(" · ", r.Answers.OrderBy(a => a.Question!.SortOrder).Select(a => $"{a.Score}"))
                            </div>
                        </td>
                        <td class="small text-muted">@r.Comment</td>
                        <td class="text-end small text-muted">@AppTime.ToLocal(r.CreatedAt).ToString("dd.MM.yyyy")</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <partial name="_Pager" model="pager" />
</div>
