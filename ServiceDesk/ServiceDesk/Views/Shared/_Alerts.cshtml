@* İşlem sonrası kısa mesajlar (TempData) *@
@if (TempData["Ok"] is string ok)
{
    <div class="alert alert-success d-flex align-items-center gap-2 py-2"><i class="bi bi-check-circle"></i> @ok</div>
}
@if (TempData["Err"] is string err)
{
    <div class="alert alert-danger d-flex align-items-center gap-2 py-2"><i class="bi bi-exclamation-circle"></i> @err</div>
}
