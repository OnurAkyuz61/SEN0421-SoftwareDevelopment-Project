@* Dosya / ekran görüntüsü yükleme alanı (wwwroot/js/upload.js ile çalışır).
   Aynı sayfada birden fazla kez kullanılabilsin diye id'ler benzersiz üretilir. *@
@{
    var uid = "up" + Guid.NewGuid().ToString("N")[..8];
}
<div data-upload>
    <input type="file" name="files" multiple class="d-none" id="@(uid)-file"
           accept=".png,.jpg,.jpeg,.gif,.webp,.pdf,.doc,.docx,.xls,.xlsx,.txt,.log,.zip" />
    <input type="file" accept="image/*" class="d-none" id="@(uid)-shot" data-image-picker />

    <div class="dropzone">
        <i class="bi bi-cloud-arrow-up fs-2 text-muted"></i>
        <div class="fw-semibold mt-1">Dosyaları buraya sürükleyin</div>
        <div class="small text-muted mb-3">veya ekran görüntüsünü <kbd>Ctrl</kbd> + <kbd>V</kbd> ile yapıştırın</div>
        <div class="d-flex justify-content-center gap-2 flex-wrap">
            <label for="@(uid)-file" class="btn btn-outline-secondary btn-sm mb-0"><i class="bi bi-paperclip"></i> Dosya Seç</label>
            <label for="@(uid)-shot" class="btn btn-outline-secondary btn-sm mb-0"><i class="bi bi-camera"></i> Ekran Görüntüsü</label>
        </div>
        <div class="small text-muted mt-3">PNG, JPG, PDF, Word, Excel, TXT, ZIP · en fazla 5 dosya · dosya başına 10 MB</div>
        <ul class="file-list"></ul>
    </div>
</div>
