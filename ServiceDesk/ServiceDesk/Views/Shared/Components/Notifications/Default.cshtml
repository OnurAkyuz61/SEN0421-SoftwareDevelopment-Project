@model ServiceDesk.ViewComponents.BellVm
@{
    var count = Model.UnreadCount;
    var badge = count > 9 ? "9+" : count.ToString();
}

<div class="dropdown" data-bell data-unread-url="@Url.Action("UnreadCount", "Notifications")" data-poll="@Model.PollSeconds">
    <button class="btn btn-light position-relative bell" type="button" data-bs-toggle="dropdown" data-bs-auto-close="outside"
            aria-expanded="false" title="Bildirimler" aria-label="Bildirimler@(count > 0 ? $", {count} okunmamış" : "")">
        <i class="bi bi-bell@(count > 0 ? "-fill" : "")" data-bell-icon></i>
        <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger @(count > 0 ? "" : "d-none")" data-bell-badge>
            @badge
        </span>
    </button>
    <div class="dropdown-menu dropdown-menu-end shadow notif-menu">
        <div class="notif-menu-head">
            <span class="fw-semibold">Bildirimler</span>
            @if (count > 0)
            {
                <form asp-controller="Notifications" asp-action="MarkRead" method="post" class="m-0">
                    <input type="hidden" name="returnUrl" value="@Context.Request.Path@Context.Request.QueryString" />
                    <button type="submit" class="btn btn-link btn-sm p-0 text-decoration-none">Tümünü okundu say</button>
                </form>
            }
        </div>

        @if (!Model.Items.Any())
        {
            <div class="notif-empty">
                <i class="bi bi-bell-slash"></i>
                <span>Yeni bildirim yok</span>
            </div>
        }
        else
        {
            <div class="notif-list">
                @foreach (var n in Model.Items)
                {
                    <a class="notif-item" asp-controller="Notifications" asp-action="Open" asp-route-id="@n.Id">
                        <span class="notif-icon text-@NotificationService.Color(n.Type)">
                            <i class="bi @NotificationService.Describe(n.Type)"></i>
                        </span>
                        <span class="notif-body">
                            <span class="notif-title">@n.Title</span>
                            <span class="notif-msg">@n.Message</span>
                            <span class="notif-time">@AppTime.ToLocal(n.CreatedAt).ToString("dd.MM HH:mm")</span>
                        </span>
                    </a>
                }
            </div>
            @if (count > Model.Items.Count)
            {
                <div class="small text-muted px-3 py-1">+@(count - Model.Items.Count) okunmamış daha</div>
            }
        }

        <a class="notif-footer" asp-controller="Notifications" asp-action="Index">Tüm bildirimleri gör</a>
    </div>
</div>

<script>
    // Hafif sayaç yoklaması: sayfa görünürken PollSeconds'ta bir yalnızca
    // okunmamış sayısı alınır; değiştiyse rozet güncellenir.
    (function () {
        var root = document.currentScript.previousElementSibling;
        if (!root || !root.hasAttribute('data-bell')) return;
        var url = root.getAttribute('data-unread-url');
        var poll = Math.max(15, parseInt(root.getAttribute('data-poll') || '60', 10)) * 1000;
        var badge = root.querySelector('[data-bell-badge]');
        var icon = root.querySelector('[data-bell-icon]');

        function apply(n) {
            badge.textContent = n > 9 ? '9+' : String(n);
            badge.classList.toggle('d-none', n === 0);
            icon.className = 'bi bi-bell' + (n > 0 ? '-fill' : '');
            document.querySelectorAll('[data-unread-count]').forEach(function (el) {
                el.textContent = n > 0 ? '(' + n + ')' : '';
            });
        }

        function tick() {
            if (document.hidden) return;
            fetch(url, { headers: { 'Accept': 'application/json' }, credentials: 'same-origin', redirect: 'error' })
                .then(function (r) { return r.ok ? r.json() : null; })
                .then(function (d) { if (d && typeof d.count === 'number') apply(d.count); })
                .catch(function () { /* oturum kapanmış olabilir; sessiz geç */ });
        }

        setInterval(tick, poll);
        document.addEventListener('visibilitychange', function () { if (!document.hidden) tick(); });
    })();
</script>
