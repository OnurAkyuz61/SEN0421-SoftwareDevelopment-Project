@* YÖNETİM PANELİ LAYOUT'U
   ┌──────────┬───────────────────────────────┐
   │ sidebar  │ üst bar (başlık, bildirim, kullanıcı menüsü)
   │ (koyu)   ├───────────────────────────────┤
   │          │ sayfa içeriği                 │
   └──────────┴───────────────────────────────┘
   992px altında sidebar soldan açılan menüye dönüşür (☰ düğmesi). *@
@inject ServiceDesk.Data.AppDbContext Db
@inject CurrentUser Me
@{
    var c = ViewContext.RouteData.Values["controller"]?.ToString();
    string Act(string ctrl) => c == ctrl ? "active" : "";
    string? Cur(string ctrl) => c == ctrl ? "page" : null;
    var pendingCount = Db.Tickets.Count(t => t.ApprovalStatus == ApprovalStatus.Pending);
    var ncCount = Db.Nonconformities.Count(n => n.Status != NonconformityStatus.Closed);
    var area = c switch
    {
        "Surveys" or "Nonconformities" or "Knowledge" => "Kalite",
        "Users" or "Catalog" or "EscalationRules" => "Yönetim",
        _ => "Servis Masası"
    };
}
<!DOCTYPE html>
<html lang="tr">
<head>
    <partial name="_ThemeHead" />
    <title>@ViewData["Title"] · ServiceDesk Yönetim</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <a class="visually-hidden-focusable position-absolute m-2 btn btn-primary btn-sm" href="#content">İçeriğe geç</a>

    <div class="app-shell">
        <aside class="sidebar" id="appSidebar" aria-label="Ana menü">
            <div class="sidebar-head">
                <a class="brand" asp-controller="Dashboard" asp-action="Index">
                    <span class="brand-mark"><i class="bi bi-headset"></i></span>
                    <span>ServiceDesk<small>Yönetim Paneli</small></span>
                </a>
                <button type="button" class="sidebar-close" data-sidebar-close aria-label="Menüyü kapat"><i class="bi bi-x"></i></button>
            </div>

            <div class="sidebar-scroll">
                <div class="side-label">Servis Masası</div>
                <nav class="nav flex-column">
                    <a class="nav-link @Act("Dashboard")" aria-current="@Cur("Dashboard")" asp-controller="Dashboard" asp-action="Index"><i class="bi bi-grid-1x2"></i><span>Genel Bakış</span></a>
                    <a class="nav-link @Act("Tickets")" aria-current="@Cur("Tickets")" asp-controller="Tickets" asp-action="Index"><i class="bi bi-inbox"></i><span>Talepler</span></a>
                    <a class="nav-link" asp-controller="Tickets" asp-action="Archived"><i class="bi bi-archive"></i><span>Arşiv</span></a>
                    <a class="nav-link @Act("Approvals")" aria-current="@Cur("Approvals")" asp-controller="Approvals" asp-action="Index">
                        <i class="bi bi-check2-square"></i><span>Onaylar</span>
                        @if (pendingCount > 0) { <span class="nav-count" title="Onay bekleyen">@pendingCount</span> }
                    </a>
                    <a class="nav-link @Act("Notifications")" aria-current="@Cur("Notifications")" asp-controller="Notifications" asp-action="Index"><i class="bi bi-bell"></i><span>Bildirimler</span></a>
                </nav>

                <div class="side-label">Kalite · ISO 9001</div>
                <nav class="nav flex-column">
                    <a class="nav-link @Act("Surveys")" aria-current="@Cur("Surveys")" asp-controller="Surveys" asp-action="Index"><i class="bi bi-chat-square-heart"></i><span>Anketler</span></a>
                    <a class="nav-link @Act("Nonconformities")" aria-current="@Cur("Nonconformities")" asp-controller="Nonconformities" asp-action="Index">
                        <i class="bi bi-clipboard2-x"></i><span>Uygunsuzluklar</span>
                        @if (ncCount > 0) { <span class="nav-count" title="Açık kayıt">@ncCount</span> }
                    </a>
                    <a class="nav-link @Act("Knowledge")" aria-current="@Cur("Knowledge")" asp-controller="Knowledge" asp-action="Index"><i class="bi bi-journal-text"></i><span>Bilgi Bankası</span></a>
                </nav>

                <div class="side-label">Yönetim</div>
                <nav class="nav flex-column">
                    <a class="nav-link @Act("Users")" aria-current="@Cur("Users")" asp-controller="Users" asp-action="Index"><i class="bi bi-people"></i><span>Kullanıcılar</span></a>
                    @if (Me.Role == UserRole.Admin)
                    {
                        <a class="nav-link @Act("EscalationRules")" aria-current="@Cur("EscalationRules")" asp-controller="EscalationRules" asp-action="Index"><i class="bi bi-arrow-up-circle"></i><span>Eskalasyon</span></a>
                        <a class="nav-link @Act("Catalog")" aria-current="@Cur("Catalog")" asp-controller="Catalog" asp-action="Index"><i class="bi bi-tags"></i><span>Katalog</span></a>
                        <a class="nav-link @Act("MessageQueue")" aria-current="@Cur("MessageQueue")" asp-controller="MessageQueue" asp-action="Index"><i class="bi bi-envelope-exclamation"></i><span>E-posta / SMS kuyruğu</span></a>
                        <a class="nav-link @Act("Audit")" aria-current="@Cur("Audit")" asp-controller="Audit" asp-action="Index"><i class="bi bi-shield-check"></i><span>Denetim kaydı</span></a>
                    }
                    <a class="nav-link @Act("Reports")" aria-current="@Cur("Reports")" asp-controller="Reports" asp-action="Escalations"><i class="bi bi-graph-up-arrow"></i><span>Eskalasyon raporu</span></a>
                    <a class="nav-link" asp-controller="Reports" asp-action="KnowledgeUsage"><i class="bi bi-journal-check"></i><span>Makale kullanımı</span></a>
                    <a class="nav-link" asp-controller="Portal" asp-action="Index"><i class="bi bi-box-arrow-up-right"></i><span>Kullanıcı Portalı</span></a>
                </nav>
            </div>

            <div class="sidebar-foot">
                @if (Me.IsAuthenticated)
                {
                    <div class="user-card">
                        <span class="avatar">@Me.Initials</span>
                        <div class="who">
                            <strong title="@Me.DisplayName">@Me.DisplayName</strong>
                            <span>@Ui.RoleText(Me.Role!.Value)</span>
                        </div>
                        <form asp-controller="Account" asp-action="Logout" method="post" class="ms-auto">
                            <button type="submit" class="btn-icon" title="Çıkış yap" aria-label="Çıkış yap"><i class="bi bi-box-arrow-right"></i></button>
                        </form>
                    </div>
                }
                <div class="iso-chip"><i class="bi bi-patch-check"></i> ISO 9001 · SDS-07</div>
            </div>
        </aside>
        <div class="sidebar-backdrop" data-sidebar-close></div>

        <div class="main">
            <header class="topbar">
                <button type="button" class="btn-icon menu-toggle" data-sidebar-open aria-label="Menüyü aç" aria-controls="appSidebar">
                    <i class="bi bi-list"></i>
                </button>
                <div class="page-title">
                    <div class="crumb">@area</div>
                    <h1>@ViewData["Title"]</h1>
                </div>

                <div class="topbar-actions">
                    @await Component.InvokeAsync("Notifications")

                    @if (Me.IsAuthenticated)
                    {
                        <div class="dropdown">
                            <button class="user-menu-btn" type="button" data-bs-toggle="dropdown" aria-expanded="false" aria-label="Hesap menüsü">
                                <span class="avatar avatar-sm">@Me.Initials</span>
                                <span class="d-none d-md-inline">@Me.User!.FirstName</span>
                                <i class="bi bi-chevron-down d-none d-md-inline"></i>
                            </button>
                            <div class="dropdown-menu dropdown-menu-end" style="min-width:240px">
                                <div class="user-menu-head">
                                    <strong>@Me.DisplayName</strong>
                                    <span>@Me.User!.Email</span><br />
                                    <span class="role-pill"><i class="bi bi-shield-check"></i> @Ui.RoleText(Me.Role!.Value)</span>
                                </div>
                                <div class="dropdown-divider"></div>
                                <a class="dropdown-item" asp-controller="Profile" asp-action="Index"><i class="bi bi-person me-2"></i>Profilim</a>
                                <a class="dropdown-item" asp-controller="Portal" asp-action="Index"><i class="bi bi-box-arrow-up-right me-2"></i>Kullanıcı Portalı</a>
                                <a class="dropdown-item" asp-controller="Notifications" asp-action="Index"><i class="bi bi-bell me-2"></i>Bildirimler</a>
                                <div class="dropdown-divider"></div>
                                <form asp-controller="Account" asp-action="Logout" method="post">
                                    <button type="submit" class="dropdown-item text-danger"><i class="bi bi-box-arrow-right me-2"></i>Çıkış yap</button>
                                </form>
                            </div>
                        </div>
                    }
                    else
                    {
                        <a class="btn btn-primary btn-sm" asp-controller="Account" asp-action="Login">
                            <i class="bi bi-box-arrow-in-right"></i> Giriş Yap
                        </a>
                    }
                </div>
            </header>

            <main id="content" class="page-wrap">
                <partial name="_Alerts" />
                @RenderBody()
            </main>
        </div>
    </div>

    @* Chatbot henüz çalışmıyor; _ChatbotPartial hazır olunca buraya eklenecek *@
    <partial name="_SessionTimeout" />

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
