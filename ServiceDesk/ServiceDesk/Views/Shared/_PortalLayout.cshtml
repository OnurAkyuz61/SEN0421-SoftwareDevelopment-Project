@* KULLANICI PORTALI LAYOUT'U
   Üstte sabit menü, ortada dar içerik alanı, altta kısa bilgi satırı.
   768px altında menü linkleri ☰ düğmesiyle açılan listeye taşınır. *@
@inject CurrentUser Me
@{
    var a = ViewContext.RouteData.Values["action"]?.ToString();
    var ctrl = ViewContext.RouteData.Values["controller"]?.ToString();
    var isMine = ctrl == "Portal" && a is "Index" or "Details";
    var isNew = ctrl == "Portal" && a == "Create";
    var isKb = ctrl == "Knowledge";
}
<!DOCTYPE html>
<html lang="tr">
<head>
    <partial name="_ThemeHead" />
    <title>@ViewData["Title"] · ServiceDesk</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="portal-body">
    <a class="visually-hidden-focusable position-absolute m-2 btn btn-primary btn-sm" href="#content">İçeriğe geç</a>

    <header class="portal-nav">
        <div class="container portal-wrap">
            <div class="bar">
                <a class="brand me-2" asp-controller="Portal" asp-action="Index">
                    <span class="brand-mark"><i class="bi bi-headset"></i></span><span>ServiceDesk</span>
                </a>

                <nav class="nav gap-1 desktop-nav" aria-label="Portal menüsü">
                    <a class="nav-link @(isMine ? "active" : "")" asp-controller="Portal" asp-action="Index"><i class="bi bi-inbox me-1"></i>Taleplerim</a>
                    <a class="nav-link @(isKb ? "active" : "")" asp-controller="Knowledge" asp-action="Index"><i class="bi bi-journal-text me-1"></i>Bilgi Bankası</a>
                </nav>

                <div class="ms-auto d-flex align-items-center gap-2">
                    <a class="btn btn-primary btn-sm d-none d-sm-inline-flex align-items-center gap-1 @(isNew ? "active" : "")" asp-controller="Portal" asp-action="Create">
                        <i class="bi bi-plus-lg"></i> Yeni Talep
                    </a>

                    @if (Me.IsAuthenticated)
                    {
                        <div class="dropdown">
                            <button class="user-menu-btn" type="button" data-bs-toggle="dropdown" aria-expanded="false" aria-label="Hesap menüsü">
                                <span class="avatar avatar-sm">@Me.Initials</span>
                                <span class="d-none d-lg-inline">@Me.User!.FirstName</span>
                                <i class="bi bi-chevron-down d-none d-lg-inline"></i>
                            </button>
                            <div class="dropdown-menu dropdown-menu-end" style="min-width:240px">
                                <div class="user-menu-head">
                                    <strong>@Me.DisplayName</strong>
                                    <span>@Me.User!.Email</span><br />
                                    <span class="role-pill"><i class="bi bi-person"></i> @Ui.RoleText(Me.Role!.Value)</span>
                                </div>
                                <div class="dropdown-divider"></div>
                                @if (Me.IsStaff)
                                {
                                    <a class="dropdown-item" asp-controller="Dashboard" asp-action="Index"><i class="bi bi-grid-1x2 me-2"></i>Yönetim Paneli</a>
                                }
                                <a class="dropdown-item" asp-controller="Portal" asp-action="Index"><i class="bi bi-inbox me-2"></i>Taleplerim</a>
                                <div class="dropdown-divider"></div>
                                <form asp-controller="Account" asp-action="Logout" method="post">
                                    <button type="submit" class="dropdown-item text-danger"><i class="bi bi-box-arrow-right me-2"></i>Çıkış yap</button>
                                </form>
                            </div>
                        </div>
                    }
                    else
                    {
                        <a class="btn btn-outline-secondary btn-sm" asp-controller="Account" asp-action="Login"><i class="bi bi-box-arrow-in-right"></i> Giriş Yap</a>
                    }

                    <button class="btn-icon d-md-none" type="button" data-bs-toggle="collapse" data-bs-target="#portalMobileNav"
                            aria-controls="portalMobileNav" aria-expanded="false" aria-label="Menüyü aç">
                        <i class="bi bi-list"></i>
                    </button>
                </div>
            </div>

            <nav class="collapse portal-mobile-nav" id="portalMobileNav" aria-label="Portal menüsü (mobil)">
                <a class="nav-link @(isMine ? "active" : "")" asp-controller="Portal" asp-action="Index"><i class="bi bi-inbox"></i>Taleplerim</a>
                <a class="nav-link @(isNew ? "active" : "")" asp-controller="Portal" asp-action="Create"><i class="bi bi-plus-circle"></i>Yeni Talep</a>
                <a class="nav-link @(isKb ? "active" : "")" asp-controller="Knowledge" asp-action="Index"><i class="bi bi-journal-text"></i>Bilgi Bankası</a>
                @if (Me.IsStaff)
                {
                    <a class="nav-link" asp-controller="Dashboard" asp-action="Index"><i class="bi bi-grid-1x2"></i>Yönetim Paneli</a>
                }
            </nav>
        </div>
    </header>

    <main id="content" class="container portal-wrap py-4">
        <partial name="_Alerts" />
        @RenderBody()
    </main>

    <footer class="portal-foot">
        @* Sağ alt köşe sohbet düğmesine ayrıldığı için yazılar solda toplanır *@
        <div class="container portal-wrap d-flex flex-wrap gap-2 py-3">
            <span><i class="bi bi-patch-check me-1"></i>ISO 9001 uyumlu IT Servis Masası</span>
            <span>·</span>
            <span>SEN0421 · SDS-07</span>
        </div>
    </footer>

    <partial name="_ChatbotPartial" />
    <partial name="_SessionTimeout" />

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
