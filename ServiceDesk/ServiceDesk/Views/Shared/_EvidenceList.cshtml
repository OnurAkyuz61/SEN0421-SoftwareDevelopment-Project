@model Nonconformity
@* Uygunsuzluğun KANIT dosyaları (md. 10.2.2). Talep ekleri listesiyle aynı
   kurallar: tarama temiz sonuçlanmayan dosyaya bağlantı verilmez, durumu
   yazılır — ve o dosya kanıt sayılmaz, yani kayıt onunla kapatılamaz.

   Kayıt henüz kapanmadıysa kaldırma düğmesi gösterilir; kapanmış
   uygunsuzluğun kanıtı dondurulur (NonconformityClosure.CheckEvidenceRemoval
   aynı kuralı sunucuda uygular).

   Bu partial kayıt formunun DIŞINDA çizilir: kaldırma kendi formunu açıyor,
   iç içe form olamaz. *@
@{
    var acik = Model.Status != NonconformityStatus.Closed;
    var kanitlar = Model.Attachments.ToList();
}
@if (kanitlar.Count == 0)
{
    <div class="text-muted small">
        Kanıt dosyası yok · kapatmak için en az bir dosya zorunlu <span class="text-danger">*</span>
    </div>
}
else
{
    <div class="attach-grid">
        @foreach (var f in kanitlar)
        {
            <div class="attach-item">
                @if (f.IsServable)
                {
                    <a class="attach" asp-controller="Nonconformities" asp-action="Evidence" asp-route-id="@f.Id"
                       target="_blank" title="@f.FileName">
                        <div class="thumb">
                            @if (f.IsImage)
                            {
                                <img src="@Url.Action("Evidence", "Nonconformities", new { id = f.Id })" alt="@f.FileName" loading="lazy" />
                            }
                            else
                            {
                                <i class="bi @(f.FileName.EndsWith(".pdf", StringComparison.OrdinalIgnoreCase) ? "bi-file-earmark-pdf" : "bi-file-earmark")"></i>
                            }
                        </div>
                        <div class="meta">
                            <div class="fw-semibold">@f.FileName</div>
                            <div class="text-muted">
                                @Ui.FileSize(f.Size)
                                @if (f.UploadedBy != null) { <text> · @f.UploadedBy.FullName</text> }
                            </div>
                        </div>
                    </a>
                }
                else
                {
                    @* Taranmamış / şüpheli dosya: bağlantı yok, neden yazılı *@
                    <div class="attach attach-blocked" title="@f.FileName">
                        <div class="thumb"><i class="bi bi-shield-exclamation"></i></div>
                        <div class="meta">
                            <div class="fw-semibold">@f.FileName</div>
                            <div><span class="tag @Ui.ScanStatusTag(f.ScanStatus)">@Ui.ScanStatusText(f.ScanStatus)</span></div>
                        </div>
                    </div>
                }

                @if (acik)
                {
                    <form asp-controller="Nonconformities" asp-action="RemoveEvidence" asp-route-id="@f.Id"
                          method="post" class="attach-del">
                        <button class="btn btn-sm btn-light border text-danger" title="Kanıt dosyasını kaldır"
                                onclick="return confirm('&quot;@f.FileName&quot; kaldırılsın mı? Kayıt kanıtsız kalırsa kapatılamaz.');">
                            <i class="bi bi-trash"></i>
                        </button>
                    </form>
                }
            </div>
        }
    </div>
}
