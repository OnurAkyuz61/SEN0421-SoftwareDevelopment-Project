@model ProfilePageVm
@inject CurrentUser Me
@{
    ViewData["Title"] = "Profilim";
    Layout = Me.IsStaff ? "_Layout" : "_PortalLayout";
}

<div class="row g-4">
    <div class="col-lg-7">
        <div class="panel">
            <div class="panel-head">Kişisel bilgiler</div>
            <div class="panel-body">
                <form asp-action="Update" method="post" novalidate>
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label asp-for="Profile.FirstName" class="form-label"></label>
                            <input asp-for="Profile.FirstName" class="form-control" autocomplete="given-name" />
                            <span asp-validation-for="Profile.FirstName" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Profile.LastName" class="form-label"></label>
                            <input asp-for="Profile.LastName" class="form-control" autocomplete="family-name" />
                            <span asp-validation-for="Profile.LastName" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">E-posta</label>
                            <input class="form-control" value="@Model.Profile.Email" disabled />
                            <div class="form-text">E-posta adresi yalnızca yönetici tarafından değiştirilebilir.</div>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Profile.PhoneNumber" class="form-label"></label>
                            <input asp-for="Profile.PhoneNumber" class="form-control" autocomplete="tel" placeholder="+90 5xx xxx xx xx" />
                            <span asp-validation-for="Profile.PhoneNumber" class="text-danger small"></span>
                            <div class="form-text">OTP doğrulaması bu numaraya gönderilir; numara silinemez, yalnızca değiştirilebilir.</div>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Rol</label>
                            <input class="form-control" value="@Model.Profile.RoleText" disabled />
                        </div>
                    </div>
                    <div class="mt-4">
                        <button type="submit" class="btn btn-primary">
                            <i class="bi bi-check-lg"></i> Kaydet
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <div class="col-lg-5">
        <div class="panel">
            <div class="panel-head">Şifre değiştir</div>
            <div class="panel-body">
                <form asp-action="ChangePassword" method="post" novalidate>
                    <div class="mb-3">
                        <label asp-for="Password.CurrentPassword" class="form-label"></label>
                        <input asp-for="Password.CurrentPassword" class="form-control" autocomplete="current-password" />
                        <span asp-validation-for="Password.CurrentPassword" class="text-danger small"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Password.NewPassword" class="form-label"></label>
                        <input asp-for="Password.NewPassword" class="form-control" autocomplete="new-password" />
                        <span asp-validation-for="Password.NewPassword" class="text-danger small"></span>
                        <div class="form-text">@PasswordRules.Hint</div>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Password.ConfirmPassword" class="form-label"></label>
                        <input asp-for="Password.ConfirmPassword" class="form-control" autocomplete="new-password" />
                        <span asp-validation-for="Password.ConfirmPassword" class="text-danger small"></span>
                    </div>
                    <button type="submit" class="btn btn-outline-primary">
                        <i class="bi bi-key"></i> Şifreyi güncelle
                    </button>
                </form>
            </div>
        </div>
    </div>

    <div class="col-12">
        <div class="panel">
            <div class="panel-head">Bildirim tercihleri</div>
            <div class="panel-body">
                <form asp-action="Preferences" method="post">
                    <div class="table-responsive">
                        <table class="table table-sm align-middle mb-3">
                            <thead>
                                <tr>
                                    <th>Bildirim türü</th>
                                    <th class="text-center">Uygulama içi</th>
                                    <th class="text-center">E-posta</th>
                                    <th class="text-center">SMS</th>
                                </tr>
                            </thead>
                            <tbody>
                                @for (var i = 0; i < Model.Preferences.Count; i++)
                                {
                                    var p = Model.Preferences[i];
                                    var rule = NotificationChannelPolicy.RuleFor(p.Type);
                                    <tr>
                                        <td>
                                            <i class="bi @NotificationService.Describe(p.Type) text-@NotificationService.Color(p.Type) me-1"></i>
                                            @NotificationService.TypeText(p.Type)
                                            <input type="hidden" name="prefs[@i].Type" value="@p.Type" />
                                        </td>
                                        <td class="text-center">
                                            @if (rule.InAppLocked)
                                            {
                                                <input type="checkbox" class="form-check-input" checked disabled title="Bu tür için uygulama içi bildirim kapatılamaz" />
                                                <input type="hidden" name="prefs[@i].InApp" value="true" />
                                            }
                                            else
                                            {
                                                <input type="checkbox" class="form-check-input" name="prefs[@i].InApp" value="true" checked="@p.InApp" />
                                            }
                                        </td>
                                        <td class="text-center">
                                            <input type="checkbox" class="form-check-input" name="prefs[@i].Email" value="true" checked="@p.Email" />
                                        </td>
                                        <td class="text-center">
                                            @if (rule.SmsAllowed)
                                            {
                                                <input type="checkbox" class="form-check-input" name="prefs[@i].Sms" value="true" checked="@p.Sms"
                                                       disabled="@(!Model.HasPhone)" title="@(Model.HasPhone ? "" : "Telefon numarası tanımlı değil")" />
                                            }
                                            else
                                            {
                                                <span class="text-muted small">—</span>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                    <div class="form-check mb-3">
                        <input type="checkbox" class="form-check-input" id="dailyDigest" name="dailyDigest" value="true" checked="@Model.DailyDigestEnabled" />
                        <label class="form-check-label" for="dailyDigest">Her sabah günlük özet e-postası gönder</label>
                        <div class="form-text">Açık talepleriniz, SLA durumu ve okunmamış bildirimlerin özeti.</div>
                    </div>

                    <button type="submit" class="btn btn-primary"><i class="bi bi-bell"></i> Tercihleri kaydet</button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
