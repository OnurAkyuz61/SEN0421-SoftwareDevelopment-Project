@model Ticket
@{ ViewData["Title"] = "Yeni Talep"; }

<form asp-action="Create" method="post" class="card-soft p-4" style="max-width:700px">
    <h5 class="fw-semibold mb-3"><i class="bi bi-plus-circle text-success"></i> Yeni Destek Talebi</h5>
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <div class="mb-3">
        <label asp-for="Title" class="form-label"></label>
        <input asp-for="Title" class="form-control" />
        <span asp-validation-for="Title" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Description" class="form-label"></label>
        <textarea asp-for="Description" class="form-control" rows="4"></textarea>
        <span asp-validation-for="Description" class="text-danger"></span>
    </div>
    <div class="row">
        <div class="col mb-3">
            <label asp-for="Type" class="form-label"></label>
            <select asp-for="Type" asp-items="Html.GetEnumSelectList<TicketType>()" class="form-select"></select>
        </div>
        <div class="col mb-3">
            <label asp-for="Priority" class="form-label"></label>
            <select asp-for="Priority" asp-items="Html.GetEnumSelectList<Priority>()" class="form-select"></select>
        </div>
    </div>
    <div class="mb-3">
        <label asp-for="RequesterName" class="form-label"></label>
        <input asp-for="RequesterName" class="form-control" />
        <span asp-validation-for="RequesterName" class="text-danger"></span>
    </div>

    <!-- EKLER (şimdilik sadece tasarım, yükleme yapmaz) -->
    <div class="mb-3">
        <label class="form-label">Ekler <span class="badge bg-warning text-dark ms-1">Yakında</span></label>
        <div class="dropzone text-center p-4">
            <i class="bi bi-cloud-arrow-up fs-1 text-primary"></i>
            <div class="fw-semibold">Dosyaları buraya sürükleyin</div>
            <div class="small text-muted mb-3">PNG, JPG, PDF, DOCX · en fazla 10 MB</div>
            <div class="d-flex justify-content-center gap-2 flex-wrap">
                <button type="button" class="btn btn-outline-primary btn-sm" disabled><i class="bi bi-paperclip"></i> Dosya Ekle</button>
                <button type="button" class="btn btn-outline-success btn-sm" disabled><i class="bi bi-camera"></i> Ekran Görüntüsü Ekle</button>
            </div>
        </div>
    </div>

    <div class="alert alert-info small py-2"><i class="bi bi-info-circle"></i> SLA süresi önceliğe göre otomatik hesaplanır (Kritik 4s · Yüksek 8s · Orta 24s · Düşük 72s).</div>
    <button class="btn btn-success px-4"><i class="bi bi-save"></i> Kaydet</button>
</form>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
