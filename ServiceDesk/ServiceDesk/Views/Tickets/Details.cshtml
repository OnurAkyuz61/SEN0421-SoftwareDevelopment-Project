@model Ticket
@inject CurrentUser Me
@{
    ViewData["Title"] = "Talep " + Ui.TicketNo(Model);
    var arsiv = Model.IsDeleted;
    var onayBaglami = (ApprovalContext)ViewBag.ApprovalContext;
    var eskalasyonPersonel = ViewBag.EscalationStaff as List<AppUser> ?? new List<AppUser>();
    var maxResubmit = (int)(ViewBag.MaxResubmissions ?? 3);
    // Mevcut duruma göre gösterilecek butonlar (Yeni → İşlemde → Çözüldü → Kapandı)
    var sonraki = Model.Status switch
    {
        TicketStatus.New => new[] { TicketStatus.InProgress, TicketStatus.WaitingForCustomer, TicketStatus.Resolved },
        TicketStatus.InProgress => new[] { TicketStatus.WaitingForCustomer, TicketStatus.Resolved },
        TicketStatus.WaitingForCustomer => new[] { TicketStatus.InProgress, TicketStatus.Resolved },
        TicketStatus.Resolved => new[] { TicketStatus.Closed, TicketStatus.InProgress },
        _ => new[] { TicketStatus.InProgress }
    };
    var kapanisVar = sonraki.Any(TicketWorkflow.IsFinished) && Model.ResolutionCode == null;
    var takipciAdaylari = ViewBag.FollowerCandidates as List<AppUser> ?? new List<AppUser>();
    // Reddedilen değişiklik talebi işleme alınamaz, sadece kapatılabilir
    if (Model.ApprovalStatus == ApprovalStatus.Rejected)
        sonraki = Model.Status == TicketStatus.Closed ? Array.Empty<TicketStatus>() : new[] { TicketStatus.Closed };
}

@if (arsiv)
{
    <a asp-action="Archived" class="text-decoration-none small"><i class="bi bi-arrow-left"></i> Arşiv</a>
}
else
{
    <a asp-action="Index" class="text-decoration-none small"><i class="bi bi-arrow-left"></i> Talepler</a>
}

<div class="d-flex flex-wrap align-items-center gap-2 mt-2 mb-3">
    <h4 class="fw-bold mb-0 me-auto">@Ui.TicketNo(Model) · @Model.Title</h4>
    <span class="tag @Ui.PriorityTag(Model.Priority)">@Ui.PriorityText(Model.Priority)</span>
    <span class="tag @Ui.StatusTag(Model.Status)">@Ui.StatusText(Model.Status)</span>
    @if (Model.ApprovalStatus != ApprovalStatus.NotRequired) { <span class="tag @Ui.ApprovalTag(Model.ApprovalStatus)">@Ui.ApprovalText(Model.ApprovalStatus)</span> }
    @if (Model.IsFirstResponseBreached) { <span class="tag tag-amber"><i class="bi bi-hourglass-bottom"></i> İlk yanıt ihlali</span> }
    @if (Model.IsSlaBreached) { <span class="tag tag-red"><i class="bi bi-exclamation-triangle"></i> SLA ihlali</span> }
    @if (Model.SlaPausedAt != null) { <span class="tag tag-gray"><i class="bi bi-pause-circle"></i> SLA durdu</span> }
    @if (arsiv) { <span class="tag tag-gray"><i class="bi bi-archive"></i> Arşivlenmiş</span> }
</div>

@if (arsiv)
{
    <div class="alert alert-warning border d-flex gap-2 align-items-start mb-3">
        <i class="bi bi-archive mt-1"></i>
        <div>
            <strong>Bu talep arşivlenmiş.</strong> Kayıt silinmedi; salt okunur görüntüleniyor.
            <div class="small mt-1">
                @(Model.DeletedAt == null ? "" : AppTime.ToLocal(Model.DeletedAt.Value).ToString("dd.MM.yyyy HH:mm"))
                · @(Model.DeletedBy?.FullName ?? "bilinmeyen")
                @if (!string.IsNullOrWhiteSpace(Model.DeleteReason))
                {
                    <span>· Neden: @Model.DeleteReason</span>
                }
            </div>
        </div>
        @if (Me.Role == UserRole.Admin)
        {
            <form asp-action="Restore" asp-route-id="@Model.Id" method="post" class="ms-auto"
                  onsubmit="return confirm('Talep arşivden geri yüklensin mi?');">
                <button class="btn btn-sm btn-outline-success text-nowrap"><i class="bi bi-arrow-counterclockwise"></i> Geri yükle</button>
            </form>
        }
    </div>
}

@if (Model.MergedIntoTicketId != null)
{
    <div class="alert alert-info border d-flex gap-2 align-items-center mb-3">
        <i class="bi bi-intersect"></i>
        <div>Bu talep mükerrer olarak birleştirildi.
            <a asp-action="Details" asp-route-id="@Model.MergedIntoTicketId">Asıl talebe git</a></div>
    </div>
}

@if (Model.CancelRequestedAt != null && !arsiv)
{
    <div class="alert alert-warning border mb-3">
        <div class="d-flex gap-2 align-items-start">
            <i class="bi bi-x-octagon mt-1"></i>
            <div class="flex-grow-1">
                <strong>Kullanıcı iptal istedi</strong>
                <span class="small text-muted">· @AppTime.ToLocal(Model.CancelRequestedAt.Value).ToString("dd.MM.yyyy HH:mm")</span>
                <div class="small mt-1">Neden: @Model.CancelReason</div>
            </div>
        </div>
        <form asp-action="DecideCancel" asp-route-id="@Model.Id" method="post" class="d-flex flex-wrap gap-2 mt-2">
            <input type="hidden" name="rowVersion" value="@TicketConcurrency.Encode(Model.RowVersion)" />
            <input name="note" maxlength="500" class="form-control form-control-sm" style="max-width:420px"
                   placeholder="Not (redde zorunlu)" />
            <button name="approve" value="true" class="btn btn-sm btn-danger"
                    onclick="return confirm('Talep iptal edilip kapatılsın mı?')">İptali onayla</button>
            <button name="approve" value="false" class="btn btn-sm btn-outline-secondary">Reddet</button>
        </form>
    </div>
}

<div class="row g-3">
    <div class="col-lg-8">
        <div class="panel mb-3">
            <div class="panel-head">Açıklama</div>
            <div class="panel-body" style="white-space:pre-line">@Model.Description</div>
        </div>
        <div class="panel mb-3">
            <div class="panel-head">Ekler <span class="text-muted small fw-normal">@Model.Attachments.Count dosya</span></div>
            <div class="panel-body"><partial name="_AttachmentList" model="Model.Attachments" /></div>
        </div>

        <div class="panel mb-3">
            <div class="panel-head">
                Yazışma
                <span class="text-muted small fw-normal">@Model.Comments.Count mesaj</span>
            </div>
            <div class="panel-body">
                <partial name="_CommentThread" model="Model.Comments" />

                @* Kapanmış / arşivlenmiş talebe yazışma eklenmez.
                   Aynı kural TicketsController.AddComment içinde de uygulanıyor. *@
                @if (arsiv)
                {
                    <div class="alert alert-light border small mt-3 mb-0 d-flex gap-2 align-items-start">
                        <i class="bi bi-archive mt-1"></i>
                        <div>Arşivlenmiş talepte yazışma eklenemez.</div>
                    </div>
                }
                else if (Model.Status == TicketStatus.Closed)
                {
                    <div class="alert alert-light border small mt-3 mb-0 d-flex gap-2 align-items-start">
                        <i class="bi bi-lock mt-1"></i>
                        <div>
                            Talep kapandığı için yazışma kapalı; mesaj, iç not ve dosya eklenemez.
                            Konuya devam edilecekse talebi <strong>yeniden açın</strong>.
                        </div>
                    </div>
                }
                else
                {
                    <form asp-action="AddComment" asp-route-id="@Model.Id" method="post" enctype="multipart/form-data" class="mt-3 pt-3 border-top">
                        <textarea name="body" class="form-control mb-2" rows="3" required maxlength="4000"
                                  placeholder="Kullanıcıya yanıt yazın veya ekibe iç not bırakın..."></textarea>
                        <div class="d-flex flex-wrap align-items-center gap-3 mb-2">
                            <div class="form-check mb-0">
                                <input class="form-check-input" type="checkbox" name="isInternal" value="true" id="isInternal" />
                                <label class="form-check-label small" for="isInternal">
                                    İç not <span class="text-muted">(kullanıcı görmez)</span>
                                </label>
                            </div>
                            <div class="d-flex align-items-center gap-2">
                                <label class="small text-muted mb-0" for="workMinutes">Harcanan süre</label>
                                <input type="number" name="workMinutes" id="workMinutes" min="1" max="10000" step="1"
                                       class="form-control form-control-sm" style="width:90px" placeholder="dk" />
                            </div>
                            <button class="btn btn-primary btn-sm ms-auto">Gönder</button>
                        </div>
                        <partial name="_UploadField" model="UploadKind.Comment" />
                    </form>
                }
            </div>
        </div>

        @if (Model.Type == TicketType.Change)
        {
            var d = Model.ChangeDetail;
            var riskKilitli = TicketWorkflow.IsApprovalStarted(Model);
            <div class="panel mb-3">
                <div class="panel-head">
                    Değişiklik planı
                    @if (d != null)
                    {
                        <span class="tag @(d.Risk == RiskLevel.High ? "tag-red" : d.Risk == RiskLevel.Medium ? "tag-amber" : "tag-gray")">
                            @Ui.RiskText(d.Risk) risk
                        </span>
                    }
                    else
                    {
                        <span class="text-muted small fw-normal">henüz doldurulmadı</span>
                    }
                </div>
                <div class="panel-body">
                    @if (arsiv)
                    {
                        <dl class="row small mb-0">
                            <dt class="col-sm-3 text-muted">Risk</dt>
                            <dd class="col-sm-9">@(d == null ? "-" : Ui.RiskText(d.Risk))</dd>
                            <dt class="col-sm-3 text-muted">Başlangıç</dt>
                            <dd class="col-sm-9">@(AppTime.ToLocal(d?.PlannedStart)?.ToString("dd.MM.yyyy HH:mm") ?? "-")</dd>
                            <dt class="col-sm-3 text-muted">Bitiş</dt>
                            <dd class="col-sm-9">@(AppTime.ToLocal(d?.PlannedEnd)?.ToString("dd.MM.yyyy HH:mm") ?? "-")</dd>
                            <dt class="col-sm-3 text-muted">Uygulama</dt>
                            <dd class="col-sm-9" style="white-space:pre-line">@(d?.ImplementationPlan ?? "-")</dd>
                            <dt class="col-sm-3 text-muted">Geri alma</dt>
                            <dd class="col-sm-9" style="white-space:pre-line">@(d?.RollbackPlan ?? "-")</dd>
                            <dt class="col-sm-3 text-muted">Etki</dt>
                            <dd class="col-sm-9" style="white-space:pre-line">@(d?.ImpactAnalysis ?? "-")</dd>
                            <dt class="col-sm-3 text-muted">CAB kaydı</dt>
                            <dd class="col-sm-9">@(d?.CabMeetingUrl ?? "-")</dd>
                        </dl>
                    }
                    else
                    {
                    <form asp-action="UpdateChangeDetail" asp-route-id="@Model.Id" method="post">
                        <input type="hidden" name="rowVersion" value="@TicketConcurrency.Encode(Model.RowVersion)" />
                        <div class="row g-3">
                            <div class="col-md-4">
                                <label class="form-label small text-muted mb-1">Risk</label>
                                <select name="risk" class="form-select form-select-sm" disabled="@riskKilitli">
                                    @foreach (var r in Enum.GetValues<RiskLevel>())
                                    {
                                        <option value="@r" selected="@(d != null && d.Risk == r)">@Ui.RiskText(r)</option>
                                    }
                                </select>
                                @if (riskKilitli)
                                {
                                    @* disabled alan gönderilmez; mevcut risk gizli alanla taşınır *@
                                    <input type="hidden" name="risk" value="@(d?.Risk ?? RiskLevel.Low)" />
                                    <div class="form-text">Onay süreci başladığı için risk değiştirilemez.</div>
                                }
                                else
                                {
                                    <div class="form-text">Yüksek risk iki onaydan geçer.</div>
                                }
                            </div>
                            <div class="col-md-4">
                                <label class="form-label small text-muted mb-1">Planlanan başlangıç</label>
                                <input type="datetime-local" name="plannedStart" class="form-control form-control-sm"
                                       value="@(AppTime.ToLocal(d?.PlannedStart)?.ToString("yyyy-MM-ddTHH:mm"))" />
                            </div>
                            <div class="col-md-4">
                                <label class="form-label small text-muted mb-1">Planlanan bitiş</label>
                                <input type="datetime-local" name="plannedEnd" class="form-control form-control-sm"
                                       value="@(AppTime.ToLocal(d?.PlannedEnd)?.ToString("yyyy-MM-ddTHH:mm"))" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label small text-muted mb-1">Uygulama planı</label>
                                <textarea name="implementationPlan" rows="3" class="form-control form-control-sm">@d?.ImplementationPlan</textarea>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label small text-muted mb-1">Geri alma planı</label>
                                <textarea name="rollbackPlan" rows="3" class="form-control form-control-sm">@d?.RollbackPlan</textarea>
                            </div>
                            <div class="col-12">
                                <label class="form-label small text-muted mb-1">Etki analizi</label>
                                <textarea name="impactAnalysis" rows="2" class="form-control form-control-sm">@d?.ImpactAnalysis</textarea>
                            </div>
                            <div class="col-md-8">
                                <label class="form-label small text-muted mb-1">
                                    CAB toplantı kaydı (bağlantı)
                                    @if (d?.Risk == RiskLevel.High && onayBaglami.Settings.RequireCabForHighRisk) { <span class="text-danger">· yüksek riskte nihai onay için zorunlu</span> }
                                </label>
                                <input type="url" name="cabMeetingUrl" maxlength="500" class="form-control form-control-sm"
                                       placeholder="https://… (toplantı tutanağı / kayıt)" value="@d?.CabMeetingUrl" />
                            </div>
                            <div class="col-md-4">
                                <label class="form-label small text-muted mb-1">CAB toplantı tarihi</label>
                                <input type="datetime-local" name="cabMeetingAt" class="form-control form-control-sm"
                                       value="@(AppTime.ToLocal(d?.CabMeetingAt)?.ToString("yyyy-MM-ddTHH:mm"))" />
                            </div>
                        </div>
                        <div class="d-flex align-items-center gap-2 mt-3">
                            <button class="btn btn-primary btn-sm">Planı kaydet</button>
                            @if (d?.UpdatedBy != null)
                            {
                                <span class="small text-muted">son güncelleyen: @d.UpdatedBy.FullName · @AppTime.ToLocal(d.UpdatedAt).ToString("dd.MM.yyyy HH:mm")</span>
                            }
                        </div>
                    </form>
                    }
                </div>
            </div>

            <div class="panel mb-3">
                <div class="panel-head">
                    Onay zinciri
                    <span class="text-muted small fw-normal">
                        @Model.CurrentRoundApprovals.Count(a => a.Decision == ApprovalStatus.Approved) / @Model.RequiredApprovalSteps onay
                        @if (Model.ApprovalRound > 1) { <text>· @Model.ApprovalRound. tur</text> }
                        @if (Model.ApprovalStepsRequired != null && Model.ApprovalStepsRequired != Model.DefaultApprovalSteps) { <text>· zincir kuralı uygulandı</text> }
                    </span>
                </div>
                @if (!Model.Approvals.Any())
                {
                    <div class="panel-body text-muted small">Henüz karar verilmedi.</div>
                }
                else
                {
                    <table class="table table-sm mb-0">
                        <thead><tr><th>Tur</th><th>Adım</th><th>Karar</th><th>Veren</th><th>Not</th><th class="text-end">Zaman</th></tr></thead>
                        <tbody>
                            @foreach (var a in Model.Approvals.OrderBy(a => a.Round).ThenBy(a => a.Step).ThenBy(a => a.DecidedAt))
                            {
                                <tr class="@(a.Round != Model.ApprovalRound ? "text-muted" : "")">
                                    <td>@a.Round</td>
                                    <td>@a.Step</td>
                                    <td><span class="tag @Ui.ApprovalTag(a.Decision)">@Ui.ApprovalText(a.Decision)</span></td>
                                    <td>
                                        @(a.Approver?.FullName ?? "-")
                                        @if (a.OnBehalfOf != null) { <div class="small text-primary">@a.OnBehalfOf.FullName adına (vekalet)</div> }
                                    </td>
                                    <td class="small text-muted">@a.Note</td>
                                    <td class="text-end small text-muted">@AppTime.ToLocal(a.DecidedAt).ToString("dd.MM.yyyy HH:mm")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
            </div>

            @if (Model.ApprovalStatus == ApprovalStatus.Approved && d != null)
            {
                var impl = d.ImplementationStatus;
                var hedefler = Enum.GetValues<ImplementationStatus>()
                    .Where(s => ChangeImplementationRules.CanMove(Model, s, onayBaglami.NowUtc).Allowed).ToList();
                <div class="panel mb-3">
                    <div class="panel-head">
                        Uygulama / geri alma
                        <span class="tag @Ui.ImplementationTag(impl)">@Ui.ImplementationText(impl)</span>
                    </div>
                    <div class="panel-body">
                        <div class="small text-muted mb-2">
                            Başladı: @(AppTime.ToLocal(d.ImplementationStartedAt)?.ToString("dd.MM.yyyy HH:mm") ?? "-")
                            · Uygulandı: @(AppTime.ToLocal(d.ImplementedAt)?.ToString("dd.MM.yyyy HH:mm") ?? "-")
                            · Geri alındı: @(AppTime.ToLocal(d.RolledBackAt)?.ToString("dd.MM.yyyy HH:mm") ?? "-")
                        </div>
                        @if (!string.IsNullOrEmpty(d.ImplementationNote)) { <div class="small mb-2" style="white-space:pre-line">@d.ImplementationNote</div> }
                        @if (!arsiv && hedefler.Any())
                        {
                            <form asp-action="UpdateImplementation" asp-route-id="@Model.Id" method="post" class="d-flex flex-wrap gap-2 align-items-start">
                                <input type="hidden" name="rowVersion" value="@TicketConcurrency.Encode(Model.RowVersion)" />
                                <input name="note" maxlength="1000" class="form-control form-control-sm" style="max-width:360px"
                                       placeholder="Not (başarısız / geri alma için zorunlu)" />
                                @foreach (var s in hedefler)
                                {
                                    var cls = s switch
                                    {
                                        ImplementationStatus.Implemented => "btn-success",
                                        ImplementationStatus.Failed => "btn-outline-danger",
                                        ImplementationStatus.RolledBack => "btn-outline-warning",
                                        _ => "btn-outline-primary"
                                    };
                                    <button class="btn btn-sm @cls" name="status" value="@s">@Ui.ImplementationText(s)</button>
                                }
                            </form>
                        }
                        else if (!arsiv && impl == ImplementationStatus.NotStarted && d.PlannedStart != null)
                        {
                            <div class="small text-muted">Uygulama planlanan pencere içinde başlatılabilir (@AppTime.ToLocal(d.PlannedStart)?.ToString("dd.MM.yyyy HH:mm") – @AppTime.ToLocal(d.PlannedEnd)?.ToString("dd.MM.yyyy HH:mm")).</div>
                        }
                    </div>
                </div>
            }
        }

        @if (Model.Escalations.Any())
        {
            <div class="panel mb-3" style="border-color:#f0c2bc">
                <div class="panel-head">Eskalasyon <span class="text-muted small fw-normal">@Model.Escalations.Count kayıt</span></div>
                <table class="table table-sm mb-0">
                    <thead><tr><th>Seviye</th><th>Tür</th><th>Gecikme</th><th>İlgilenen</th><th>Öncelik</th><th class="text-end">Zaman</th></tr></thead>
                    <tbody>
                        @foreach (var e in Model.Escalations)
                        {
                            <tr>
                                <td><span class="tag tag-red">Seviye @e.Level</span></td>
                                <td class="small">
                                    @if (e.IsManual) { <span class="tag tag-blue" title="@e.Note">manuel</span> <div class="text-muted">@e.TriggeredBy?.FullName</div> }
                                    else { <span class="tag tag-gray">otomatik</span> }
                                    @if (e.UsedFallback) { <span class="tag tag-amber" title="Hedefte uygun kişi yoktu">yedek</span> }
                                </td>
                                <td>@e.MinutesOverdue dk</td>
                                <td>@(e.EscalatedTo?.FullName ?? "-")</td>
                                <td class="small">@(e.PriorityAfter == null ? "-" : $"{Ui.PriorityText(e.PriorityBefore!.Value)} → {Ui.PriorityText(e.PriorityAfter.Value)}")</td>
                                <td class="text-end small text-muted">@AppTime.ToLocal(e.OccurredAt).ToString("dd.MM.yyyy HH:mm")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }

        <div class="panel mb-3">
            <div class="panel-head">Geçmiş <span class="text-muted small fw-normal">@Model.History.Count kayıt</span></div>
            <div class="panel-body"><partial name="_HistoryTimeline" model="Model.History" /></div>
        </div>

        <div class="panel">
            <div class="panel-head">Bilgiler</div>
            <table class="table table-sm mb-0">
                <tr><td class="text-muted" style="width:35%">Talep eden</td><td>@Model.RequesterName</td></tr>
                <tr><td class="text-muted">Tür / Kategori</td><td>@Ui.TypeText(Model.Type) · @Ui.CategoryText(Model.Category)</td></tr>
                <tr><td class="text-muted">Ekip</td><td>@(Model.AssignedTeam?.Name ?? "-")</td></tr>
                <tr><td class="text-muted">Açılış</td><td>@AppTime.ToLocal(Model.CreatedAt).ToString("dd.MM.yyyy HH:mm")</td></tr>
                <tr>
                    <td class="text-muted">İlk yanıt</td>
                    <td>
                        @if (Model.FirstRespondedAt != null)
                        {
                            var gecikti = Model.FirstResponseDueAt != null && Model.FirstRespondedAt > Model.FirstResponseDueAt;
                            <span class="@(gecikti ? "text-danger fw-semibold" : "")">@AppTime.ToLocal(Model.FirstRespondedAt)?.ToString("dd.MM.yyyy HH:mm")</span>
                            @if (gecikti) { <span class="tag tag-red ms-1">geç</span> }
                        }
                        else if (Model.FirstResponseDueAt != null)
                        {
                            <span class="text-muted">hedef: @AppTime.ToLocal(Model.FirstResponseDueAt)?.ToString("dd.MM.yyyy HH:mm")</span>
                        }
                        else { <text>-</text> }
                    </td>
                </tr>
                <tr>
                    <td class="text-muted">SLA bitiş</td>
                    <td class="@(Model.IsSlaBreached ? "text-danger fw-semibold" : "")">
                        @AppTime.ToLocal(Model.SlaDueAt).ToString("dd.MM.yyyy HH:mm")
                        @if (Model.SlaPolicy != null) { <span class="text-muted small">· @Model.SlaPolicy.Name</span> }
                    </td>
                </tr>
                @if (Model.SlaPausedAt != null || Model.SlaPausedMinutes > 0)
                {
                    <tr>
                        <td class="text-muted">SLA duraklaması</td>
                        <td>
                            @if (Model.SlaPausedAt != null) { <span class="tag tag-gray">@AppTime.ToLocal(Model.SlaPausedAt.Value).ToString("dd.MM HH:mm")'den beri durdu</span> }
                            @if (Model.SlaPausedMinutes > 0) { <span class="small text-muted ms-1">toplam @Model.SlaPausedMinutes dk mesai</span> }
                        </td>
                    </tr>
                }
                <tr><td class="text-muted">Çözülme</td><td>@(AppTime.ToLocal(Model.ResolvedAt)?.ToString("dd.MM.yyyy HH:mm") ?? "-")</td></tr>
                @if (Model.ResolutionCode != null)
                {
                    <tr><td class="text-muted">Çözüm kodu</td><td><span class="tag tag-green">@Ui.ResolutionText(Model.ResolutionCode)</span></td></tr>
                    <tr><td class="text-muted">Kök neden</td><td style="white-space:pre-line">@Model.RootCause</td></tr>
                }
                <tr><td class="text-muted">Toplam efor</td><td>@(Model.WorkMinutesTotal > 0 ? $"{Model.WorkMinutesTotal} dk ({Model.WorkMinutesTotal / 60.0:0.#} saat)" : "-")</td></tr>
                <tr>
                    <td class="text-muted">Etiketler</td>
                    <td>
                        @foreach (var etiket in Model.TagList)
                        {
                            <a asp-action="Index" asp-route-tag="@etiket" class="tag tag-blue text-decoration-none me-1">#@etiket</a>
                        }
                        @if (!Model.TagList.Any()) { <text>-</text> }
                    </td>
                </tr>
                <tr><td class="text-muted">Kapanış</td><td>@(AppTime.ToLocal(Model.ClosedAt)?.ToString("dd.MM.yyyy HH:mm") ?? "-")</td></tr>
                @if (Model.ReopenCount > 0)
                {
                    <tr><td class="text-muted">Yeniden açılma</td><td><span class="tag tag-amber">@Model.ReopenCount kez</span></td></tr>
                }
                @if (Model.Survey != null)
                {
                    var ort = Model.Survey.Answers.Count == 0 ? 0 : Model.Survey.Answers.Average(a => a.Score);
                    <tr>
                        <td class="text-muted">Memnuniyet</td>
                        <td>
                            <span class="tag @(ort >= 4 ? "tag-green" : ort >= 3 ? "tag-amber" : "tag-red")">@ort.ToString("0.0") / 5</span>
                            <span class="text-muted small ms-1">@Model.Survey.Comment</span>
                        </td>
                    </tr>
                }
            </table>
        </div>
    </div>

    <div class="col-lg-4">
        @* Atanan / onay özeti her zaman görünür *@
        <div class="panel mb-3">
            <div class="panel-head">Atama</div>
            <div class="panel-body">
                <div class="d-flex align-items-center gap-2">
                    <i class="bi bi-person-circle fs-3 text-muted"></i>
                    <div>
                        <div class="fw-semibold">@(Model.Assignee?.FullName ?? "Atanmadı")</div>
                        <div class="small text-muted">Ekip: @(Model.AssignedTeam?.Name ?? "-")</div>
                    </div>
                </div>
            </div>
        </div>

        @if (Model.ApprovalStatus != ApprovalStatus.NotRequired && Model.ApprovalStatus != ApprovalStatus.Pending)
        {
            <div class="panel mb-3">
                <div class="panel-head">Onay kararı</div>
                <div class="panel-body small">
                    <span class="tag @Ui.ApprovalTag(Model.ApprovalStatus)">@Ui.ApprovalText(Model.ApprovalStatus)</span>
                    <span class="text-muted ms-1">@AppTime.ToLocal(Model.ApprovalDecidedAt)?.ToString("dd.MM.yyyy HH:mm")</span>
                    @if (!string.IsNullOrEmpty(Model.ApprovalNote)) { <div class="mt-2">@Model.ApprovalNote</div> }
                </div>
            </div>
        }

        @if (arsiv)
        {
            <div class="panel mb-3">
                <div class="panel-body small text-muted">
                    <i class="bi bi-lock"></i> Arşiv kaydı salt okunur; atama, durum ve onay işlemleri yapılamaz.
                </div>
            </div>
        }
        else
        {
        @if (Model.ApprovalStatus == ApprovalStatus.Pending)
        {
            @* Yetki kuralı ApprovalPolicy'de; yetkisi olmayan rol düğmeyi
               hiç görmez (sunucu tarafı da aynı kuralı uygular) *@
            var onayVerebilir = ApprovalPolicy.CanDecide(Model, Me.User!, approve: true, onayBaglami);
            var reddedebilir = ApprovalPolicy.CanDecide(Model, Me.User!, approve: false, onayBaglami);

            <div class="panel mb-3" style="border-color:#f3dcae">
                <div class="panel-head">Onay gerekiyor</div>
                <div class="panel-body">
                    <p class="small text-muted">Bu değişiklik talebi onaylanmadan işleme alınamaz.</p>
                    @if (onayVerebilir.Allowed || reddedebilir.Allowed)
                    {
                        <form method="post">
                            <input type="hidden" name="returnUrl" value="@Url.Action("Details", new { id = Model.Id })" />
                            <input type="hidden" name="rowVersion" value="@TicketConcurrency.Encode(Model.RowVersion)" />
                            <textarea name="note" class="form-control mb-2" rows="2" placeholder="Not (redde zorunlu)"></textarea>
                            @if ((onayVerebilir.OnBehalfOf ?? reddedebilir.OnBehalfOf) is { } vekaletVeren)
                            {
                                <div class="small text-primary mb-2"><i class="bi bi-person-badge"></i> @vekaletVeren.FullName adına vekaleten karar vereceksiniz.</div>
                            }
                            <div class="d-flex gap-2">
                                @if (onayVerebilir.Allowed)
                                {
                                    <button class="btn btn-success flex-fill" asp-controller="Approvals" asp-action="Approve" asp-route-id="@Model.Id">
                                        @(ApprovalPolicy.IsFinalStep(Model) ? "Onayla" : $"{ApprovalPolicy.NextStep(Model)}. onayı ver")
                                    </button>
                                }
                                @if (reddedebilir.Allowed)
                                {
                                    <button class="btn btn-outline-danger flex-fill" asp-controller="Approvals" asp-action="Reject" asp-route-id="@Model.Id">Reddet</button>
                                }
                            </div>
                        </form>
                        @if (!onayVerebilir.Allowed || !reddedebilir.Allowed)
                        {
                            <div class="small text-muted mt-2">
                                @(onayVerebilir.Allowed ? reddedebilir.Error : onayVerebilir.Error)
                            </div>
                        }
                    }
                    else
                    {
                        <div class="small text-muted"><i class="bi bi-lock"></i> @onayVerebilir.Error</div>
                    }
                </div>
            </div>
        }

        @if (Model.ApprovalStatus == ApprovalStatus.Rejected)
        {
            var yenidenGonder = ApprovalPolicy.CanResubmit(Model, Me.User!, maxResubmit);
            <div class="panel mb-3">
                <div class="panel-head">Düzelt ve yeniden gönder</div>
                <div class="panel-body">
                    @if (yenidenGonder.Allowed)
                    {
                        <form asp-action="Resubmit" asp-route-id="@Model.Id" method="post">
                            <input type="hidden" name="rowVersion" value="@TicketConcurrency.Encode(Model.RowVersion)" />
                            <textarea name="correctionNote" rows="2" minlength="10" maxlength="2000" required class="form-control form-control-sm mb-2"
                                      placeholder="Red gerekçesine göre ne düzeltildi?"></textarea>
                            <select name="risk" class="form-select form-select-sm mb-2">
                                <option value="">Risk değişmesin (@Ui.RiskText(Model.ChangeDetail?.Risk ?? RiskLevel.Low))</option>
                                @foreach (var r in Enum.GetValues<RiskLevel>()) { <option value="@r">Risk: @Ui.RiskText(r)</option> }
                            </select>
                            <div class="row g-1 mb-2">
                                <div class="col"><input type="datetime-local" name="plannedStart" class="form-control form-control-sm" title="Yeni planlanan başlangıç" /></div>
                                <div class="col"><input type="datetime-local" name="plannedEnd" class="form-control form-control-sm" title="Yeni planlanan bitiş" /></div>
                            </div>
                            <button class="btn btn-sm btn-primary w-100"><i class="bi bi-arrow-repeat"></i> Yeniden onaya gönder (@(Model.ApprovalRound + 1). tur)</button>
                        </form>
                    }
                    else
                    {
                        <div class="small text-muted"><i class="bi bi-lock"></i> @yenidenGonder.Error</div>
                    }
                </div>
            </div>
        }

        @if (TicketWorkflow.IsOpen(Model.Status))
        {
            <div class="panel mb-3" style="border-color:#f0c2bc">
                <div class="panel-head">Manuel eskalasyon <span class="text-muted small fw-normal">şu an seviye @Model.EscalationLevel</span></div>
                <div class="panel-body">
                    <form asp-action="Escalate" asp-route-id="@Model.Id" method="post">
                        <input name="reason" minlength="5" maxlength="250" required class="form-control form-control-sm mb-2"
                               placeholder="Gerekçe (ör. müşteri kritik, üretim durdu)" />
                        <select name="targetUserId" class="form-select form-select-sm mb-2">
                            <option value="">Kuralın hedefi (rol / ekip lideri / yedek)</option>
                            @foreach (var u in eskalasyonPersonel) { <option value="@u.Id">@u.FullName (@Ui.RoleText(u.Role))</option> }
                        </select>
                        <button class="btn btn-sm btn-outline-danger w-100"><i class="bi bi-arrow-up-circle"></i> Bir üst seviyeye yükselt</button>
                    </form>
                </div>
            </div>
        }

        @* Atama işlemleri *@
        <div class="panel mb-3">
            <div class="panel-head">Atama işlemleri</div>
            <div class="panel-body">
                @if (Model.AssigneeId == null && !TicketWorkflow.IsFinished(Model.Status))
                {
                    @* Kilitli üstlenme: aynı anda basan ikinci kişi uyarı alır *@
                    <form asp-action="Claim" asp-route-id="@Model.Id" method="post" class="mb-2">
                        <button class="btn btn-success btn-sm w-100"><i class="bi bi-hand-index-thumb"></i> Ben alıyorum</button>
                    </form>
                }
                <div class="d-flex gap-2">
                    @if (Model.AssigneeId != Me.Id)
                    {
                        <form asp-action="Assign" asp-route-id="@Model.Id" method="post" class="flex-fill">
                            <input type="hidden" name="assigneeId" value="@Me.Id" />
                            <input type="hidden" name="rowVersion" value="@TicketConcurrency.Encode(Model.RowVersion)" />
                            <button class="btn btn-outline-primary btn-sm w-100"><i class="bi bi-person-check"></i> Bana ata</button>
                        </form>
                    }
                    <a asp-action="Assign" asp-route-id="@Model.Id" class="btn btn-primary btn-sm flex-fill"><i class="bi bi-people"></i> Personel seç</a>
                </div>
            </div>
        </div>

        @if (!TicketWorkflow.IsFinished(Model.Status))
        {
            <div class="panel mb-3">
                <div class="panel-head">Öncelik <span class="text-muted small fw-normal">değişince SLA yeniden hesaplanır</span></div>
                <div class="panel-body">
                    <form asp-action="ChangePriority" asp-route-id="@Model.Id" method="post" class="d-flex gap-2">
                        <input type="hidden" name="rowVersion" value="@TicketConcurrency.Encode(Model.RowVersion)" />
                        <select name="priority" class="form-select form-select-sm">
                            @foreach (var p in Enum.GetValues<Priority>()) { <option value="@p" selected="@(p == Model.Priority)">@Ui.PriorityText(p)</option> }
                        </select>
                        <button class="btn btn-sm btn-outline-primary text-nowrap">Değiştir</button>
                    </form>
                </div>
            </div>
        }

        <div class="panel mb-3">
            <div class="panel-head">Takipçiler (CC) <span class="text-muted small fw-normal">@Model.Followers.Count kişi</span></div>
            <div class="panel-body">
                @foreach (var f in Model.Followers.OrderBy(f => f.User?.FirstName))
                {
                    <form asp-action="RemoveFollower" asp-route-id="@Model.Id" method="post" class="d-flex align-items-center gap-2 mb-1">
                        <input type="hidden" name="userId" value="@f.UserId" />
                        <span class="small flex-grow-1"><i class="bi bi-person"></i> @(f.User?.FullName ?? $"#{f.UserId}")</span>
                        <button class="btn btn-sm btn-link text-danger p-0" title="Çıkar"><i class="bi bi-x-lg"></i></button>
                    </form>
                }
                <form asp-action="AddFollower" asp-route-id="@Model.Id" method="post" class="d-flex gap-2 mt-2">
                    <select name="userId" class="form-select form-select-sm" required>
                        <option value="">Kişi seçin</option>
                        @foreach (var u in takipciAdaylari) { <option value="@u.Id">@u.FullName (@Ui.RoleText(u.Role))</option> }
                    </select>
                    <button class="btn btn-sm btn-outline-primary">Ekle</button>
                </form>
            </div>
        </div>

        <div class="panel mb-3">
            <div class="panel-head">Etiketler</div>
            <div class="panel-body">
                <form asp-action="UpdateTags" asp-route-id="@Model.Id" method="post" class="d-flex gap-2">
                    <input type="hidden" name="rowVersion" value="@TicketConcurrency.Encode(Model.RowVersion)" />
                    <input name="tags" value="@Model.Tags" maxlength="300" class="form-control form-control-sm" placeholder="vpn, laptop, acil" />
                    <button class="btn btn-sm btn-outline-primary">Kaydet</button>
                </form>
            </div>
        </div>

        @if (TicketWorkflow.IsOpen(Model.Status))
        {
            <div class="panel mb-3">
                <div class="panel-head">Mükerrer talep</div>
                <div class="panel-body">
                    <form asp-action="Merge" asp-route-id="@Model.Id" method="post"
                          onsubmit="return confirm('Bu talep kapatılıp asıl talebe birleştirilecek. Devam edilsin mi?');">
                        <input type="hidden" name="rowVersion" value="@TicketConcurrency.Encode(Model.RowVersion)" />
                        <input name="target" required class="form-control form-control-sm mb-2" placeholder="Asıl talep no (INC-2026-00012) veya Id" />
                        <button class="btn btn-sm btn-outline-secondary w-100"><i class="bi bi-intersect"></i> Asıl talebe birleştir</button>
                    </form>
                </div>
            </div>
        }

        <form asp-action="ChangeStatus" asp-route-id="@Model.Id" method="post" class="panel">
            <input type="hidden" name="rowVersion" value="@TicketConcurrency.Encode(Model.RowVersion)" />
            <div class="panel-head">
                Durum
                <span class="tag @Ui.StatusTag(Model.Status)">@Ui.StatusText(Model.Status)</span>
            </div>
            <div class="panel-body d-grid gap-2">
                @if (kapanisVar)
                {
                    @* Çözüldü / Kapat için zorunlu; sunucu tarafı TicketWorkflow.ValidateResolution *@
                    <div class="border rounded p-2 bg-light">
                        <label class="form-label small text-muted mb-1">Çözüm kodu (kapanışta zorunlu)</label>
                        <select name="resolutionCode" class="form-select form-select-sm mb-2">
                            <option value="">Seçiniz</option>
                            @foreach (var c in Enum.GetValues<ResolutionCode>().Where(c => c is not (ResolutionCode.Duplicate or ResolutionCode.Cancelled)))
                            {
                                <option value="@c">@Ui.ResolutionText(c)</option>
                            }
                            <option value="@ResolutionCode.Cancelled">@Ui.ResolutionText(ResolutionCode.Cancelled)</option>
                        </select>
                        <textarea name="rootCause" rows="2" maxlength="1000" class="form-control form-control-sm"
                                  placeholder="Kök neden / yapılan çözüm"></textarea>
                    </div>
                }
                @foreach (var s in sonraki)
                {
                    var (yazi, ikon, renk) = s switch
                    {
                        TicketStatus.InProgress when TicketWorkflow.IsFinished(Model.Status) => ("Yeniden aç", "bi-arrow-counterclockwise", "btn-outline-warning"),
                        TicketStatus.InProgress when Model.Status == TicketStatus.WaitingForCustomer => ("Devam et (SLA yeniden işler)", "bi-play-circle", "btn-outline-primary"),
                        TicketStatus.InProgress => ("İşleme al", "bi-play-circle", "btn-outline-primary"),
                        TicketStatus.WaitingForCustomer => ("Müşteri bekleniyor (SLA durur)", "bi-pause-circle", "btn-outline-secondary"),
                        TicketStatus.Resolved => ("Çözüldü", "bi-check2-circle", "btn-success"),
                        _ => ("Kapat", "bi-lock", "btn-outline-secondary")
                    };
                    <button name="status" value="@s" class="btn btn-sm @renk"
                            onclick="@(s == TicketStatus.Closed ? "return confirm('Talep kapatılsın mı?')" : null)">
                        <i class="bi @ikon"></i> @yazi
                    </button>
                }
                @if (!sonraki.Any())
                {
                    <div class="small text-muted">Bu talep için yapılacak işlem kalmadı.</div>
                }
                <div class="small text-muted">Atanmamış talebi işleme alırsanız talep size atanır.</div>
            </div>
        </form>

        @* Talebi çözen bilgi bankası makalesi *@
        <div class="panel mt-3">
            <div class="panel-head">Çözüm makalesi</div>
            <div class="panel-body">
                <form asp-controller="Knowledge" asp-action="LinkToTicket" method="post">
                    <input type="hidden" name="ticketId" value="@Model.Id" />
                    <input type="hidden" name="rowVersion" value="@TicketConcurrency.Encode(Model.RowVersion)" />
                    <select name="articleId" class="form-select form-select-sm mb-2">
                        <option value="">Bağlı değil</option>
                        @foreach (var art in (List<KnowledgeArticle>)ViewBag.Articles)
                        {
                            <option value="@art.Id" selected="@(art.Id == Model.ResolvedByArticleId)">@art.Title</option>
                        }
                    </select>
                    <button class="btn btn-outline-primary btn-sm w-100">Bağla</button>
                </form>
            </div>
        </div>

        @* Kalıcı silme yok: kayıt arşivlenir, veritabanında kalır *@
        @if (Me.Role == UserRole.Admin)
        {
            <form asp-action="SoftDelete" asp-route-id="@Model.Id" method="post" class="mt-3"
                  onsubmit="return confirm('@Ui.TicketNo(Model) arşivlenecek. Kayıt silinmez; Arşiv ekranından görülebilir. Devam edilsin mi?');">
                <input type="hidden" name="rowVersion" value="@TicketConcurrency.Encode(Model.RowVersion)" />
                <input name="reason" class="form-control form-control-sm mb-2" required maxlength="500"
                       placeholder="Arşivleme nedeni (zorunlu)" />
                <button class="btn btn-outline-danger btn-sm w-100">
                    <i class="bi bi-archive"></i> Talebi arşivle
                </button>
            </form>
        }
        } @* !arsiv *@
    </div>
</div>

@section Scripts { <script src="~/js/upload.js" asp-append-version="true"></script> }
