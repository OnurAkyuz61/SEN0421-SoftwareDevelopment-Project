@model Ticket
@{ ViewData["Title"] = "Talep #" + Model.Id; }

<div class="card-soft p-4 mb-3 d-flex flex-wrap gap-2 align-items-center">
    <h4 class="mb-0 me-auto">@Model.Title</h4>
    <span class="badge @Ui.PriorityBadge(Model.Priority)">@Ui.PriorityText(Model.Priority)</span>
    <span class="badge @Ui.StatusBadge(Model.Status)">@Ui.StatusText(Model.Status)</span>
    @if (Model.IsSlaBreached) { <span class="badge bg-danger"><i class="bi bi-exclamation-triangle"></i> SLA İhlali</span> }
</div>

<div class="row g-3">
    <div class="col-lg-7">
        <div class="card-soft p-4">
            <h6 class="text-muted">Açıklama</h6>
            <p>@Model.Description</p>
            <table class="table table-sm mb-0">
                <tr><th style="width:40%">Tür</th><td>@Ui.TypeText(Model.Type)</td></tr>
                <tr><th>Talep Eden</th><td><i class="bi bi-person"></i> @Model.RequesterName</td></tr>
                <tr><th>Atanan</th><td><i class="bi bi-person-gear"></i> @(Model.AssignedTo ?? "-")</td></tr>
                <tr><th>Oluşturulma</th><td>@Model.CreatedAt.ToString("dd.MM.yyyy HH:mm")</td></tr>
                <tr><th>SLA Bitiş</th><td class="@(Model.IsSlaBreached ? "text-danger fw-semibold" : "")">@Model.SlaDueAt.ToString("dd.MM.yyyy HH:mm")</td></tr>
                <tr><th>Çözülme</th><td>@(Model.ResolvedAt?.ToString("dd.MM.yyyy HH:mm") ?? "-")</td></tr>
            </table>
        </div>
    </div>

    <div class="col-lg-5">
        <form asp-action="UpdateStatus" asp-route-id="@Model.Id" method="post" class="card-soft p-4 mb-3">
            <h6 class="fw-semibold"><i class="bi bi-pencil-square text-primary"></i> Durum Güncelle</h6>
            <input name="assignedTo" value="@Model.AssignedTo" class="form-control mb-2" placeholder="Atanan teknisyen" />
            <select name="status" class="form-select mb-2">
                @foreach (var s in Enum.GetValues<TicketStatus>())
                {
                    <option value="@s" selected="@(s == Model.Status)">@Ui.StatusText(s)</option>
                }
            </select>
            <button class="btn btn-primary w-100">Güncelle</button>
        </form>

        @if (Model.Feedback != null)
        {
            <div class="card-soft p-4">
                <h6 class="fw-semibold"><i class="bi bi-star-fill text-warning"></i> Memnuniyet Anketi</h6>
                <div class="fs-4 text-warning">
                    @for (int i = 1; i <= 5; i++) { <i class="bi @(i <= Model.Feedback.Score ? "bi-star-fill" : "bi-star")"></i> }
                </div>
                <p class="mb-0 text-muted">@Model.Feedback.Comment</p>
            </div>
        }
        else if (Model.Status is TicketStatus.Resolved or TicketStatus.Closed)
        {
            <form asp-action="AddFeedback" asp-route-id="@Model.Id" method="post" class="card-soft p-4">
                <h6 class="fw-semibold"><i class="bi bi-star text-warning"></i> Memnuniyet Anketi</h6>
                <select name="score" class="form-select mb-2">
                    @for (int i = 5; i >= 1; i--) { <option value="@i">@i - @(new string('★', i))</option> }
                </select>
                <textarea name="comment" class="form-control mb-2" placeholder="Yorumunuz"></textarea>
                <button class="btn btn-success w-100">Gönder</button>
            </form>
        }
    </div>
</div>

<a asp-action="Index" class="btn btn-link mt-3 px-0"><i class="bi bi-arrow-left"></i> Listeye dön</a>
