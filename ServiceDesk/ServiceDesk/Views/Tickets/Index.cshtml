@model List<Ticket>
@{ ViewData["Title"] = "Talepler"; }

<!-- FİLTRE -->
<form method="get" class="panel panel-body mb-3">
    <div class="row g-2 align-items-end">
        <div class="col-lg-3 col-md-6">
            <label class="form-label small text-muted mb-1">Ara</label>
            <input name="q" value="@ViewBag.Q" class="form-control" placeholder="Konu, talep eden, atanan" />
        </div>
        <div class="col-lg-2 col-md-3 col-6">
            <label class="form-label small text-muted mb-1">Durum</label>
            <select name="status" class="form-select">
                <option value="">Tümü</option>
                @foreach (var s in Enum.GetValues<TicketStatus>()) { <option value="@s" selected="@(ViewBag.Status == s)">@Ui.StatusText(s)</option> }
            </select>
        </div>
        <div class="col-lg-2 col-md-3 col-6">
            <label class="form-label small text-muted mb-1">Öncelik</label>
            <select name="priority" class="form-select">
                <option value="">Tümü</option>
                @foreach (var p in Enum.GetValues<Priority>()) { <option value="@p" selected="@(ViewBag.Priority == p)">@Ui.PriorityText(p)</option> }
            </select>
        </div>
        <div class="col-lg-2 col-md-4 col-6">
            <label class="form-label small text-muted mb-1">Kategori</label>
            <select name="categoryId" class="form-select">
                <option value="">Tümü</option>
                @foreach (var c in (List<Category>)ViewBag.Categories) { <option value="@c.Id" selected="@(ViewBag.CategoryId as int? == c.Id)">@c.Name</option> }
            </select>
        </div>
        <div class="col-lg-1 col-md-4 col-6">
            <label class="form-label small text-muted mb-1">Tür</label>
            <select name="type" class="form-select">
                <option value="">Tümü</option>
                @foreach (var t in Enum.GetValues<TicketType>()) { <option value="@t" selected="@(ViewBag.Type == t)">@Ui.TypeText(t)</option> }
            </select>
        </div>
        <div class="col-lg-2 col-md-4 d-flex gap-2">
            <button class="btn btn-primary flex-fill"><i class="bi bi-funnel"></i> Filtrele</button>
            <a asp-action="Index" class="btn btn-light border" title="Temizle"><i class="bi bi-x-lg"></i></a>
        </div>
    </div>
</form>

<!-- TABLO -->
<div class="panel">
    <div class="panel-head"><span>@Model.Count kayıt</span></div>
    <div class="table-responsive">
        <table class="table table-hover">
            <thead>
                <tr><th>No</th><th>Konu</th><th>Kategori</th><th>Öncelik</th><th>Durum</th><th>Atanan</th><th>SLA</th></tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr><td colspan="7" class="text-center text-muted py-5">Kayıt bulunamadı</td></tr>
                }
                @foreach (var t in Model)
                {
                    <tr>
                        <td class="text-muted small">@Ui.TicketNo(t)</td>
                        <td>
                            <a class="fw-semibold text-decoration-none" asp-action="Details" asp-route-id="@t.Id">@t.Title</a>
                            <div class="small text-muted">
                                @Ui.TypeText(t.Type) · @t.RequesterName
                                @if (t.ApprovalStatus != ApprovalStatus.NotRequired) { <span class="tag @Ui.ApprovalTag(t.ApprovalStatus) ms-1">@Ui.ApprovalText(t.ApprovalStatus)</span> }
                            </div>
                        </td>
                        <td>@Ui.CategoryText(t.Category)</td>
                        <td><span class="tag @Ui.PriorityTag(t.Priority)">@Ui.PriorityText(t.Priority)</span></td>
                        <td><span class="tag @Ui.StatusTag(t.Status)">@Ui.StatusText(t.Status)</span></td>
                        <td>@(t.Assignee?.FullName ?? "-")</td>
                        <td class="text-nowrap">
                            @if (t.IsSlaBreached) { <span class="tag tag-red"><i class="bi bi-exclamation-triangle"></i> İhlal@(t.IsEscalated ? " · Eskale" : "")</span> }
                            else { <span class="small text-muted">@AppTime.ToLocal(t.SlaDueAt).ToString("dd.MM HH:mm")</span> }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
