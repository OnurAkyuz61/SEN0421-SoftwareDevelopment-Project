@model Ticket
@{
    var closed = Model.Status is TicketStatus.Resolved or TicketStatus.Closed;
    var step = Model.Status switch
    {
        TicketStatus.New => 1,
        TicketStatus.InProgress or TicketStatus.WaitingForCustomer => 2,
        _ => 3
    };
    var questions = ViewBag.SurveyQuestions as List<SurveyQuestion>;
    var modal = ViewBag.InModal as bool? == true;

    // Anket penceresi (SurveyPolicy): süresi dolduysa form yerine bilgi
    // gösterilir. Kuralın kendisi PortalController.Feedback'te de uygulanır;
    // burada yalnızca sonucu okuyoruz.
    var surveyExpired = ViewBag.SurveyExpired as bool? == true;
    var surveyDeadline = ViewBag.SurveyDeadline as DateTime?;
    var surveyOpen = Model.Survey == null && closed && questions is { Count: > 0 } && !surveyExpired;
}

<div class="ticket-detail @(modal ? "ticket-detail-modal" : "")">
    <div class="d-flex flex-wrap align-items-center gap-2 mb-3">
        <h5 class="fw-bold mb-0 me-auto">@Ui.TicketNo(Model) · @Model.Title</h5>
        <span class="tag @Ui.StatusTag(Model.Status)">@Ui.StatusText(Model.Status)</span>
        @if (Model.ApprovalStatus != ApprovalStatus.NotRequired)
        {
            <span class="tag @Ui.ApprovalTag(Model.ApprovalStatus)">@Ui.ApprovalText(Model.ApprovalStatus)</span>
        }
    </div>

    <div class="row g-3">
        <div class="col-lg-7">
            <div class="panel mb-3">
                <div class="panel-head">Durum</div>
                <div class="panel-body">
                    <div class="d-flex justify-content-between text-center small">
                        @foreach (var (i, name) in new[] { (1, "Alındı"), (2, "İşlemde"), (3, "Çözüldü") })
                        {
                            <div class="flex-fill">
                                <i class="bi @(i <= step ? "bi-check-circle-fill text-success" : "bi-circle text-muted") fs-4"></i>
                                <div class="@(i <= step ? "fw-semibold" : "text-muted")">@name</div>
                            </div>
                        }
                    </div>
                    @if (Model.ApprovalStatus == ApprovalStatus.Pending)
                    {
                        <div class="alert alert-warning small mt-3 mb-0">Bu bir değişiklik talebi; işleme alınmadan önce yönetici onayı bekleniyor.</div>
                    }
                    @if (Model.Status == TicketStatus.WaitingForCustomer)
                    {
                        <div class="alert alert-info small mt-3 mb-0">
                            <i class="bi bi-chat-left-text"></i> Destek ekibi sizden bilgi bekliyor. Aşağıdan yanıt yazdığınızda talep yeniden işleme alınır.
                        </div>
                    }
                    @if (Model.ResolutionCode == ResolutionCode.Duplicate && Model.MergedIntoTicketId != null)
                    {
                        <div class="alert alert-secondary small mt-3 mb-0">Bu talep aynı konudaki başka bir talep ile birleştirildi.</div>
                    }
                    @if (Model.CancelRequestedAt != null)
                    {
                        <div class="alert alert-warning small mt-3 mb-0">
                            <i class="bi bi-hourglass-split"></i> İptal isteğiniz destek ekibinin onayını bekliyor.
                        </div>
                    }
                    @if (Model.Status == TicketStatus.Resolved)
                    {
                        @* Çözülen talep kullanıcı tarafından yeniden açılabilir *@
                        <details class="mt-3">
                            <summary class="small text-muted">Sorun devam ediyor mu? Talebi yeniden açın</summary>
                            <form asp-controller="Portal" asp-action="Reopen" asp-route-id="@Model.Id" method="post" class="mt-2">
                                <input type="hidden" name="returnTo" value="@(modal ? "modal" : "details")" />
                                <textarea name="reason" rows="2" minlength="5" maxlength="1000" required class="form-control form-control-sm mb-2"
                                          placeholder="Neden yeniden açıyorsunuz?"></textarea>
                                <button class="btn btn-sm btn-outline-warning"><i class="bi bi-arrow-counterclockwise"></i> Yeniden aç</button>
                            </form>
                        </details>
                    }
                    @if (TicketWorkflow.IsOpen(Model.Status) && Model.CancelRequestedAt == null)
                    {
                        <details class="mt-3">
                            <summary class="small text-muted">Talebe artık ihtiyacınız yok mu? İptal isteyin</summary>
                            <form asp-controller="Portal" asp-action="RequestCancel" asp-route-id="@Model.Id" method="post" class="mt-2">
                                <input type="hidden" name="returnTo" value="@(modal ? "modal" : "details")" />
                                <textarea name="reason" rows="2" maxlength="500" required class="form-control form-control-sm mb-2"
                                          placeholder="İptal nedeni"></textarea>
                                <button class="btn btn-sm btn-outline-danger"><i class="bi bi-x-circle"></i> İptal iste</button>
                            </form>
                        </details>
                    }
                    @if (Model.ApprovalStatus == ApprovalStatus.Rejected)
                    {
                        var resubmit = ViewBag.CanResubmit as ApprovalPolicy.Decision;
                        <div class="alert alert-danger small mt-3 mb-0">
                            Talebiniz reddedildi. <strong>Gerekçe:</strong> @(Model.ApprovalNote)
                            @if (resubmit?.Allowed == true)
                            {
                                <div class="mt-1">Gerekçeye göre talebi düzeltip yeniden onaya gönderebilirsiniz.</div>
                            }
                            else if (resubmit != null)
                            {
                                <div class="mt-1 text-muted">@resubmit.Error</div>
                            }
                        </div>

                        @if (resubmit?.Allowed == true)
                        {
                            <form asp-controller="Portal" asp-action="Resubmit" asp-route-id="@Model.Id" method="post" class="mt-3 border rounded p-3 bg-light">
                                <input type="hidden" name="returnTo" value="@(modal ? "modal" : "")" />
                                <div class="fw-semibold small mb-2"><i class="bi bi-arrow-repeat"></i> Düzelt ve yeniden gönder</div>
                                <label class="form-label small text-muted mb-1">Ne değişti? (zorunlu)</label>
                                <textarea name="correctionNote" rows="2" class="form-control form-control-sm mb-2" minlength="10" maxlength="2000" required
                                          placeholder="Red gerekçesine göre yaptığınız düzeltme"></textarea>
                                <label class="form-label small text-muted mb-1">Açıklama (isteğe bağlı güncelleme)</label>
                                <textarea name="description" rows="3" class="form-control form-control-sm mb-2">@Model.Description</textarea>
                                <div class="row g-2 mb-2">
                                    <div class="col">
                                        <label class="form-label small text-muted mb-1">Yeni planlanan başlangıç</label>
                                        <input type="datetime-local" name="plannedStart" class="form-control form-control-sm"
                                               value="@(AppTime.ToLocal(Model.ChangeDetail?.PlannedStart)?.ToString("yyyy-MM-ddTHH:mm"))" />
                                    </div>
                                    <div class="col">
                                        <label class="form-label small text-muted mb-1">Yeni planlanan bitiş</label>
                                        <input type="datetime-local" name="plannedEnd" class="form-control form-control-sm"
                                               value="@(AppTime.ToLocal(Model.ChangeDetail?.PlannedEnd)?.ToString("yyyy-MM-ddTHH:mm"))" />
                                    </div>
                                </div>
                                <button class="btn btn-sm btn-primary"><i class="bi bi-send"></i> Yeniden onaya gönder</button>
                            </form>
                        }
                    }
                    @if (Model.ChangeDetail != null && Model.ApprovalStatus == ApprovalStatus.Approved)
                    {
                        <div class="alert alert-info small mt-3 mb-0">
                            Değişiklik onaylandı · Uygulama durumu:
                            <span class="tag @Ui.ImplementationTag(Model.ChangeDetail.ImplementationStatus)">@Ui.ImplementationText(Model.ChangeDetail.ImplementationStatus)</span>
                            @if (!string.IsNullOrEmpty(Model.ChangeDetail.ImplementationNote)) { <div class="mt-1">@Model.ChangeDetail.ImplementationNote</div> }
                        </div>
                    }
                </div>
            </div>

            <div class="panel mb-3">
                <div class="panel-head">Açıklama</div>
                <div class="panel-body" style="white-space:pre-line">@Model.Description</div>
            </div>

            <div class="panel mb-3">
                <div class="panel-head">Ekler <span class="text-muted small fw-normal">@Model.Attachments.Count dosya</span></div>
                <div class="panel-body">
                    <partial name="_AttachmentList" model="Model.Attachments" />
                    @if (!closed)
                    {
                        <form asp-action="AddFiles" asp-route-id="@Model.Id" method="post" enctype="multipart/form-data" class="mt-3">
                            <input type="hidden" name="returnTo" value="@(modal ? "modal" : "details")" />
                            <partial name="_UploadField" model="UploadKind.Ticket" />
                            <button class="btn btn-outline-primary btn-sm mt-2">Dosyaları Ekle</button>
                        </form>
                    }
                </div>
            </div>

            <div class="panel mb-0">
                <div class="panel-head">
                    Yazışma
                    <span class="text-muted small fw-normal">@Model.Comments.Count mesaj</span>
                </div>
                <div class="panel-body">
                    <partial name="_CommentThread" model="Model.Comments" />

                    @if (Model.Status != TicketStatus.Closed)
                    {
                        <form asp-action="AddComment" asp-route-id="@Model.Id" method="post" enctype="multipart/form-data" class="mt-3 pt-3 border-top">
                            <input type="hidden" name="returnTo" value="@(modal ? "modal" : "details")" />
                            <textarea name="body" class="form-control mb-2" rows="3" required maxlength="4000"
                                      placeholder="@(closed ? "Sorun devam ediyorsa buradan yazabilirsiniz." : "Destek ekibine bir şey eklemek ister misiniz?")"></textarea>
                            <details class="mb-2">
                                <summary class="small text-muted">Dosya / ekran görüntüsü ekle</summary>
                                <div class="mt-2"><partial name="_UploadField" model="UploadKind.Comment" /></div>
                            </details>
                            <button class="btn btn-primary btn-sm"><i class="bi bi-send"></i> Gönder</button>
                        </form>
                    }
                    else
                    {
                        <div class="text-muted small mt-3 pt-3 border-top">
                            Talep kapandığı için yeni mesaj gönderilemez.
                        </div>
                    }
                </div>
            </div>
        </div>

        <div class="col-lg-5">
            <div class="panel mb-3">
                <div class="panel-head">Bilgiler</div>
                <table class="table table-sm mb-0">
                    <tr><td class="text-muted">Tür</td><td>@Ui.TypeText(Model.Type)</td></tr>
                    <tr><td class="text-muted">Kategori</td><td>@Ui.CategoryText(Model.Category)</td></tr>
                    <tr><td class="text-muted">Öncelik</td><td><span class="tag @Ui.PriorityTag(Model.Priority)">@Ui.PriorityText(Model.Priority)</span></td></tr>
                    <tr><td class="text-muted">Açılış</td><td>@AppTime.ToLocal(Model.CreatedAt).ToString("dd.MM.yyyy HH:mm")</td></tr>
                    <tr><td class="text-muted">Hedef çözüm</td><td>@AppTime.ToLocal(Model.SlaDueAt).ToString("dd.MM.yyyy HH:mm")</td></tr>
                    <tr><td class="text-muted">İlgilenen</td><td>@(Model.Assignee?.FullName ?? "Atanmadı")</td></tr>
                </table>
            </div>

            @if (Model.Survey != null)
            {
                var ort = Model.Survey.Answers.Count == 0 ? 0 : Model.Survey.Answers.Average(a => a.Score);
                <div class="panel">
                    <div class="panel-head">Değerlendirmeniz</div>
                    <div class="panel-body">
                        <div class="fs-5 text-warning mb-2">
                            @for (int i = 1; i <= 5; i++) { <i class="bi @(i <= Math.Round(ort) ? "bi-star-fill" : "bi-star")"></i> }
                            <span class="fs-6 text-muted ms-1">@ort.ToString("0.0") / 5</span>
                        </div>
                        @foreach (var a in Model.Survey.Answers.OrderBy(a => a.Question!.SortOrder))
                        {
                            <div class="small d-flex justify-content-between border-top py-1">
                                <span class="text-muted">@a.Question?.Text</span>
                                <span class="fw-semibold">@a.Score</span>
                            </div>
                        }
                        @if (!string.IsNullOrWhiteSpace(Model.Survey.Comment))
                        {
                            <div class="text-muted small mt-2">@Model.Survey.Comment</div>
                        }
                    </div>
                </div>
            }
            else if (surveyOpen)
            {
                <div class="panel border-primary-subtle">
                    <div class="panel-head">Hizmeti değerlendirin</div>
                    <div class="panel-body">
                        <p class="small text-muted mb-3">Talebiniz kapandı. Deneyiminizi puanlayarak bize yardımcı olun.</p>
                        <button type="button" class="btn btn-primary w-100" data-open-survey="@Model.Id">
                            <i class="bi bi-star"></i> Değerlendirme anketini aç
                        </button>
                        @if (surveyDeadline is { } son)
                        {
                            <div class="small text-muted mt-2">
                                <i class="bi bi-clock-history"></i>
                                Son @SurveyPolicy.RemainingText(son, AppTime.UtcNow) ·
                                @AppTime.ToLocal(son).ToString("dd.MM.yyyy HH:mm") tarihine kadar
                            </div>
                        }
                    </div>
                </div>
            }
            else if (closed && surveyExpired && questions is { Count: > 0 })
            {
                @* Süresi dolan anket: form kaldırılır, nedeni yazılır — kullanıcı
                   düğmeyi arayıp "çalışmıyor" sanmasın *@
                <div class="panel">
                    <div class="panel-head">Değerlendirme</div>
                    <div class="panel-body">
                        <div class="d-flex align-items-start gap-2">
                            <i class="bi bi-hourglass-bottom text-muted fs-5"></i>
                            <div class="small text-muted">
                                <div class="fw-semibold text-body mb-1">Anket süresi doldu</div>
                                Bu talebin değerlendirme süresi
                                @if (surveyDeadline is { } gecen)
                                {
                                    <text>@AppTime.ToLocal(gecen).ToString("dd.MM.yyyy") tarihinde </text>
                                }
                                doldu, anket artık doldurulamıyor.
                                Görüşünüzü iletmek için yeni bir talep açabilirsiniz.
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

@* Anket formu ayrı modalda; kapalı, henüz puanlanmamış ve süresi geçmemiş taleplerde *@
@if (surveyOpen)
{
    <div class="modal fade" id="surveyModal-@Model.Id" tabindex="-1" aria-labelledby="surveyTitle-@Model.Id" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <form asp-action="Feedback" asp-route-id="@Model.Id" method="post">
                    <input type="hidden" name="returnTo" value="@(modal ? "modal" : "details")" />
                    <div class="modal-header">
                        <h5 class="modal-title" id="surveyTitle-@Model.Id">Hizmeti değerlendirin</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Kapat"></button>
                    </div>
                    <div class="modal-body">
                        <p class="small text-muted">@Ui.TicketNo(Model) · @Model.Title</p>
                        @* surveyOpen zaten soru listesinin dolu olmasını şart koşuyor *@
                        @foreach (var q in questions!)
                        {
                            <div class="mb-3">
                                <label class="form-label small fw-semibold mb-1">@q.Text</label>
                                <select name="q@(q.Id)" class="form-select form-select-sm" required>
                                    <option value="" selected>Seçiniz (zorunlu)</option>
                                    <option value="5">5 - Çok memnunum</option>
                                    <option value="4">4 - Memnunum</option>
                                    <option value="3">3 - Orta</option>
                                    <option value="2">2 - Memnun değilim</option>
                                    <option value="1">1 - Hiç memnun değilim</option>
                                </select>
                            </div>
                        }
                        <textarea name="comment" class="form-control" rows="2" placeholder="Yorumunuz (isteğe bağlı)"></textarea>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-light border" data-bs-dismiss="modal">Sonra</button>
                        <button type="submit" class="btn btn-primary">Gönder</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}
