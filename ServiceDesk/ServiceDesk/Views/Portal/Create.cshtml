@model Ticket
@inject CurrentUser Me
@{ ViewData["Title"] = "Yeni Talep"; }

<div class="mb-4">
    <h4 class="fw-bold mb-1">Yeni destek talebi</h4>
    <div class="text-muted">Sorununuzu ya da isteğinizi anlatın, varsa dosya veya ekran görüntüsü ekleyin.</div>
    <div class="text-muted small mt-1">Talep sahibi: <span class="fw-semibold">@Me.DisplayName</span></div>
</div>

<form asp-action="Create" method="post" enctype="multipart/form-data" class="panel">
    <div class="panel-body">
        <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2"></div>
        <span class="text-danger d-block mb-2">@Html.ValidationMessage("files")</span>

        <div class="row g-3">
            <div class="col-12">
                <label asp-for="Title" class="form-label fw-semibold">Konu</label>
                <input asp-for="Title" class="form-control" id="suggestSource" autocomplete="off"
                       placeholder="Örn: Yazıcı çıktı vermiyor" />
                <span asp-validation-for="Title" class="text-danger small"></span>

                @* Konu yazılırken bilgi bankası önerisi (api/search/articles).
                   Kullanıcı talebi göndermeden önce çözümü kendi bulabilsin. *@
                <div id="suggestBox" class="mt-2" hidden></div>
            </div>

            @{
                var hizmetler = (List<ServiceItem>)(ViewBag.ServiceItems ?? new List<ServiceItem>());
            }
            <div class="col-md-6">
                <label asp-for="ServiceItemId" class="form-label fw-semibold">Hizmet (isteğe bağlı)</label>
                <select asp-for="ServiceItemId" class="form-select" id="ticketServiceItem">
                    <option value="">Serbest / kategori seçin...</option>
                    @foreach (var s in hizmetler)
                    {
                        <option value="@s.Id"
                                selected="@(s.Id == Model.ServiceItemId)"
                                data-category-id="@s.CategoryId"
                                data-default-priority="@(s.DefaultPriority?.ToString("D") ?? "")"
                                data-default-type="@(s.DefaultType?.ToString("D") ?? "")">
                            @(s.Code != null ? s.Code + " · " : "")@s.Name
                        </option>
                    }
                </select>
                <span asp-validation-for="ServiceItemId" class="text-danger small"></span>
                <div class="form-text small">Hizmet seçilirse kategori ve tür buna göre dolar.</div>
            </div>
            <div class="col-md-3">
                <label asp-for="Type" class="form-label fw-semibold">Talep türü</label>
                <select asp-for="Type" class="form-select" id="ticketType">
                    <option value="@TicketType.Incident">Sorun / Arıza bildirimi</option>
                    <option value="@TicketType.Change">Değişiklik / İstek (onay gerekir)</option>
                </select>
            </div>
            <div class="col-md-3">
                <label asp-for="Priority" class="form-label fw-semibold">Öncelik</label>
                <select asp-for="Priority" asp-items="Html.GetEnumSelectList<Priority>()" class="form-select" id="ticketPriority"></select>
                <div class="form-text small" id="priorityHint" hidden>Varsayılan öncelik uygulandı; değiştirebilirsiniz.</div>
            </div>
            <div class="col-md-6">
                <label asp-for="CategoryId" class="form-label fw-semibold">Kategori</label>
                <select asp-for="CategoryId" class="form-select" id="ticketCategory">
                    <option value="">Seçin...</option>
                    @foreach (var c in (List<Category>)ViewBag.Categories)
                    {
                        <option value="@c.Id"
                                selected="@(c.Id == Model.CategoryId)"
                                data-default-priority="@(c.DefaultPriority?.ToString("D") ?? "")">
                            @Ui.CategoryOptionLabel(c)
                        </option>
                    }
                </select>
                <span asp-validation-for="CategoryId" class="text-danger small"></span>
            </div>

            <div class="col-12">
                <label asp-for="Description" class="form-label fw-semibold">Açıklama</label>
                <textarea asp-for="Description" class="form-control" rows="5"
                          placeholder="Ne oldu? Ne zaman başladı? Hata mesajı var mı?"></textarea>
                <span asp-validation-for="Description" class="text-danger small"></span>
            </div>

            <div class="col-12">
                <label class="form-label fw-semibold">Ekler</label>
                <partial name="_UploadField" model="UploadKind.Ticket" />
            </div>
        </div>
    </div>
    <div class="panel-head border-top border-bottom-0 justify-content-end">
        <a asp-action="Index" class="btn btn-light border">Vazgeç</a>
        <button class="btn btn-primary px-4">Talebi Gönder</button>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/upload.js" asp-append-version="true"></script>
    <script src="~/js/article-suggest.js" asp-append-version="true"></script>
    <script>
        (function () {
            var svc = document.getElementById('ticketServiceItem');
            var cat = document.getElementById('ticketCategory');
            var typ = document.getElementById('ticketType');
            var pri = document.getElementById('ticketPriority');
            var hint = document.getElementById('priorityHint');
            if (!cat || !pri) return;

            function setPriority(def) {
                if (def === null || def === '') {
                    if (hint) hint.hidden = true;
                    return;
                }
                pri.value = def;
                if (hint) hint.hidden = false;
            }

            function applyCategoryDefault() {
                var opt = cat.options[cat.selectedIndex];
                setPriority(opt && opt.getAttribute('data-default-priority'));
            }

            function applyServiceItem() {
                if (!svc || !svc.value) return;
                var opt = svc.options[svc.selectedIndex];
                var catId = opt.getAttribute('data-category-id');
                var defPri = opt.getAttribute('data-default-priority');
                var defType = opt.getAttribute('data-default-type');
                if (catId) cat.value = catId;
                if (defType !== null && defType !== '' && typ) typ.value = defType;
                if (defPri) setPriority(defPri);
                else applyCategoryDefault();
            }

            if (svc) svc.addEventListener('change', applyServiceItem);
            cat.addEventListener('change', function () {
                if (svc && svc.value) return; // hizmet seçiliyken kategori elle değişmesin diye önceliği hizmetten bırak
                applyCategoryDefault();
            });
        })();
    </script>
}
