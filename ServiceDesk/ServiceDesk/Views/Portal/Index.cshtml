@model List<Ticket>
@{
    ViewData["Title"] = "Taleplerim";
    var open = Model.Count(t => t.Status is TicketStatus.New or TicketStatus.InProgress);
    var openTicket = Context.Request.Query["open"].ToString();
    var showSurvey = Context.Request.Query["survey"] == "1";
}

<div class="d-flex flex-wrap align-items-end gap-3 mb-4">
    <div class="me-auto">
        <h4 class="fw-bold mb-1">Taleplerim</h4>
        <div class="text-muted">Açtığınız taleplerin durumunu buradan takip edebilirsiniz.</div>
    </div>
    <a asp-action="Create" class="btn btn-primary"><i class="bi bi-plus-lg"></i> Yeni Talep</a>
</div>

<div class="row g-3 mb-3">
    <div class="col-4"><div class="stat"><div class="label">Toplam</div><div class="value">@Model.Count</div></div></div>
    <div class="col-4"><div class="stat"><div class="label">Açık</div><div class="value">@open</div></div></div>
    <div class="col-4"><div class="stat"><div class="label">Çözülen</div><div class="value">@(Model.Count - open)</div></div></div>
</div>

<div class="panel">
    <div class="panel-head">
        <span>Talepler</span>
    </div>
    <div class="table-responsive">
        <table class="table table-hover">
            <thead><tr><th>No</th><th>Konu</th><th>Kategori</th><th>Durum</th><th>Tarih</th></tr></thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr><td colspan="5" class="text-center text-muted py-5">
                        Henüz talep yok. <a asp-action="Create">İlk talebinizi oluşturun</a>
                    </td></tr>
                }
                @foreach (var t in Model)
                {
                    <tr class="ticket-row" role="button" tabindex="0"
                        data-ticket-id="@t.Id"
                        data-needs-survey="@(t.Status is TicketStatus.Resolved or TicketStatus.Closed && t.Survey == null ? "1" : "0")"
                        title="Detayı aç">
                        <td class="text-muted small">@Ui.TicketNo(t)</td>
                        <td>
                            <span class="fw-semibold text-primary">@t.Title</span>
                            @if (t.ApprovalStatus == ApprovalStatus.Pending) { <span class="tag tag-amber ms-1">Onay bekliyor</span> }
                        </td>
                        <td>@Ui.CategoryText(t.Category)</td>
                        <td><span class="tag @Ui.StatusTag(t.Status)">@Ui.StatusText(t.Status)</span></td>
                        <td class="text-muted">@AppTime.ToLocal(t.CreatedAt).ToString("dd.MM.yyyy")</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@* Talep detay popup *@
<div class="modal fade" id="ticketModal" tabindex="-1" aria-labelledby="ticketModalTitle" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-scrollable modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="ticketModalTitle">Talep detayı</h5>
                <div class="d-flex align-items-center gap-2 ms-auto me-2">
                    <a href="#" id="ticketFullLink" class="btn btn-sm btn-light border d-none d-sm-inline-flex" title="Tam sayfa">
                        <i class="bi bi-box-arrow-up-right"></i>
                    </a>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Kapat"></button>
                </div>
            </div>
            <div class="modal-body" id="ticketModalBody">
                <div class="text-center text-muted py-5">
                    <div class="spinner-border spinner-border-sm text-primary" role="status"></div>
                    <div class="small mt-2">Yükleniyor…</div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        window.portalTicket = {
            partialUrl: '@Url.Action("DetailsPartial", "Portal")',
            detailsUrl: '@Url.Action("Details", "Portal")',
            openId: @(string.IsNullOrEmpty(openTicket) ? "null" : openTicket),
            showSurvey: @(showSurvey ? "true" : "false")
        };
    </script>
    <script src="~/js/portal-modals.js" asp-append-version="true"></script>
}
