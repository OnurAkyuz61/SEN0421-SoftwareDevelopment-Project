@model Ticket
@{
    ViewData["Title"] = "Talep " + Ui.TicketNo(Model);
    ViewBag.InModal = false;
}

<a asp-action="Index" class="text-decoration-none small"><i class="bi bi-arrow-left"></i> Taleplerim</a>
<div class="mt-2">
    <partial name="_TicketDetail" model="Model" />
</div>

@section Scripts {
    <script src="~/js/upload.js" asp-append-version="true"></script>
    <script src="~/js/portal-modals.js" asp-append-version="true"></script>
}
