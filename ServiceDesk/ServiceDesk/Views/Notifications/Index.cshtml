@model List<ServiceDesk.Services.NotificationItem>
@{ ViewData["Title"] = "Bildirimler"; }

<div class="panel">
    <div class="panel-head">@Model.Count bildirim</div>
    @if (!Model.Any())
    {
        <div class="panel-body text-center text-muted py-5"><i class="bi bi-check-circle"></i> Bildirim yok</div>
    }
    <div class="list-group list-group-flush">
        @foreach (var n in Model)
        {
            <a class="list-group-item list-group-item-action d-flex gap-3 align-items-center py-3"
               asp-controller="Tickets" asp-action="Details" asp-route-id="@n.TicketId">
                <i class="bi @n.Icon text-@n.Color fs-5"></i>
                <div class="flex-grow-1">
                    <div class="fw-semibold">@n.Title</div>
                    <div class="small text-muted">@n.Message</div>
                </div>
                <small class="text-muted text-nowrap">@n.Time.ToString("dd.MM.yyyy HH:mm")</small>
            </a>
        }
    </div>
</div>
