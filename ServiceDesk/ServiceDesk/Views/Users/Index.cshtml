@model List<AppUser>
@{ ViewData["Title"] = "Kullanıcılar"; }

<div class="panel">
    <div class="panel-head">@Model.Count kullanıcı <span class="small text-muted fw-normal">Kullanıcı ekleme/düzenleme sonra eklenecek</span></div>
    <div class="table-responsive">
        <table class="table table-hover">
            <thead><tr><th>Ad Soyad</th><th>E-posta</th><th>Telefon</th><th>Birim / Ekip</th><th>Rol</th><th>Durum</th></tr></thead>
            <tbody>
                @foreach (var u in Model)
                {
                    <tr>
                        <td class="fw-semibold">@u.FirstName @u.LastName</td>
                        <td>@u.Email</td>
                        <td class="text-muted">@u.PhoneNumber</td>
                        <td class="small">
                            @(u.Department?.Name ?? "-")
                            @if (u.Team != null) { <div class="text-muted">@u.Team.Name</div> }
                        </td>
                        <td>
                            <span class="tag @(u.Role == UserRole.Admin ? "tag-blue" : u.Role == UserRole.Agent ? "tag-green" : "tag-gray")">
                                @(u.Role == UserRole.Admin ? "Yönetici" : u.Role == UserRole.Agent ? "Destek" : "Kullanıcı")
                            </span>
                        </td>
                        <td>
                            @if (u.IsActive) { <span class="tag tag-green">Aktif</span> }
                            else { <span class="tag tag-gray">Pasif</span> }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<div class="panel mt-4">
    <div class="panel-head">
        Son giriş denemeleri
        <span class="text-muted small fw-normal">güvenlik denetim izi · @LoginAuditService.MaxFailedAttempts başarısız denemeden sonra hesap @LoginAuditService.Window.TotalMinutes dakika kapanır</span>
    </div>
    <div class="table-responsive">
        <table class="table table-sm mb-0">
            <thead><tr><th>E-posta</th><th>Sonuç</th><th>IP</th><th class="text-end">Zaman</th></tr></thead>
            <tbody>
                @{ var denemeler = (List<LoginAttempt>)ViewBag.LoginAttempts; }
                @if (!denemeler.Any())
                {
                    <tr><td colspan="4" class="text-center text-muted py-4">Henüz giriş denemesi kaydı yok</td></tr>
                }
                @foreach (var l in denemeler)
                {
                    <tr>
                        <td class="small">@l.Email</td>
                        <td>
                            <span class="tag @(l.IsSuccess ? "tag-green" : "tag-red")">@Ui.LoginResultText(l.Result)</span>
                        </td>
                        <td class="small text-muted">@(l.IpAddress ?? "-")</td>
                        <td class="text-end small text-muted">@AppTime.ToLocal(l.AttemptedAt).ToString("dd.MM.yyyy HH:mm:ss")</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
