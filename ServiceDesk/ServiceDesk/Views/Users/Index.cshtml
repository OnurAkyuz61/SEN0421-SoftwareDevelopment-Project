@model List<AppUser>
@{ ViewData["Title"] = "Kullanıcılar"; }

<div class="panel">
    <div class="panel-head">@Model.Count kullanıcı <span class="small text-muted fw-normal">Kullanıcı ekleme/düzenleme sonra eklenecek</span></div>
    <div class="table-responsive">
        <table class="table table-hover">
            <thead><tr><th>Ad Soyad</th><th>E-posta</th><th>Telefon</th><th>Rol</th></tr></thead>
            <tbody>
                @foreach (var u in Model)
                {
                    <tr>
                        <td class="fw-semibold">@u.FirstName @u.LastName</td>
                        <td>@u.Email</td>
                        <td class="text-muted">@u.PhoneNumber</td>
                        <td>
                            <span class="tag @(u.Role == UserRole.Admin ? "tag-blue" : u.Role == UserRole.Agent ? "tag-green" : "tag-gray")">
                                @(u.Role == UserRole.Admin ? "Yönetici" : u.Role == UserRole.Agent ? "Destek" : "Kullanıcı")
                            </span>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
