@model UserFormVm
@inject CurrentUser Me
@inject Microsoft.Extensions.Options.IOptions<AuthSettings> Auth
@{
    ViewData["Title"] = Model.IsNew ? "Yeni Kullanıcı" : "Kullanıcıyı Düzenle";
    var birimler = (List<Department>)ViewBag.Departments;
    var ekipler = (List<Team>)ViewBag.Teams;
    var kendim = !Model.IsNew && Model.Id == Me.Id;
}

<a asp-action="Index" class="text-decoration-none small"><i class="bi bi-arrow-left"></i> Kullanıcılar</a>

<div class="d-flex flex-wrap align-items-center gap-2 mt-2 mb-3">
    <h4 class="fw-bold mb-0 me-auto">
        @(Model.IsNew ? "Yeni kullanıcı oluştur" : Model.FirstName + " " + Model.LastName)
    </h4>
    @if (!Model.IsNew)
    {
        <span class="tag @(Model.IsActive ? "tag-green" : "tag-gray")">@(Model.IsActive ? "Aktif" : "Pasif")</span>
        <span class="tag tag-blue">@Ui.RoleText(Model.Role)</span>
        @if (Me.Role == UserRole.Admin && !kendim && Model.IsActive)
        {
            <form asp-action="ForceLogout" method="post" class="d-inline"
                  onsubmit="return confirm('Bu kullanıcının tüm açık oturumları sonlandırılsın mı?');">
                <input type="hidden" name="id" value="@Model.Id" />
                <button type="submit" class="btn btn-sm btn-outline-secondary" title="Açık oturumları sonlandır">
                    <i class="bi bi-box-arrow-right"></i> Zorla çıkış
                </button>
            </form>
        }
    }
</div>

<form asp-action="Edit" method="post" novalidate>
    <input type="hidden" asp-for="Id" />

    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small"></div>

    <div class="row g-4">
        <div class="col-lg-7">
            <div class="panel mb-3">
                <div class="panel-head">Kimlik bilgileri</div>
                <div class="panel-body">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label asp-for="FirstName" class="form-label"></label>
                            <input asp-for="FirstName" class="form-control" autocomplete="given-name" />
                            <span asp-validation-for="FirstName" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="LastName" class="form-label"></label>
                            <input asp-for="LastName" class="form-control" autocomplete="family-name" />
                            <span asp-validation-for="LastName" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Email" class="form-label"></label>
                            <input asp-for="Email" class="form-control" autocomplete="off" />
                            <span asp-validation-for="Email" class="text-danger small"></span>
                            <div class="form-text">Giriş bu adresle yapılır; sistemde benzersiz olmalıdır.</div>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="PhoneNumber" class="form-label"></label>
                            <input asp-for="PhoneNumber" class="form-control" autocomplete="off" placeholder="+90 5xx xxx xx xx" />
                            <span asp-validation-for="PhoneNumber" class="text-danger small"></span>
                            <div class="form-text">
                                İki adımlı girişin kodu bu numaraya gider. Boş bırakılırsa kullanıcı giriş yapamaz.
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="panel">
                <div class="panel-head">
                    Şifre
                    <span class="text-muted small fw-normal">
                        @(Model.IsNew
                            ? "yeni hesap için zorunlu — kullanıcı ilk girişte değiştirmek zorunda"
                            : "boş bırakılırsa mevcut şifre değişmez; doldurulursa kullanıcı bir sonraki girişte yeniden belirler")
                    </span>
                </div>
                <div class="panel-body">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label asp-for="Password" class="form-label"></label>
                            <input asp-for="Password" class="form-control" autocomplete="new-password" />
                            <span asp-validation-for="Password" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="ConfirmPassword" class="form-label"></label>
                            <input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" />
                            <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                        </div>
                    </div>
                    <div class="form-text mt-2">
                        @PasswordRules.Hint @PasswordRules.HistoryHint(Auth.Value.PasswordHistoryCount)
                        Şifrenin kendisi saklanmaz; yalnızca özeti tutulur.
                        Kullanıcı giriş ekranındaki &quot;Şifremi unuttum&quot; akışıyla şifresini kendisi de değiştirebilir.
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-5">
            <div class="panel mb-3">
                <div class="panel-head">Yetki ve erişim</div>
                <div class="panel-body">
                    <div class="mb-3">
                        <label asp-for="Role" class="form-label"></label>
                        @* Kendi hesabını düzenleyen yönetici rolünü ve aktifliğini
                           değiştiremez: alanlar kilitli, değer gizli alanla
                           olduğu gibi geri gönderilir *@
                        @if (kendim)
                        {
                            <input type="hidden" name="Role" value="@Model.Role" />
                            <select class="form-select" disabled>
                                <option selected>@Ui.RoleText(Model.Role)</option>
                            </select>
                        }
                        else
                        {
                            <select asp-for="Role" class="form-select">
                                @foreach (var r in Enum.GetValues<UserRole>())
                                {
                                    <option value="@r">@Ui.RoleText(r)</option>
                                }
                            </select>
                        }
                        <span asp-validation-for="Role" class="text-danger small"></span>
                        <div class="form-text">
                            <strong>Kullanıcı:</strong> yalnızca portal · <strong>Destek:</strong> talep yönetimi ·
                            <strong>Yönetici:</strong> tüm yönetim ekranları ve onaylar.
                            @if (kendim)
                            {
                                <span class="d-block text-warning-emphasis mt-1">
                                    Kendi rolünüzü değiştiremezsiniz; bunu başka bir yönetici yapmalı.
                                </span>
                            }
                        </div>
                    </div>

                    <div class="form-check form-switch mb-1">
                        @if (kendim)
                        {
                            <input type="hidden" name="IsActive" value="true" />
                            <input class="form-check-input" type="checkbox" id="IsActive" checked disabled />
                        }
                        else
                        {
                            <input class="form-check-input" type="checkbox" asp-for="IsActive" />
                        }
                        <label class="form-check-label" asp-for="IsActive"></label>
                    </div>
                    <span asp-validation-for="IsActive" class="text-danger small"></span>
                    <div class="form-text">
                        Pasif hesap silinmez: talepleri, yazışmaları ve onayları kayıtlı kalır ama
                        kullanıcı giriş yapamaz ve açık oturumu anında kapanır.
                        @if (Model.OpenTicketCount > 0)
                        {
                            <span class="d-block text-warning-emphasis mt-1">
                                Bu kişiye atanmış @Model.OpenTicketCount açık talep var; pasifleştirmeden önce
                                talepleri başka birine atayın.
                            </span>
                        }
                    </div>
                </div>
            </div>

            <div class="panel">
                <div class="panel-head">Organizasyon</div>
                <div class="panel-body">
                    <div class="mb-3">
                        <label asp-for="DepartmentId" class="form-label"></label>
                        <select asp-for="DepartmentId" class="form-select" id="userDepartment">
                            <option value="">-</option>
                            @foreach (var d in birimler)
                            {
                                <option value="@d.Id">@d.Name</option>
                            }
                        </select>
                        <span asp-validation-for="DepartmentId" class="text-danger small"></span>
                    </div>

                    <div class="mb-0">
                        <label asp-for="TeamId" class="form-label"></label>
                        <select asp-for="TeamId" class="form-select" id="userTeam">
                            <option value="">-</option>
                            @foreach (var t in ekipler)
                            {
                                <option value="@t.Id" data-department-id="@t.DepartmentId">
                                    @t.Name (@(t.Department?.Name ?? "-"))
                                </option>
                            }
                        </select>
                        <span asp-validation-for="TeamId" class="text-danger small"></span>
                        <div class="form-text">
                            Destek personeli için: talepler kişiye atanmadan önce ekibe düşer.
                            Birim değişince yalnızca o birime bağlı ekipler listelenir; uyumsuz ekip temizlenir.
                        </div>
                    </div>

                    @if (!Model.IsNew && Model.CreatedAt != null)
                    {
                        <div class="small text-muted border-top mt-3 pt-3">
                            Kayıt tarihi: @AppTime.ToLocal(Model.CreatedAt)?.ToString("dd.MM.yyyy HH:mm")
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    <div class="d-flex gap-2 mt-4">
        <button type="submit" class="btn btn-primary">
            <i class="bi bi-check-lg"></i> @(Model.IsNew ? "Kullanıcıyı oluştur" : "Değişiklikleri kaydet")
        </button>
        <a asp-action="Index" class="btn btn-light border">Vazgeç</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (function () {
            var dep = document.getElementById('userDepartment');
            var team = document.getElementById('userTeam');
            if (!dep || !team) return;

            function filterTeams(clearIfMismatch) {
                var deptId = dep.value;
                var selected = team.value;
                var keep = false;

                Array.prototype.forEach.call(team.options, function (opt) {
                    if (!opt.value) {
                        opt.hidden = false;
                        return;
                    }
                    var match = !deptId || opt.getAttribute('data-department-id') === deptId;
                    opt.hidden = !match;
                    if (match && opt.value === selected) keep = true;
                });

                if (clearIfMismatch && selected && !keep) team.value = '';
            }

            dep.addEventListener('change', function () { filterTeams(true); });
            filterTeams(false);
        })();
    </script>
}
