@{
    Layout = null; // Karşılama sayfasında menü (veri linkleri) görünmesin
}
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Hoş Geldiniz - ServiceDesk</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/lib/bootstrap-icons/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <style>
        .entry { display: block; text-decoration: none; color: var(--text); transition: border-color .15s; }
        .entry:hover { border-color: var(--accent); color: var(--text); }
        .entry i { font-size: 1.6rem; }
    </style>
</head>
<body class="d-flex flex-column min-vh-100">
    <header class="portal-nav">
        <div class="container h-100 d-flex align-items-center" style="max-width:880px">
            <span class="d-flex align-items-center gap-2 fw-bold"><span class="brand-mark"><i class="bi bi-headset"></i></span>ServiceDesk</span>
            <a class="btn btn-primary btn-sm ms-auto" asp-controller="Account" asp-action="Login"><i class="bi bi-box-arrow-in-right"></i> Giriş Yap</a>
        </div>
    </header>

    <main class="container flex-grow-1 d-flex flex-column justify-content-center py-5" style="max-width:880px">
        <h1 class="fw-bold mb-2">IT Servis Masası</h1>
        <p class="text-muted fs-5 mb-5">ISO 9001 Kalite Yönetim Standardına uygun destek talebi ve süreç takip sistemi.</p>

        @* GEÇİCİ: Login bağlanınca kullanıcı rolüne göre otomatik yönlendirilecek *@
        <div class="row g-3">
            <div class="col-md-6">
                <a class="panel panel-body entry h-100" asp-controller="Portal" asp-action="Index">
                    <i class="bi bi-person"></i>
                    <div class="fw-semibold fs-5 mt-2">Kullanıcı Portalı</div>
                    <div class="text-muted">Sorun bildirin, dosya veya ekran görüntüsü ekleyin, taleplerinizi takip edin.</div>
                </a>
            </div>
            <div class="col-md-6">
                <a class="panel panel-body entry h-100" asp-controller="Dashboard" asp-action="Index">
                    <i class="bi bi-grid"></i>
                    <div class="fw-semibold fs-5 mt-2">Yönetim Paneli</div>
                    <div class="text-muted">Grafikler, onay bekleyen değişiklikler, atama bekleyen talepler ve SLA takibi.</div>
                </a>
            </div>
        </div>
    </main>

    <footer class="text-center small text-muted py-3">SDS-07 · Software Development with Standards</footer>
</body>
</html>
