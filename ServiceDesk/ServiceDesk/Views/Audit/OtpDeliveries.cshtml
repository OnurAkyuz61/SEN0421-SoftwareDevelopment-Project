@model List<OtpDeliveryLog>
@using ServiceDesk.Controllers
@{
    ViewData["Title"] = "OTP gönderimleri";
    var stats = (List<OtpChannelStat>)ViewBag.Stats;
    var channel = ViewBag.Channel as OtpDeliveryChannel?;
    var status = ViewBag.Status as OtpDeliveryStatus?;
    var pager = (PagerInfo)ViewBag.Pager;
}

<a asp-action="Index" class="text-decoration-none small"><i class="bi bi-arrow-left"></i> Denetim kaydı</a>
<h4 class="fw-bold mt-2 mb-3">OTP gönderim denemeleri</h4>

<div class="row g-3 mb-3">
    @foreach (var s in stats)
    {
        <div class="col-md-4">
            <div class="panel"><div class="panel-body">
                <div class="small text-muted">@s.Channel · son 7 gün</div>
                <div class="fs-5 fw-bold">@s.Total gönderim</div>
                <div class="small">Teslim oranı: <strong>%@s.DeliveryRate.ToString("0.0")</strong> · Başarısız: @s.Failed</div>
            </div></div>
        </div>
    }
    @if (!stats.Any()) { <div class="col-12 text-muted small">Son 7 günde OTP gönderimi yok.</div> }
</div>

<form method="get" class="d-flex flex-wrap gap-2 mb-3">
    <select name="channel" class="form-select form-select-sm" style="max-width:180px">
        <option value="">Tüm kanallar</option>
        @foreach (var c in Enum.GetValues<OtpDeliveryChannel>()) { <option value="@c" selected="@(channel == c)">@c</option> }
    </select>
    <select name="status" class="form-select form-select-sm" style="max-width:200px">
        <option value="">Tüm durumlar</option>
        @foreach (var st in Enum.GetValues<OtpDeliveryStatus>()) { <option value="@st" selected="@(status == st)">@Ui.OtpStatusText(st)</option> }
    </select>
    <button class="btn btn-sm btn-primary">Filtrele</button>
</form>

<div class="panel">
    <div class="table-responsive">
        <table class="table table-sm mb-0">
            <thead><tr><th>Zaman</th><th>Kullanıcı</th><th>Kanal</th><th>Telefon</th><th>#</th><th>Durum</th><th>Sağlayıcı / mesaj no</th><th>IP</th></tr></thead>
            <tbody>
                @if (!Model.Any()) { <tr><td colspan="8" class="text-center text-muted py-4">Kayıt yok</td></tr> }
                @foreach (var o in Model)
                {
                    <tr>
                        <td class="small text-muted text-nowrap">@AppTime.ToLocal(o.CreatedAt).ToString("dd.MM.yyyy HH:mm:ss")</td>
                        <td class="small">@(o.User?.FullName ?? "-")</td>
                        <td><span class="tag tag-gray">@o.Channel</span></td>
                        <td class="small">@o.MaskedPhone</td>
                        <td class="small">@o.SendNumber</td>
                        <td>
                            <span class="tag @Ui.OtpStatusTag(o.Status)">@Ui.OtpStatusText(o.Status)</span>
                            @if (!string.IsNullOrEmpty(o.Error)) { <div class="small text-danger">@o.Error</div> }
                        </td>
                        <td class="small text-muted">@o.Provider<div>@o.ProviderMessageId</div></td>
                        <td class="small text-muted">@o.IpAddress</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
<partial name="_Pager" model="pager" />
