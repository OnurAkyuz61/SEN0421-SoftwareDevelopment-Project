@model List<AuditLog>
@{
    ViewData["Title"] = "Denetim kaydı";
    var action = ViewBag.Action as AuditAction?;
    var pager = (PagerInfo)ViewBag.Pager;
}

<div class="d-flex flex-wrap align-items-center gap-2 mb-3">
    <h4 class="fw-bold mb-0 me-auto">Denetim kaydı</h4>
    <a asp-action="OtpDeliveries" class="btn btn-sm btn-outline-secondary"><i class="bi bi-phone"></i> OTP gönderimleri</a>
    <a asp-controller="Users" asp-action="LoginAttempts" class="btn btn-sm btn-outline-secondary"><i class="bi bi-door-open"></i> Giriş denemeleri</a>
</div>

<form method="get" class="d-flex flex-wrap gap-2 mb-3">
    <select name="action" class="form-select form-select-sm" style="max-width:240px">
        <option value="">Tüm olaylar</option>
        @foreach (var a in Enum.GetValues<AuditAction>()) { <option value="@a" selected="@(action == a)">@Ui.AuditActionText(a)</option> }
    </select>
    <input name="q" value="@ViewBag.Q" class="form-control form-control-sm" style="max-width:260px" placeholder="E-posta, IP, ayrıntı" />
    <button class="btn btn-sm btn-primary">Filtrele</button>
</form>

<div class="panel">
    <div class="table-responsive">
        <table class="table table-sm mb-0">
            <thead><tr><th>Zaman</th><th>Olay</th><th>Kullanıcı</th><th>Ayrıntı</th><th>IP</th></tr></thead>
            <tbody>
                @if (!Model.Any()) { <tr><td colspan="5" class="text-center text-muted py-4">Kayıt yok</td></tr> }
                @foreach (var a in Model)
                {
                    var danger = a.Action is AuditAction.OtpFailed or AuditAction.OtpAttemptsExceeded or AuditAction.AccountLocked or AuditAction.OtpDeliveryFailed or AuditAction.RateLimited;
                    <tr>
                        <td class="small text-muted text-nowrap">@AppTime.ToLocal(a.CreatedAt).ToString("dd.MM.yyyy HH:mm:ss")</td>
                        <td><span class="tag @(danger ? "tag-red" : "tag-gray")">@Ui.AuditActionText(a.Action)</span></td>
                        <td class="small">@(a.User?.FullName ?? a.Email ?? "-")</td>
                        <td class="small">
                            @a.Detail
                            @if (a.TicketId != null) { <a asp-controller="Tickets" asp-action="Details" asp-route-id="@a.TicketId" class="ms-1">talep #@a.TicketId</a> }
                        </td>
                        <td class="small text-muted">@a.IpAddress</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
<partial name="_Pager" model="pager" />
