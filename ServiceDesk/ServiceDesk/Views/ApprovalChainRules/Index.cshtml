@model List<ApprovalChainRule>
@{
    ViewData["Title"] = "Onay zinciri kuralları";
}

<a asp-controller="Approvals" asp-action="Index" class="text-decoration-none small"><i class="bi bi-arrow-left"></i> Onaylar</a>
<div class="d-flex align-items-center gap-2 mt-2 mb-3">
    <h4 class="fw-bold mb-0 me-auto">Onay zinciri kuralları</h4>
    <a asp-action="Edit" class="btn btn-sm btn-primary"><i class="bi bi-plus-lg"></i> Yeni kural</a>
</div>

<div class="alert alert-light border small">
    <i class="bi bi-info-circle"></i>
    Varsayılan: yüksek riskli değişiklik 2, diğerleri 1 onay adımı. Buradaki kurallar kategori ve önceliğe göre adım sayısını artırır.
    Bir talebe birden çok kural uyarsa en çok adım isteyen uygulanır; kural risk varsayılanının altına inemez.
    Son adım her zaman yönetici (veya vekili) onayıdır.
</div>

<div class="panel">
    <table class="table mb-0">
        <thead><tr><th>Kural</th><th>Kategori</th><th>En az öncelik</th><th>Risk</th><th>Adım</th><th>Durum</th><th></th></tr></thead>
        <tbody>
            @if (!Model.Any()) { <tr><td colspan="7" class="text-center text-muted py-4">Kural yok; risk bazlı varsayılan uygulanıyor.</td></tr> }
            @foreach (var r in Model)
            {
                <tr class="@(r.IsActive ? "" : "text-muted")">
                    <td class="fw-semibold">@r.Name</td>
                    <td>@(r.Category?.Name ?? "her kategori")</td>
                    <td>@(r.MinPriority == null ? "-" : Ui.PriorityText(r.MinPriority.Value))</td>
                    <td>@(r.Risk == null ? "-" : Ui.RiskText(r.Risk.Value))</td>
                    <td><span class="tag tag-blue">@r.RequiredSteps adım</span></td>
                    <td>@(r.IsActive ? "Aktif" : "Pasif")</td>
                    <td class="text-end d-flex gap-1 justify-content-end">
                        <a asp-action="Edit" asp-route-id="@r.Id" class="btn btn-sm btn-light border">Düzenle</a>
                        <form asp-action="Toggle" asp-route-id="@r.Id" method="post">
                            <button class="btn btn-sm btn-outline-secondary">@(r.IsActive ? "Pasifleştir" : "Etkinleştir")</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
