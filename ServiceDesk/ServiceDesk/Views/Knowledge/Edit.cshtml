@model KnowledgeArticle
@{
    var yeni = Model.Id == 0;
    ViewData["Title"] = yeni ? "Yeni Makale" : "Makaleyi Düzenle";
    var kategoriler = (List<Category>)ViewBag.Categories;
    // Geri dön / Vazgeç: yeni makalede listeye, düzenlemede makalenin kendisine
    var donus = yeni ? Url.Action("Index") : Url.Action("Details", new { id = Model.Id });
}

<a href="@donus" class="text-decoration-none small"><i class="bi bi-arrow-left"></i> @(yeni ? "Bilgi Bankası" : "Makaleye dön")</a>
<h4 class="fw-bold mt-2 mb-3">@ViewData["Title"]</h4>

<form asp-action="Edit" method="post">
    <input type="hidden" name="id" value="@Model.Id" />
    <div class="row g-3">
        <div class="col-lg-8">
            <div class="panel">
                <div class="panel-body">
                    <div class="mb-3">
                        <div class="d-flex justify-content-between">
                            <label class="form-label fw-semibold" for="title">Başlık</label>
                            <span class="small text-muted" id="baslikSayac"></span>
                        </div>
                        <input name="title" id="title" value="@Model.Title" class="form-control" required maxlength="200"
                               placeholder="Örn: Yazıcı kağıt sıkışması giderme" />
                    </div>

                    <ul class="nav nav-tabs mb-2">
                        <li class="nav-item">
                            <button type="button" class="nav-link active" data-bs-toggle="tab" data-bs-target="#yaz"><i class="bi bi-pencil"></i> Yaz</button>
                        </li>
                        <li class="nav-item">
                            <button type="button" class="nav-link" data-bs-toggle="tab" data-bs-target="#onizle"><i class="bi bi-eye"></i> Önizleme</button>
                        </li>
                    </ul>
                    <div class="tab-content">
                        <div class="tab-pane fade show active" id="yaz">
                            <textarea name="body" id="body" rows="14" class="form-control"
                                      placeholder="1. İlk adım&#10;2. İkinci adım&#10;3. Sorun devam ederse talep açın">@Model.Body</textarea>
                            <div class="form-text">Satır sonları olduğu gibi gösterilir; adımları alt alta yazabilirsiniz.</div>
                        </div>
                        <div class="tab-pane fade" id="onizle">
                            <div class="kb-preview">
                                <h5 class="fw-bold mb-3" id="onizlemeBaslik"></h5>
                                <div id="onizlemeMetin" style="white-space:pre-line"></div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="panel mb-3">
                <div class="panel-head">Yayın</div>
                <div class="panel-body">
                    <label class="form-label small text-muted mb-1" for="categoryId">Kategori</label>
                    <select name="categoryId" id="categoryId" class="form-select mb-3">
                        <option value="">Kategorisiz</option>
                        @foreach (var c in kategoriler)
                        {
                            <option value="@c.Id" selected="@(c.Id == Model.CategoryId)">@c.Name</option>
                        }
                    </select>

                    @* Yayına çıkarma artık bir anahtar değil onay süreci:
                       kaydet → onaya gönder → yönetici onayı (md. 7.5.2) *@
                    <div class="mb-3">
                        <div class="small text-muted mb-1">Durum</div>
                        <span class="tag @Ui.KnowledgeStatusTag(Model.Status)">@Ui.KnowledgeStatusText(Model.Status)</span>
                        <div class="form-text">
                            @switch (Model.Status)
                            {
                                case KnowledgeArticleStatus.Published:
                                    <text>
                                        Makale yayında. İçeriği değiştirip kaydederseniz makale
                                        <strong>yeniden onaya düşer</strong> ve onaylanana kadar son
                                        kullanıcıya görünmez.
                                    </text>
                                    break;
                                case KnowledgeArticleStatus.PendingApproval:
                                    <text>
                                        Makale onay bekliyor. İçeriği değiştirirseniz onay kuyruğundan
                                        çıkar ve taslağa döner; düzeltmeyi bitirince yeniden gönderin.
                                    </text>
                                    break;
                                case KnowledgeArticleStatus.Rejected:
                                    <text>
                                        Makale reddedildi. Düzeltip kaydettiğinizde taslağa döner,
                                        sonra makale sayfasından yeniden onaya gönderebilirsiniz.
                                    </text>
                                    break;
                                default:
                                    <text>
                                        Taslak yalnızca size ve yöneticiye görünür. Yayına çıkması için
                                        kaydettikten sonra makale sayfasından onaya gönderin.
                                    </text>
                                    break;
                            }
                        </div>
                    </div>

                    <div class="d-grid gap-2">
                        <button class="btn btn-primary"><i class="bi bi-save"></i> Kaydet</button>
                        <a href="@donus" class="btn btn-light border">Vazgeç</a>
                    </div>
                </div>
            </div>

            @if (!yeni && Model.Author != null)
            {
                <div class="panel mb-3">
                    <div class="panel-head">Bilgi</div>
                    <table class="table table-sm mb-0 small">
                        <tr><td class="text-muted">Yazar</td><td>@Model.Author.FullName</td></tr>
                        <tr><td class="text-muted">Oluşturma</td><td>@AppTime.ToLocal(Model.CreatedAt).ToString("dd.MM.yyyy")</td></tr>
                        <tr><td class="text-muted">Son güncelleme</td><td>@(AppTime.ToLocal(Model.UpdatedAt)?.ToString("dd.MM.yyyy") ?? "-")</td></tr>
                        <tr><td class="text-muted">Onaylayan</td><td>@(Model.Status == KnowledgeArticleStatus.Published ? Model.ApprovedBy?.FullName ?? "-" : "-")</td></tr>
                        <tr><td class="text-muted">Kullanım</td><td>@Model.UsedCount talep</td></tr>
                    </table>
                </div>
            }

            <div class="panel">
                <div class="panel-head">İpucu</div>
                <div class="panel-body small text-muted">
                    <ul class="mb-0 ps-3">
                        <li>Başlığı kullanıcının arayacağı kelimelerle yazın.</li>
                        <li>Çözümü numaralı adımlarla anlatın.</li>
                        <li>Çözülmezse ne yapılacağını en sona ekleyin.</li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</form>

@section Scripts {
    <script>
        // Başlık karakter sayacı ve canlı önizleme
        const baslik = document.getElementById('title');
        const metin = document.getElementById('body');
        function guncelle() {
            document.getElementById('baslikSayac').textContent = baslik.value.length + ' / 200';
            document.getElementById('onizlemeBaslik').textContent = baslik.value || 'Başlıksız makale';
            document.getElementById('onizlemeMetin').textContent = metin.value || 'Henüz içerik yok.';
        }
        baslik.addEventListener('input', guncelle);
        metin.addEventListener('input', guncelle);
        guncelle();
    </script>
}
