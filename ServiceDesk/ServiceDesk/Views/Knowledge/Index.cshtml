@model List<KnowledgeArticle>
@inject CurrentUser Me
@{
    ViewData["Title"] = "Bilgi Bankası";
    // Destek ve yönetici yönetim düzenini, son kullanıcı portal düzenini görür
    Layout = Me.IsStaff ? "_Layout" : "_PortalLayout";
    var kategoriler = (List<Category>)ViewBag.Categories;
    var seciliKategori = ViewBag.CategoryId as int?;
    var seciliDurum = ViewBag.Status as KnowledgeArticleStatus?;
    var pager = (PagerInfo)ViewBag.Pager;
    var onayBekleyen = (int)(ViewBag.PendingCount ?? 0);
}

<div class="d-flex flex-wrap align-items-end gap-3 mb-4">
    <div class="me-auto">
        <h4 class="fw-bold mb-1">Bilgi Bankası</h4>
        <div class="text-muted">Sık karşılaşılan sorunların çözüm adımları. Talep açmadan önce buraya bakın.</div>
    </div>
    @if (Me.IsStaff)
    {
        @if (onayBekleyen > 0)
        {
            <a asp-action="Index" asp-route-status="@KnowledgeArticleStatus.PendingApproval" class="btn btn-warning">
                <i class="bi bi-hourglass-split"></i> Onay bekleyen (@onayBekleyen)
            </a>
        }
        <a asp-controller="Reports" asp-action="KnowledgeUsage" class="btn btn-light border"><i class="bi bi-journal-check"></i> Kullanım raporu</a>
        <a asp-controller="Chatbot" asp-action="Unanswered" class="btn btn-light border"><i class="bi bi-question-circle"></i> Cevapsız sorular</a>
        <a asp-action="Edit" class="btn btn-primary"><i class="bi bi-plus-lg"></i> Yeni Makale</a>
    }
</div>

<form method="get" class="d-flex flex-wrap gap-2 mb-3">
    <input name="q" value="@ViewBag.Q" class="form-control" style="max-width:320px" placeholder="Makalelerde ara..." />
    <select name="categoryId" class="form-select" style="max-width:220px">
        <option value="">Tüm kategoriler</option>
        @foreach (var c in kategoriler)
        {
            <option value="@c.Id" selected="@(seciliKategori == c.Id)">@c.Name</option>
        }
    </select>
    @if (Me.IsStaff)
    {
        <select name="status" class="form-select" style="max-width:200px">
            <option value="">Tüm durumlar</option>
            @foreach (var d in Enum.GetValues<KnowledgeArticleStatus>())
            {
                <option value="@d" selected="@(seciliDurum == d)">@Ui.KnowledgeStatusText(d)</option>
            }
        </select>
    }
    <button class="btn btn-light border"><i class="bi bi-search"></i> Ara</button>
</form>

@if (!Model.Any())
{
    <div class="panel"><div class="panel-body text-center text-muted py-5">
        <i class="bi bi-journal-text fs-4 d-block mb-2"></i> Bu aramaya uyan makale yok
    </div></div>
}
else
{
    <div class="text-muted small mb-2">@pager.TotalCount makale · sayfa @pager.Page / @pager.TotalPages</div>
}

<div class="row g-3">
    @foreach (var a in Model)
    {
        <div class="col-md-6">
            <a class="panel h-100 text-decoration-none d-block" asp-action="Details" asp-route-id="@a.Id">
                <div class="panel-body">
                    <div class="d-flex align-items-start gap-2 mb-2">
                        <i class="bi bi-journal-text text-primary fs-5"></i>
                        <div class="fw-semibold flex-grow-1">@a.Title</div>
                        @* Yayındaki makalede etiket gürültü olur: son kullanıcı yalnızca onu görür *@
                        @if (a.Status != KnowledgeArticleStatus.Published)
                        {
                            <span class="tag @Ui.KnowledgeStatusTag(a.Status)">@Ui.KnowledgeStatusText(a.Status)</span>
                        }
                    </div>
                    <div class="text-muted small" style="display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden">
                        @a.Body
                    </div>
                    <div class="small text-muted mt-2">
                        @if (a.Category != null) { <span class="tag tag-blue">@a.Category.Name</span> }
                        <span class="ms-1">@a.UsedCount talepte kullanıldı</span>
                        @if (KnowledgeUsagePolicy.TotalVotes(a.HelpfulCount, a.NotHelpfulCount) > 0)
                        {
                            <span class="ms-1" title="Faydalı / faydalı değil">
                                · <i class="bi bi-hand-thumbs-up"></i> @a.HelpfulCount
                                · <i class="bi bi-hand-thumbs-down"></i> @a.NotHelpfulCount
                            </span>
                        }
                    </div>
                </div>
            </a>
        </div>
    }
</div>

@if (Model.Any())
{
    <div class="panel mt-3">
        <partial name="_Pager" model="pager" />
    </div>
}
