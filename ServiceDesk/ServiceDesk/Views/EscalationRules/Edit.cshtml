@model EscalationRule
@{
    ViewData["Title"] = Model.Id == 0 ? "Yeni eskalasyon kuralı" : $"Seviye {Model.Level} düzenle";
    var staffRoles = new[] { UserRole.Agent, UserRole.Admin };
}

<div class="panel" style="max-width:520px">
    <div class="panel-head">@ViewData["Title"]</div>
    <div class="panel-body">
        <form asp-action="Edit" method="post" novalidate>
            <input type="hidden" asp-for="Id" />

            <div class="mb-3">
                <label asp-for="Level" class="form-label"></label>
                <input asp-for="Level" class="form-control" type="number" min="1" />
                <span asp-validation-for="Level" class="text-danger small"></span>
                <div class="form-text">Düşük seviye önce uygulanır; her seviye tek olmalıdır.</div>
            </div>

            <div class="mb-3">
                <label asp-for="AfterMinutes" class="form-label"></label>
                <input asp-for="AfterMinutes" class="form-control" type="number" min="0" />
                <span asp-validation-for="AfterMinutes" class="text-danger small"></span>
                <div class="form-text">SLA bitişinden kaç dakika sonra tetiklenir. 0 = ihlal anında.</div>
            </div>

            <div class="mb-3">
                <label asp-for="TargetRole" class="form-label"></label>
                <select asp-for="TargetRole" class="form-select">
                    @foreach (var role in staffRoles)
                    {
                        <option value="@role">@Ui.RoleText(role)</option>
                    }
                </select>
                <span asp-validation-for="TargetRole" class="text-danger small"></span>
            </div>

            <div class="form-check mb-4">
                <input asp-for="IsActive" class="form-check-input" />
                <label asp-for="IsActive" class="form-check-label">Kural aktif</label>
            </div>

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg"></i> Kaydet</button>
                <a asp-action="Index" class="btn btn-light border">İptal</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
