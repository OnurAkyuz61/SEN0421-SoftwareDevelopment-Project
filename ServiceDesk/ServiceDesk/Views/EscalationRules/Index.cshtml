@model List<EscalationRule>
@{ ViewData["Title"] = "Eskalasyon kuralları"; }

<div class="d-flex flex-wrap align-items-center gap-2 mb-3">
    <div class="me-auto">
        <div class="text-muted small">
            SLA süresi aşıldıktan sonra talep, belirlenen gecikmede hedefe (roldeki en az yüklü kişi ya da ekip lideri)
            yeniden atanır ve seviyeye özel şablonla bildirim gider. Hedefte uygun kişi yoksa yedek kişi / yedek rol devreye girer;
            kural istiyorsa öncelik bir kademe artırılır.
        </div>
    </div>
    <a asp-action="Edit" class="btn btn-primary btn-sm"><i class="bi bi-plus-lg"></i> Yeni kural</a>
</div>

<div class="panel">
    <div class="panel-head">@Model.Count kural</div>
    <div class="table-responsive">
        <table class="table table-hover">
            <thead>
                <tr>
                    <th>Seviye</th>
                    <th>Gecikme</th>
                    <th>Hedef</th>
                    <th>Yedek</th>
                    <th>Öncelik</th>
                    <th>Durum</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr><td colspan="7" class="text-center text-muted py-4">Henüz kural yok</td></tr>
                }
                @foreach (var r in Model)
                {
                    <tr class="@(!r.IsActive ? "opacity-50" : "")">
                        <td class="fw-semibold">Seviye @r.Level</td>
                        <td>
                            @if (r.AfterMinutes == 0) { <span>İhlal anında</span> }
                            else if (r.AfterMinutes < 60) { <span>@r.AfterMinutes dk sonra</span> }
                            else { <span>@(r.AfterMinutes / 60)s @(r.AfterMinutes % 60)dk sonra</span> }
                        </td>
                        <td>
                            @if (r.TargetType == EscalationTarget.TeamLead) { <span class="tag tag-amber">Ekip lideri</span> }
                            else { <span class="tag @(r.TargetRole == UserRole.Admin ? "tag-blue" : "tag-green")">@Ui.RoleText(r.TargetRole)</span> }
                        </td>
                        <td class="small">
                            @(r.FallbackUser?.FullName ?? "")@(r.FallbackUser != null && r.FallbackRole != null ? " → " : "")@(r.FallbackRole == null ? "" : Ui.RoleText(r.FallbackRole.Value))
                            @if (r.FallbackUser == null && r.FallbackRole == null) { <span class="text-muted">-</span> }
                        </td>
                        <td class="small">@(r.RaisePriority ? "+1 kademe" : "-")</td>
                        <td>
                            @if (r.IsActive) { <span class="tag tag-green">Aktif</span> }
                            else { <span class="tag tag-gray">Pasif</span> }
                        </td>
                        <td class="text-end text-nowrap">
                            <a asp-action="Edit" asp-route-id="@r.Id" class="btn btn-sm btn-outline-secondary"><i class="bi bi-pencil"></i></a>
                            <form asp-action="Toggle" asp-route-id="@r.Id" method="post" class="d-inline">
                                <button class="btn btn-sm btn-outline-secondary" title="@(r.IsActive ? "Pasifleştir" : "Etkinleştir")">
                                    <i class="bi bi-@(r.IsActive ? "pause" : "play")"></i>
                                </button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
