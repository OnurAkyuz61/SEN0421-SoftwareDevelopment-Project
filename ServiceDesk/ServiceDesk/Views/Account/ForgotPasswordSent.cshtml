@model ForgotPasswordSentVm
@inject IWebHostEnvironment Env
@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Bağlantı gönderildi";
    ViewData["AuthStep"] = 1;
}

<div class="auth-head">
    <div class="icon"><i class="bi bi-envelope-check"></i></div>
    <h1>E-postanızı kontrol edin</h1>
    <p>
        <strong>@Model.Email</strong> adresi sistemde kayıtlıysa şifre sıfırlama bağlantısı gönderildi.
        Gelen kutusu ve spam klasörünü kontrol edin.
    </p>
</div>

@if (Env.IsDevelopment() && Model.DemoResetLink is { } link)
{
    <div class="demo-code">
        <span><i class="bi bi-cone-striped me-1"></i> Demo bağlantı <span class="opacity-75">(SMTP bağlanınca kalkacak)</span></span>
        <a href="@link" class="demo-reset-link">Şifreyi sıfırla →</a>
    </div>
}
else if (Env.IsDevelopment())
{
    <div class="auth-alert info" role="status">
        <i class="bi bi-info-circle-fill"></i>
        <span>Geliştirme: bu e-posta için aktif hesap yok; yine de aynı yanıt verildi.</span>
    </div>
}

<div class="auth-row">
    <a asp-action="Login" class="auth-link"><i class="bi bi-arrow-left"></i> Girişe dön</a>
</div>
