@model ForgotPasswordVm
@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Şifre sıfırlama";
    ViewData["AuthStep"] = 1;
    bool HasError(string key) => ViewData.ModelState[key]?.Errors.Count > 0;
}

<div class="auth-head">
    <div class="icon"><i class="bi bi-key"></i></div>
    <h1>Şifrenizi mi unuttunuz?</h1>
    <p>Kurumsal e-posta adresinizi yazın; size tek kullanımlık bir sıfırlama bağlantısı gönderelim.</p>
</div>

<form asp-action="ForgotPassword" method="post" novalidate data-auth-form>
    <div class="auth-field">
        <label asp-for="Email">E-posta</label>
        <div class="auth-input @(HasError(nameof(Model.Email)) ? "invalid" : "")">
            <i class="bi bi-envelope"></i>
            <input asp-for="Email" type="email" autocomplete="username" inputmode="email" autocapitalize="off" spellcheck="false"
                   placeholder="ad.soyad@servicedesk.local" autofocus />
        </div>
        <span asp-validation-for="Email" class="field-error"></span>
    </div>

    <button type="submit" class="auth-btn">
        <span class="spinner" aria-hidden="true"></span>
        <span class="btn-label">Bağlantı gönder</span>
        <i class="bi bi-send"></i>
    </button>
</form>

<div class="auth-row">
    <a asp-action="Login" class="auth-link"><i class="bi bi-arrow-left"></i> Girişe dön</a>
</div>
