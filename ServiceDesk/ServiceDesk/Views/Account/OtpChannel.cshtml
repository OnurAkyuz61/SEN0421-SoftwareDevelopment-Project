@model OtpChannelVm
@inject IWebHostEnvironment Env
@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Doğrulama yöntemi";
    ViewData["AuthStep"] = 2;
}

<div class="auth-head">
    <div class="icon"><i class="bi bi-shield-lock"></i></div>
    <h1>Kimliğinizi doğrulayalım</h1>
    <p>Girişi tamamlamak için kayıtlı telefonunuza 6 haneli tek kullanımlık bir kod göndereceğiz.</p>
</div>

<div class="phone-chip"><i class="bi bi-phone"></i> @Model.MaskedPhone</div>

<form asp-action="OtpChannel" method="post" data-auth-form>
    <div class="channel-list" role="radiogroup" aria-label="Kodun gönderileceği kanal">
        <label class="channel sms">
            <input type="radio" name="Channel" value="Sms" @(Model.Channel == OtpDeliveryChannel.Sms ? "checked" : null) />
            <span class="ch-icon"><i class="bi bi-chat-dots-fill"></i></span>
            <span>
                <strong>SMS</strong>
                <small>Kod kısa mesaj olarak gelir</small>
            </span>
            <span class="tick"><i class="bi bi-check-lg"></i></span>
        </label>

        <label class="channel wa">
            <input type="radio" name="Channel" value="WhatsApp" @(Model.Channel == OtpDeliveryChannel.WhatsApp ? "checked" : null) />
            <span class="ch-icon"><i class="bi bi-whatsapp"></i></span>
            <span>
                <strong>WhatsApp</strong>
                <small>Kod WhatsApp mesajı olarak gelir</small>
            </span>
            <span class="tick"><i class="bi bi-check-lg"></i></span>
        </label>
    </div>

    <span asp-validation-for="Channel" class="field-error mb-3"></span>

    <button type="submit" class="auth-btn">
        <span class="spinner" aria-hidden="true"></span>
        <span class="btn-label">Kodu gönder</span>
        <i class="bi bi-send"></i>
    </button>

    @* ───── GELİŞTİRME KOLAYLIĞI ─────────────────────────────────────────
       Kanal seçimini atlayıp doğrudan SMS ile ilerler.
       Canlıya çıkmadan önce bu blok silinecek. *@
    @if (Env.IsDevelopment())
    {
        <button type="submit" name="Channel" value="Sms" class="dev-btn wide">
            <i class="bi bi-wrench-adjustable"></i> Geliştirme · SMS ile hızlı devam
        </button>
    }
</form>

<div class="auth-row">
    <a class="auth-link" asp-action="Login"><i class="bi bi-arrow-left"></i> Farklı hesapla giriş yap</a>
</div>
