@model ResetPasswordVm
@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Yeni şifre";
    ViewData["AuthStep"] = 1;
    bool HasError(string key) => ViewData.ModelState[key]?.Errors.Count > 0;
}

<div class="auth-head">
    <div class="icon"><i class="bi bi-shield-lock"></i></div>
    <h1>Yeni şifre belirleyin</h1>
    <p>@PasswordRules.Hint Eski şifreniz artık geçerli olmayacak.</p>
</div>

<form asp-action="ResetPassword" method="post" novalidate data-auth-form>
    <input type="hidden" asp-for="Token" />

    <div class="auth-field">
        <label asp-for="Password">Yeni şifre</label>
        <div class="auth-input @(HasError(nameof(Model.Password)) ? "invalid" : "")">
            <i class="bi bi-lock"></i>
            <input asp-for="Password" autocomplete="new-password" placeholder="Örn: Guclu#Sifre1" data-caps-target="#capsHint" autofocus />
            <button type="button" class="reveal" data-reveal="#Password" aria-label="Şifreyi göster" title="Şifreyi göster">
                <i class="bi bi-eye"></i>
            </button>
        </div>
        <span asp-validation-for="Password" class="field-error"></span>
        <div class="caps-hint" id="capsHint" role="status"><i class="bi bi-capslock-fill"></i> Caps Lock açık</div>
    </div>

    <div class="auth-field">
        <label asp-for="ConfirmPassword">Şifre tekrar</label>
        <div class="auth-input @(HasError(nameof(Model.ConfirmPassword)) ? "invalid" : "")">
            <i class="bi bi-lock-fill"></i>
            <input asp-for="ConfirmPassword" autocomplete="new-password" placeholder="Aynı şifreyi tekrar yazın" />
            <button type="button" class="reveal" data-reveal="#ConfirmPassword" aria-label="Şifreyi göster" title="Şifreyi göster">
                <i class="bi bi-eye"></i>
            </button>
        </div>
        <span asp-validation-for="ConfirmPassword" class="field-error"></span>
    </div>

    <button type="submit" class="auth-btn">
        <span class="spinner" aria-hidden="true"></span>
        <span class="btn-label">Şifreyi kaydet</span>
        <i class="bi bi-check-lg"></i>
    </button>
</form>

<div class="auth-row">
    <a asp-action="Login" class="auth-link"><i class="bi bi-arrow-left"></i> Girişe dön</a>
</div>
