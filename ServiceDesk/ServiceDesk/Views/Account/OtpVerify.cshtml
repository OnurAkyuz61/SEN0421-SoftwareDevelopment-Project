@model OtpVerifyVm
@inject Microsoft.Extensions.Options.IOptions<AuthSettings> AuthOpt
@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Kod doğrulama";
    ViewData["AuthStep"] = 3;

    var channelLabel = Model.Channel == OtpDeliveryChannel.WhatsApp ? "WhatsApp" : "SMS";
    var channelIcon = Model.Channel == OtpDeliveryChannel.WhatsApp ? "bi-whatsapp" : "bi-chat-dots";
    // Demo kod yalnızca Development + yerel istekte gelir (AccountController.SendCode)
    var showDemo = ServiceDesk.Filters.DevelopmentOnlyAttribute.IsAllowed(Context);
    var demoCode = showDemo ? TempData["OtpDemoCode"] as string : null;
    if (!showDemo) TempData.Remove("OtpDemoCode"); // yanlışlıkla sızmışsa tüketilmesin
    var codeErrors = ViewData.ModelState[nameof(Model.Code)]?.Errors.Select(e => e.ErrorMessage).ToList() ?? new();
    var lifetime = AuthOpt.Value.OtpLifetimeSeconds;
}

<div class="auth-head">
    <div class="icon"><i class="bi @channelIcon"></i></div>
    <h1>Doğrulama kodunu girin</h1>
    <p>@channelLabel ile <strong>@Model.MaskedPhone</strong> numarasına gönderilen 6 haneli kodu yazın.</p>
</div>

@if (TempData["OtpSentInfo"] is string info)
{
    <div class="auth-alert info" role="status"><i class="bi bi-info-circle-fill"></i><span>@info</span></div>
}

@* Yalnızca Development + yerel istek: SMS/WhatsApp API yokken kodu ekranda göster *@
@if (demoCode != null)
{
    <div class="demo-code">
        <span><i class="bi bi-cone-striped me-1"></i> Geliştirme · demo kod <span class="opacity-75">(Production’da görünmez)</span></span>
        <b>@demoCode</b>
    </div>
}

<form asp-action="OtpVerify" method="post" id="otpForm" novalidate data-auth-form>
    @* JavaScript kapalıysa bu tek kutu görünür; açıksa gizlenir ve 6 kutudan doldurulur *@
    <div class="otp-single">
        <input asp-for="Code" inputmode="numeric" autocomplete="one-time-code" maxlength="6" placeholder="••••••" aria-label="6 haneli doğrulama kodu" />
    </div>

    <div class="otp-boxes @(codeErrors.Any() ? "invalid shake" : "")" id="otpBoxes" role="group" aria-label="6 haneli doğrulama kodu">
        @for (var i = 0; i < 6; i++)
        {
            if (i == 3) { <span class="sep" aria-hidden="true"></span> }
            <input type="text" inputmode="numeric" pattern="[0-9]*" maxlength="1"
                   autocomplete="@(i == 0 ? "one-time-code" : "off")"
                   aria-label="@(i + 1). hane" class="otp-digit" />
        }
    </div>

    @if (codeErrors.Any())
    {
        <div class="auth-alert error" role="alert"><i class="bi bi-exclamation-circle-fill"></i><span>@codeErrors.First()</span></div>
    }

    <button type="submit" class="auth-btn" @(Model.SecondsLeft <= 0 ? "disabled" : null)>
        <span class="spinner" aria-hidden="true"></span>
        <span class="btn-label">Doğrula ve giriş yap</span>
        <i class="bi bi-arrow-right"></i>
    </button>
</form>

<div class="otp-status">
    <span class="otp-timer @(Model.SecondsLeft <= 0 ? "over" : "")" id="otpTimer"
          data-seconds-left="@Model.SecondsLeft" data-lifetime="@lifetime">
        <svg class="ring" viewBox="0 0 20 20" aria-hidden="true">
            <circle class="bg" cx="10" cy="10" r="8" />
            <circle class="fg" cx="10" cy="10" r="8" stroke-dasharray="50.27" stroke-dashoffset="0" />
        </svg>
        <span data-timer-text>
            @if (Model.SecondsLeft > 0)
            {
                <text>Kalan süre <b>@($"{Model.SecondsLeft / 60}:{Model.SecondsLeft % 60:00}")</b></text>
            }
            else
            {
                <text>Kodun süresi doldu</text>
            }
        </span>
    </span>

    @if (Model.SendsLeft > 0)
    {
        <form asp-action="ResendOtp" method="post" class="m-0">
            <button type="submit" class="resend-btn" id="resendBtn" data-cooldown="@Model.ResendInSeconds"
                    @(Model.ResendInSeconds > 0 ? "disabled" : null)>
                @(Model.ResendInSeconds > 0 ? $"Tekrar gönder ({Model.ResendInSeconds} sn)" : "Kodu tekrar gönder")
            </button>
        </form>
    }
    else
    {
        <span class="small">Kod gönderme hakkı doldu</span>
    }
</div>

<div class="auth-row">
    <a class="auth-link" asp-action="OtpChannel"><i class="bi bi-arrow-left"></i> Yöntemi değiştir</a>
</div>

@section Scripts {
    @* ───── GELİŞTİRME KOLAYLIĞI ─────────────────────────────────────────
       Demo kodu kutulara otomatik yazar; auth.js 6 hane dolunca formu kendisi
       gönderdiği için giriş tamamlanır. DevLogin ile aynı kural: yalnızca
       Development + bu bilgisayar. *@
    @if (demoCode != null && !codeErrors.Any())
    {
        <script>
            window.addEventListener('load', function () {
                setTimeout(function () {
                    window.SdOtp && window.SdOtp.fill(@Html.Raw(System.Text.Json.JsonSerializer.Serialize(demoCode)));
                }, 600);
            });
        </script>
    }
}
