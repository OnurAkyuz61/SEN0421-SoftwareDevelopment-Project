@model LoginVm
@inject IWebHostEnvironment Env
@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Giriş";
    ViewData["AuthStep"] = 1;

    var reason = ViewData["Reason"] as string;
    var formErrors = ViewData.ModelState[string.Empty]?.Errors.Select(e => e.ErrorMessage).ToList() ?? new();
    bool HasError(string key) => ViewData.ModelState[key]?.Errors.Count > 0;
}

<div class="auth-head">
    <h1>Tekrar hoş geldiniz</h1>
    <p>Servis masasına erişmek için kurumsal hesabınızla giriş yapın.</p>
</div>

@if (reason == "timeout" || reason == "expired")
{
    <div class="auth-alert warn" role="status">
        <i class="bi bi-hourglass-bottom"></i>
        <span>Güvenliğiniz için oturumunuz zaman aşımına uğradı. Lütfen tekrar giriş yapın.</span>
    </div>
}
else if (reason == "logout")
{
    <div class="auth-alert success" role="status">
        <i class="bi bi-check-circle-fill"></i>
        <span>Güvenli bir şekilde çıkış yaptınız.</span>
    </div>
}

@if (formErrors.Any())
{
    <div class="auth-alert error" role="alert">
        <i class="bi bi-exclamation-circle-fill"></i>
        <ul>@foreach (var e in formErrors) { <li>@e</li> }</ul>
    </div>
}

<form asp-action="Login" method="post" novalidate data-auth-form>
    <input type="hidden" asp-for="ReturnUrl" />

    <div class="auth-field">
        <label asp-for="Email">E-posta</label>
        <div class="auth-input @(HasError(nameof(Model.Email)) ? "invalid" : "")">
            <i class="bi bi-envelope"></i>
            <input asp-for="Email" type="email" autocomplete="username" inputmode="email" autocapitalize="off" spellcheck="false"
                   placeholder="ad.soyad@servicedesk.local" autofocus />
        </div>
        <span asp-validation-for="Email" class="field-error"></span>
    </div>

    <div class="auth-field">
        <label asp-for="Password">Şifre</label>
        <div class="auth-input @(HasError(nameof(Model.Password)) ? "invalid" : "")">
            <i class="bi bi-lock"></i>
            <input asp-for="Password" autocomplete="current-password" placeholder="Şifrenizi girin" data-caps-target="#capsHint" />
            <button type="button" class="reveal" data-reveal="#Password" aria-label="Şifreyi göster" title="Şifreyi göster">
                <i class="bi bi-eye"></i>
            </button>
        </div>
        <span asp-validation-for="Password" class="field-error"></span>
        <div class="caps-hint" id="capsHint" role="status"><i class="bi bi-capslock-fill"></i> Caps Lock açık</div>
    </div>

    <button type="submit" class="auth-btn">
        <span class="spinner" aria-hidden="true"></span>
        <span class="btn-label">Devam et</span>
        <i class="bi bi-arrow-right"></i>
    </button>
</form>

<p class="text-center text-muted small mt-3 mb-0">
    Şifreden sonra telefonunuza tek kullanımlık bir doğrulama kodu gönderilir.
</p>

@* ───── GELİŞTİRME KOLAYLIĞI ─────────────────────────────────────────────
   Test hesabına şifre ve OTP olmadan girer. Giriş formundan ayrı bir form
   olduğu için tarayıcı parola gönderimi algılamaz; "bu şifre bir veri
   sızıntısında bulundu" uyarısı çıkmaz. Yalnızca Development'ta görünür,
   sunucu tarafında da ayrıca kilitli. Canlıya çıkmadan önce bu blok,
   auth.css'teki .dev-* stilleri ve AccountController.DevLogin silinecek. *@
@if (Env.IsDevelopment())
{
    <form asp-action="DevLogin" method="post" class="dev-box">
        <input type="hidden" name="returnUrl" value="@Model.ReturnUrl" />
        <div class="dev-label"><i class="bi bi-wrench-adjustable"></i> Geliştirme · şifresiz hızlı giriş</div>
        <div class="dev-row">
            <button type="submit" class="dev-btn" name="email" value="admin@servicedesk.local">Yönetici</button>
            <button type="submit" class="dev-btn" name="email" value="agent@servicedesk.local">Destek</button>
            <button type="submit" class="dev-btn" name="email" value="user@servicedesk.local">Kullanıcı</button>
        </div>
    </form>
}
