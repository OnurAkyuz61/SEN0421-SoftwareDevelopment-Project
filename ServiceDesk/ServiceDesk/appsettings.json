{
  "ConnectionStrings": {
    "DefaultConnection": "Server=(localdb)\\MSSQLLocalDB;Database=ServiceDeskDb;Trusted_Connection=True;TrustServerCertificate=True"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Auth": {
    "IdleTimeoutMinutes": 30,
    "AbsoluteTimeoutHours": 8,
    "WarningBeforeSeconds": 120,
    "PendingLoginMinutes": 10,
    "OtpLifetimeSeconds": 300,
    "OtpResendCooldownSeconds": 30,
    "OtpMaxSends": 4,
    "OtpMaxAttempts": 5,
    "PasswordResetHours": 1,
    "MaxConcurrentSessions": 1,
    "PasswordHistoryCount": 5
  },
  "Messaging": {
    "Sms": {
      "Enabled": true,
      "Provider": "Logging",
      "SenderId": "SERVICEDSK",
      "ApiUrl": "",
      "ApiKey": "",
      "ApiSecret": "",
      "OtpTemplate": "ServiceDesk giriş kodunuz: {code}. Kod {minutes} dakika geçerlidir. Kimseyle paylaşmayın.",
      "TimeoutSeconds": 10
    },
    "WhatsApp": {
      "Enabled": true,
      "Provider": "Logging",
      "PhoneNumberId": "",
      "ApiUrl": "",
      "AccessToken": "",
      "OtpTemplateName": "servicedesk_otp",
      "LanguageCode": "tr",
      "TimeoutSeconds": 10
    },
    "Email": {
      "Mode": "Logging",
      "FromAddress": "servicedesk@kurum.local",
      "FromName": "ServiceDesk",
      "PublicBaseUrl": "https://localhost:7294",
      "Smtp": {
        "Host": "smtp.kurum.local",
        "Port": 587,
        "EnableSsl": true,
        "UserName": "",
        "Password": "",
        "TimeoutSeconds": 30
      }
    },
    "Queue": {
      "PollSeconds": 15,
      "BatchSize": 50,
      "MaxAttempts": 5,
      "RetryBaseSeconds": 60,
      "RetryMaxSeconds": 3600
    }
  },
  "Quality": {
    "LowSatisfactionThreshold": 2.5,
    "CriticalQuestionScore": 1,
    "CorrectiveActionDueDays": 7,
    "ReminderEnabled": true,
    "ReminderBeforeHours": 48,
    "ReminderCheckMinutes": 60,
    "ReminderBatchSize": 200
  },
  "Survey": {
    "ReminderEnabled": true,
    "ReminderAfterHours": 24,
    "ExpiresAfterDays": 14,
    "CheckMinutes": 30,
    "BatchSize": 200
  },
  "Notifications": {
    "DigestEnabled": true,
    "DigestHourLocal": 8,
    "UnreadPollSeconds": 60
  },
  "Approvals": {
    "RequirePlannedWindow": false,
    "BlockOutsidePlannedWindow": true,
    "RequireCabForHighRisk": true,
    "ReminderAfterHours": 24,
    "ReminderIntervalHours": 24,
    "ReminderCheckMinutes": 30,
    "MaxResubmissions": 3,
    "MaxDelegationDays": 60
  },
  "Uploads": {
    "MaxFiles": 5,
    "TicketMaxBytes": 10485760,
    "CommentMaxBytes": 5242880,
    "NonconformityMaxBytes": 10485760,
    "TicketQuotaBytes": 52428800,
    "UserQuotaBytes": 524288000,
    "NonconformityQuotaBytes": 52428800,
    "Scanner": {
      "Enabled": true,
      "Provider": "Logging",
      "ApiUrl": "",
      "ApiKey": "",
      "TimeoutSeconds": 30
    },
    "Retention": {
      "Enabled": true,
      "Days": 90,
      "SweepMinutes": 1440,
      "BatchSize": 200
    },
    "OrphanScan": {
      "Enabled": true,
      "ScanMinutes": 1440,
      "MinAgeMinutes": 60,
      "DeleteFiles": false,
      "MaxReported": 20
    }
  },
  "RateLimiting": {
    "Enabled": true,
    "OtpPermitLimit": 10,
    "OtpWindowSeconds": 300,
    "SearchPermitLimit": 60,
    "SearchWindowSeconds": 60,
    "SearchSegments": 6
  },
  "AllowedHosts": "*"
}
